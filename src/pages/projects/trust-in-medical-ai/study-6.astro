---
import Base from '../../../layouts/Base.astro';
import MainFindings from '../../../components/MainFindings.astro';
import StatTable from '../../../components/StatTable.astro';
import bayes from '../../../data/trust-in-medical-ai/bayes.json';
import { times } from '../../../utils/bayes';
import { href } from '../../../utils/url';

const bf = (id: string) => bayes.rows.find((r) => r.id === id)!;

// Coefficients and 95% intervals as printed in Tables 23 and 24 of the dissertation.
const est = [
  { grp: 'Sleep (Table 23)', rows: [
    { label: 'Change after the advice', note: 'Model 1', b: 0.27, lo: 0.214, hi: 0.324, key: true },
    { label: 'AI versus doctor, overall', note: 'Model 2', b: 0.03, lo: -0.053, hi: 0.108 },
    { label: 'AI versus doctor, change after the advice', note: 'Model 2', b: -0.03, lo: -0.144, hi: 0.079 },
  ] },
  { grp: 'Phone in bed (Table 24)', rows: [
    { label: 'Change after the advice', note: 'Model 1', b: 0.32, lo: 0.264, hi: 0.365, key: true },
    { label: 'AI versus doctor, overall', note: 'Model 2', b: 0.03, lo: -0.065, hi: 0.132 },
    { label: 'AI versus doctor, change after the advice', note: 'Model 2', b: 0.07, lo: -0.03, hi: 0.175 },
  ] },
];
const AX0 = -0.2;
const AX1 = 0.4;
const pos = (v: number) => (((v - AX0) * 100) * (1 / (AX1 - AX0))).toFixed(2);
const fm = (v: number) => (v < 0 ? '−' : '') + Math.abs(v).toFixed(3).replace(/^0/, '').replace(/0$/, '');
const ticks = [-0.2, 0, 0.2, 0.4];

const findings = [
  {
    head: 'People moved toward the advice after hearing it, whoever gave it',
    body: [
      'In the last study, 560 people were recruited for 15 days of daily sleep logging, and 455 completed it. On day eight a doctor or an AI told them to sleep 7.5 to 9 hours and to spend 15 minutes or less on a device in bed. They got a reminder after each daily survey.',
      'Sleep moved toward the recommendation by about a quarter of the way (.27, 95% interval .214 to .324), and time on a device in bed by about a third (.32, interval .264 to .365).',
    ],
    visual: { type: 'stat', value: '.27 and .32', label: 'share of the way toward the advice that people moved, for sleep and for device time in bed', caption: 'Weight on advice: 0 is no change, 1 is meeting the recommendation. Tables 23 and 24, Model 1.' },
  },
  {
    head: 'The doctor and the AI did not differ in how well the advice worked',
    body: [
      `The change after the advice was about the same for the two recommenders. For sleep the AI-versus-doctor difference was −.03 (interval −.144 to .079), and for device time .07 (interval −.030 to .175). The data are ${times(bf('S6-sleep-int').bf01)} under no difference for sleep and ${times(bf('S6-dib-int').bf01)} for device time, moderate evidence both times.`,
      'This is a lack of evidence for a difference, not proof of none. With about 220 people per condition, the study could detect effects of about d = .265 or larger, as large as the trust gaps in the earlier studies.',
    ],
    visual: { type: 'stat', value: 'No gap', label: 'in how closely people followed a doctor’s or an AI’s advice', caption: 'Study 6, 15 days, 455 people.' },
  },
  {
    head: 'People still saw more mind in the doctor than in the AI',
    body: [
      'After the study, people rated the doctor and the AI on seven items such as whether the recommender understood their feelings or could anticipate their needs. The doctor was rated about one point higher on the 0 to 10 average (b = −1.02, z = −4.33, p < .001).',
      'So the perception gap from Studies 1 to 5 showed up again, even though it did not change what people did.',
    ],
    visual: { type: 'stat', value: '1.0 point', label: 'more perceived mind for the doctor than for the AI, on a 0 to 10 scale', caption: 'Mind perception, Study 6.' },
  },
  {
    head: 'Perceived mind did not carry the effect',
    body: [
      `The path through mind perception was close to zero for both outcomes (sleep: −.012, p = .346; device time: .006, p = .736). The data are ${times(bf('S6-sleep-med').bf01)} under no mediation for sleep and ${times(bf('S6-dib-med').bf01)} for device time, strong evidence.`,
      'Because the recommenders did not change behavior, there was nothing for mind perception to explain.',
    ],
    visual: { type: 'stat', value: 'About 0', label: 'indirect effect of the recommender through mind perception', caption: 'Multilevel mediation, Figures 31 and 33 of the dissertation.' },
  },
];

const col = [
  { key: 'term', label: 'Term' },
  { key: 'm1', label: 'Model 1', num: true },
  { key: 'm2', label: 'Model 2', num: true },
  { key: 'm3', label: 'Model 3', num: true },
];
const t23 = [
  { term: 'Intercept', m1: '.02 [−.022, .055]', m2: '.11 [−.005, .221]', m3: '.078 [−.064, .219]' },
  { term: 'Change after the advice', m1: '.27*** [.214, .324]', m2: '.28*** [.207, .363]', m3: '−.28*** [.200, .359]' },
  { term: 'Condition (0 = doctor, 1 = AI)', m1: '', m2: '.03 [−.053, .108]', m3: '.05 [−.040, .131]' },
  { term: 'Advice × condition', m1: '', m2: '−.03 [−.144, .079]', m3: '−.03 [−.143, .086]' },
  { term: 'Age', m1: '', m2: '−.00 [−.004, .000]', m3: '−.00* [−.005, −.000]' },
  { term: 'Gender (0 = female, 1 = male)', m1: '', m2: '−.02 [−.144, .079]', m3: '−.04 [−.101, .024]' },
  { term: 'Mind perception', m1: '', m2: '', m3: '.00 [−.143, .086]' },
  { term: 'People', m1: '510', m2: '455', m3: '412' },
  { term: 'Observations', m1: '5,803', m2: '5,604', m3: '5,262' },
  { term: 'Marginal / conditional R²', m1: '.016 / .023', m2: '.016 / .026', m3: '.017 / .030' },
];
const t24 = [
  { term: 'Intercept', m1: '.02 [−.023, .071]', m2: '.11 [−.005, .221]', m3: '.02 [−.178, .218]' },
  { term: 'Change after the advice', m1: '.32*** [.264, .365]', m2: '.28*** [.207, .363]', m3: '−.29*** [.214, .360]' },
  { term: 'Condition (0 = doctor, 1 = AI)', m1: '', m2: '.03 [−.065, .132]', m3: '.04 [−.069, .142]' },
  { term: 'Advice × condition', m1: '', m2: '.07 [−.030, .175]', m3: '−.09 [−.014, .195]' },
  { term: 'Age', m1: '', m2: '.00 [−.003, .004]', m3: '.00 [−.003, .004]' },
  { term: 'Gender (0 = female, 1 = male)', m1: '', m2: '−.02 [−.106, .065]', m3: '−.04 [−.127, .053]' },
  { term: 'Mind perception', m1: '', m2: '', m3: '−.00 [−.021, .053]' },
  { term: 'People', m1: '510', m2: '455', m3: '412' },
  { term: 'Observations', m1: '5,781', m2: '5,582', m3: '5,246' },
  { term: 'Marginal / conditional R²', m1: '.023 / .138', m2: '.024 / .147', m3: '.027 / .152' },
];
const med = [
  { out: 'Sleep (Figure 31)', a: '−1.019***', b: '−.012', c: '.026', cp: '.015', ind: '−.012', test: 'z(412) = −.943, p = .346' },
  { out: 'Device in bed (Figure 33)', a: '−1.019***', b: '−.006', c: '.127', cp: '.121', ind: '.006', test: 'z(412) = .333, p = .736' },
];
const medCols = [
  { key: 'out', label: 'Outcome' },
  { key: 'a', label: 'a: recommender to mind', num: true },
  { key: 'b', label: 'b: mind to adherence', num: true },
  { key: 'c', label: 'c: total', num: true },
  { key: 'cp', label: 'c′: direct', num: true },
  { key: 'ind', label: 'Indirect effect', num: true },
  { key: 'test', label: 'Test of the indirect effect', wrap: true, minw: '12rem' },
];
---

<Base
  title="Trust in medical AI: Study 6"
  description="Study 6 of my dissertation: 455 people followed sleep and phone-in-bed advice for two weeks from either a doctor or an AI, and the recommender made no difference to what they did."
>
  <div class="wrap">
    <header class="page-head">
      <p class="back small"><a href={href('/projects/trust-in-medical-ai/')}>Trust in medical AI</a></p>
      <h1>Study 6</h1>
      <p class="lede">
        The first five studies asked what people say about a doctor and an AI. Study 6 asked what they do. 455 people logged their sleep and phone use for 15 days, and on day eight a doctor or an AI gave them
        advice. The numbers on this page are the ones printed in my dissertation, because the raw data for this study are not on this site.
      </p>
    </header>

    <aside class="note" aria-labelledby="ch4">
      <h2 id="ch4">Chapter 4: Does the gap change what people do?</h2>
      <p>
        Chapter 2 and Chapter 3 found that people trust a doctor more than an AI and that a humanlike AI narrows the gap. Chapter 4 tests whether any of that reaches behavior, in the one study where behavior was measured.
        I preregistered it on <a href="https://doi.org/10.17605/OSF.IO/736HEF">OSF</a>.
      </p>
    </aside>

    <section class="section" id="main-findings" aria-labelledby="mf-title">
      <h2 id="mf-title">Main findings</h2>
      <MainFindings findings={findings} />
    </section>

    <section class="section" id="what-i-did" aria-labelledby="did-title">
      <h2 id="did-title">What I did</h2>
      <div class="prose">
        <p>
          I recruited 560 people from Prolific. After a week of daily surveys about sleep, phone use, restfulness and mood, 455 completed the study (47% women, average age 40, range 19 to 85). I kept people who got the advice and finished at least three
          of the surveys that followed. Each person was randomly given a doctor or an AI as the source.
        </p>
        <p>
          On day eight, each person read and heard a health infographic and a recommendation to sleep 7.5 to 9 hours and to spend 15 minutes or less on a device in bed. After each daily survey they were reminded of the commitment.
          The advice was identical for both recommenders. At the end I asked how much mind they gave the recommender, using the same seven items as in the earlier studies (Cronbach's α = .887).
        </p>
        <p>
          <strong>Weight on advice.</strong> People start at different places, so I measured how far each day's sleep moved from that person's average in the first seven days toward the recommended value, as a share of the full distance.
          Zero means no change and 1 means meeting the recommendation. Moving in either direction counts as progress if it ends nearer the recommended value, and I capped values at −2 and 2. I did the same for device time with 15 minutes as the target.
          This is the Judge-Advisor approach from decision research.
        </p>
        <p>
          I fit linear mixed-effects models with a random intercept for each person: first the change after the advice, then the recommender and its interaction with the advice, then age, gender and mind perception.
          I tested mind perception as a mediator with a multilevel mediation analysis.
        </p>
      </div>
    </section>

    <section class="section" id="estimates" aria-labelledby="est-title">
      <h2 id="est-title">Everything that mattered was the advice, not who gave it</h2>
      <p class="sub">Each dot is a coefficient from Tables 23 and 24, and each line is its 95% interval. Zero means no difference. Only the first row of each group clears zero.</p>
      <figure class="forest" aria-label="Coefficients with 95% intervals for sleep and device-in-bed adherence">
        {est.map((g) => (
          <div class="grp">
            <h3>{g.grp}</h3>
            {g.rows.map((r) => (
              <div class={`row ${r.key ? 'key' : ''}`}>
                <div class="lab">{r.label} <span>{r.note}</span></div>
                <div class="track" role="img" aria-label={`${r.label}: ${fm(r.b)}, interval ${fm(r.lo)} to ${fm(r.hi)}`}>
                  <span class="zero" style={`left:${pos(0)}%`}></span>
                  <span class="ci" style={`left:${pos(r.lo)}%;width:${(Number(pos(r.hi)) - Number(pos(r.lo))).toFixed(2)}%`}></span>
                  <span class="pt" style={`left:${pos(r.b)}%`}></span>
                </div>
                <div class="val">{fm(r.b)} [{fm(r.lo)}, {fm(r.hi)}]</div>
              </div>
            ))}
          </div>
        ))}
        <div class="axis">{ticks.map((t) => <span style={`left:${pos(t)}%`}>{t === 0 ? '0' : fm(t)}</span>)}</div>
        <figcaption class="small muted">Weight on advice. Left of zero is movement away from the recommendation, right of zero is movement toward it. Intervals as printed in the dissertation.</figcaption>
      </figure>
    </section>

    <section class="section" id="tables" aria-labelledby="tables-title">
      <h2 id="tables-title">The tables</h2>
      <StatTable
        id="table-23"
        title="Table 1. Change in sleep after the advice, by recommender (dissertation Table 23)"
        columns={col}
        rows={t23}
        look="The intervention row is the only one that excludes zero. The condition and interaction rows are about zero."
        note="Coefficients with 95% intervals as printed. * p < .05, *** p < .001. Doctor is the reference condition. Variance of people about .01 and ICC .01 in every model."
      />
      <StatTable
        id="table-24"
        title="Table 2. Change in device time in bed after the advice, by recommender (dissertation Table 24)"
        columns={col}
        rows={t24}
        look="Same pattern as sleep. The advice moved device time, and the recommender did not."
        note="As printed. The table note in the dissertation names the humanlike AI as the reference, which looks like a carry-over from Chapter 3. The condition is coded 0 = doctor, 1 = AI."
      />
      <StatTable
        id="table-med"
        title="Table 3. Mediation through mind perception (dissertation Figures 31 and 33)"
        columns={medCols}
        rows={med}
        look="Path a is large: people saw less mind in the AI. The indirect effects are about zero."
        note="Path labels as printed in the figures. a, b and the indirect effect follow the dissertation's coding (doctor = 0, AI = 1). Mind perception rated higher for the doctor: b = −1.02, z(412) = −4.331, p < .001."
      />
    </section>

    <section class="section" id="implications" aria-labelledby="implications-title">
      <h2 id="implications-title">What this means</h2>
      <div class="prose">
        <p>
          <strong>Trust in a recommender is not the same as following it.</strong> People said they trusted the doctor more in five studies and rated the doctor as having more mind here, yet they followed the AI's advice as closely as the doctor's.
          Stated preferences can overstate what people do. A product that depends on people acting on its advice should measure the action, not only the rating.
        </p>
        <p>
          <strong>I tried to make both versions work well, and that may have hidden a difference.</strong> Both recommenders gave a full explanation, a recording and a daily reminder. If a reliable source is enough for people to follow low-risk advice,
          differences might only show up when trust falls below some threshold, or when the stakes are higher.
        </p>
        <p>
          <strong>Limits.</strong> The advice was low stakes and easy to follow. It was delivered online to people who agreed to a 15-day study and were paid, so they may be more willing to follow a recommendation than patients in a clinic.
          The recommender text and the reminders were the same for both, which may have lessened any difference. The study could detect effects of about d = .265 or larger, so smaller differences are possible. Behavior was self-reported.
        </p>
      </div>
    </section>

    <section class="section" id="files" aria-labelledby="files-title">
      <h2 id="files-title">Sources and notes on the printed tables</h2>
      <div class="prose">
        <ul class="filelist">
          <li><a href="https://doi.org/10.17605/OSF.IO/736HEF">Preregistration on OSF</a>, written before data collection</li>
          <li><a href={href('/projects/trust-in-medical-ai/#dig-deeper')}>Bayes factors for the Study 6 comparisons</a>, computed from the printed statistics</li>
        </ul>
        <p>
          Everything here comes from the printed dissertation, not from the raw data. No participant-level data for Study 6 are on this site.
          The Bayes factors use the estimate and the width of the interval, so they are accurate to about the first digit.
        </p>
        <p>
          <strong>Printed values I could not reconcile.</strong> I show the tables as printed and use Model 1 for the effect of the advice. Table 24 Model 2 repeats the intercept (.11) and the advice effect (.28, [.207, .363]) from Table 23 Model 2 to every digit,
          and Model 3 prints the advice effect with a minus sign (−.28 and −.29) although the models above it print it as positive. A few intervals in Table 23 match each other exactly (for gender in Model 2 and for the interaction, and for mind perception in Model 3).
          The dissertation's participant counts also differ across models (510, 455 and 412). The conclusions do not depend on these values: the advice effect is large and clear of zero in every column, and the recommender effects are small and clear of nothing.
        </p>
        <p class="small muted">Please cite the dissertation: Leitao, M. R. (2024). <em>Artificial Intelligence, Humanization, and Health Beliefs</em>. Georgetown University.</p>
      </div>
    </section>
  </div>
</Base>

<style>
  .note { background: var(--wash); border-radius: 10px; padding: 1rem 1.2rem; margin: 1.5rem 0; }
  .note h2 { font-size: 1.15rem; margin: 0 0 0.4rem; }
  .note p { margin: 0; max-width: 70ch; }
  .sub { color: var(--muted); max-width: 66ch; }
  .forest { margin: 1.2rem 0 0; font-family: var(--display); max-width: 54rem; }
  .grp h3 { font-size: 1.05rem; margin: 1.2rem 0 0.4rem; }
  .row { display: grid; grid-template-columns: minmax(0, 14rem) minmax(0, 1fr) 11rem; gap: 0.2rem 1rem; align-items: center; padding: 0.35rem 0; border-bottom: 1px solid var(--rule); }
  .lab { font-size: 0.95rem; }
  .lab span { color: var(--muted); font-size: 0.8rem; }
  .row.key .lab { font-weight: 600; }
  .track { position: relative; height: 1.3rem; }
  .zero { position: absolute; top: 0; bottom: 0; width: 2px; background: var(--rule); margin-left: -1px; }
  .ci { position: absolute; top: 50%; height: 3px; margin-top: -1.5px; background: var(--steel); border-radius: 2px; }
  .pt { position: absolute; top: 50%; width: 11px; height: 11px; margin: -5.5px 0 0 -5.5px; border-radius: 50%; background: var(--deep); }
  .row.key .ci { background: var(--coral); } .row.key .pt { background: var(--coral); }
  .val { font-size: 0.85rem; font-variant-numeric: tabular-nums; color: var(--muted); }
  .axis { position: relative; height: 1.2rem; margin-left: calc(14rem + 1rem); margin-right: calc(11rem + 1rem); font-size: 0.8rem; color: var(--muted); }
  .axis span { position: absolute; transform: translateX(-50%); }
  @media (max-width: 760px) {
    .row { grid-template-columns: 1fr; }
    .axis { margin: 0; }
  }
  .filelist { padding-left: 1.2rem; font-family: var(--display); }
  .filelist li { margin-bottom: 0.3rem; }
  section :global(h2) { margin-bottom: 0.75rem; }
</style>
