---
import Base from '../../../layouts/Base.astro';
import StatTable from '../../../components/StatTable.astro';
import Raincloud from '../../../components/Raincloud.astro';
import DotPanels from '../../../components/DotPanels.astro';
import MainFindings from '../../../components/MainFindings.astro';
import Glossary from '../../../components/Glossary.astro';
import ChapterIntro from '../../../components/ChapterIntro.astro';
import GapScatter from '../../../components/GapScatter.astro';
import MediationDiagram from '../../../components/MediationDiagram.astro';
import full from '../../../data/trust-in-medical-ai/study2-full.json';
import pts from '../../../data/trust-in-medical-ai/study2-points.json';
import { href } from '../../../utils/url';
import BayesPlot from '../../../components/BayesPlot.astro';
import BayesGuide from '../../../components/BayesGuide.astro';
import FigureMap from '../../../components/FigureMap.astro';
import bayes from '../../../data/trust-in-medical-ai/bayes.json';

const repo = 'https://github.com/mrleitao/Psycho_Robot';
const f1 = (n: number | null) => (n == null ? '' : n.toFixed(1));
const f2 = (n: number | null) => (n == null ? '' : n.toFixed(2));
const noZero = (s: string) => s.replace(/^(-?)0\./, '$1.');
const minus = (s: string) => s.replace(/^-/, '−').replace(/\[-/g, '[−').replace(/, -/g, ', −');
const pv = (p: number) => (p < 0.001 ? '< .001' : noZero(p.toFixed(3)));
const r3 = (n: number) => minus(noZero(n.toFixed(3)));

const tt = Object.fromEntries(full.tests.map((t: any) => [t.id, t]));
const qt = Object.fromEntries(full.qualityTests.map((t: any) => [t.id, t]));
const ctest = Object.fromEntries(full.compositeTests.map((t: any) => [t.id, t]));
const findings = [
  {
    head: 'Almost everyone trusted the doctor more',
    body: [
      `${full.sample.n} adults rated how much they would trust a doctor, and how much they would trust a medical AI, for twelve decisions. Of the ${full.overallTest.n} people who answered every question, ${full.overallTest.higher} trusted the doctor more on average. ${full.overallTest.same} trusted both the same, and ${full.overallTest.lower} trusted the AI more.`,
      'The result held for diagnosing, prescribing and preventing, and for injuries, mental health, short illnesses and long ones.',
    ],
    visual: { type: 'people', total: full.overallTest.n, count: full.overallTest.higher, label: 'trusted the doctor more than the AI', caption: 'Each dot is one person. Blue dots trusted the doctor more.' },
  },
  {
    head: 'The gap is smallest for advice about prevention',
    body: [
      `Asked about a strep throat diagnosis, people trusted the doctor at ${tt.diagnose_strep_throat.meanA.toFixed(1)} and the AI at ${tt.diagnose_strep_throat.meanB.toFixed(1)}. Asked about advice to stretch, the scores were ${tt.prevent_injury_stretching.meanA.toFixed(1)} and ${tt.prevent_injury_stretching.meanB.toFixed(1)}.`,
      'People gave AI its best showing on everyday advice like stretching, vitamins and meditation. They gave it its worst when the decision was about finding out what is wrong, or about prescribing.',
    ],
    visual: { type: 'pairs', aName: 'Doctor', bName: 'AI', rows: [
      { label: 'Diagnose strep throat', a: tt.diagnose_strep_throat.meanA, b: tt.diagnose_strep_throat.meanB, max: 10 },
      { label: 'Prescribe antibiotics', a: tt.prescribe_antibiotics.meanA, b: tt.prescribe_antibiotics.meanB, max: 10 },
      { label: 'Recommend vitamin C and zinc', a: tt.prevent_acute_vitamins.meanA, b: tt.prevent_acute_vitamins.meanB, max: 10 },
      { label: 'Recommend stretching', a: tt.prevent_injury_stretching.meanA, b: tt.prevent_injury_stretching.meanB, max: 10 },
    ], caption: 'Average trust, 0 to 10.' },
  },
  {
    head: 'People rated the doctor higher on everything, not only skill',
    body: [
      'The doctor beat the AI on quantitative reasoning and intuition, and also on being warm and being competent. The biggest gaps were in warmth and in understanding how a person feels.',
      'The AI scored lowest on warmth, about 1 out of 4, against about 3 for the doctor. People did not just see a less skilled tool. They saw a colder one.',
    ],
    visual: { type: 'pairs', aName: 'Doctor', bName: 'AI', rows: [
      { label: 'Warmth (0 to 4)', a: qt.warmth.meanA, b: qt.warmth.meanB, max: 4 },
      { label: 'Competence (0 to 4)', a: qt.competence.meanA, b: qt.competence.meanB, max: 4 },
      { label: 'Intuition (0 to 10)', a: qt.intuition.meanA, b: qt.intuition.meanB, max: 10 },
      { label: 'Quantitative reasoning (0 to 10)', a: qt.quantitative_reasoning.meanA, b: qt.quantitative_reasoning.meanB, max: 10 },
    ], caption: 'Average ratings. Each bar is scaled to its own maximum.' },
  },
  {
    head: 'How people see the two explains about half the gap',
    body: [
      `Doctors were trusted ${full.mediation[1].total.toFixed(1)} points more on average. When I accounted for how capable people thought each one was at using numbers and judgment, ${(full.mediation[1].total - full.mediation[1].direct).toFixed(1)} of those points were accounted for. Competence mattered most of the four qualities I measured.`,
      'The rest remains unexplained. Some quality of doctors that I did not measure is also at work.',
    ],
    visual: { type: 'stat', value: `${full.mediation[1].total.toFixed(1)} to ${full.mediation[1].direct.toFixed(1)}`, label: 'points of trust gap, before and after accounting for how capable people thought each one was', caption: 'Intuition and quantitative reasoning together.' },
  },
  {
    head: 'It did not matter how number-driven the decision was',
    body: [
      'I expected people to be more open to an AI for decisions they see as needing data and statistics. They were not. The doctor kept the edge whether a decision seemed to call for numbers or for judgment.',
      'So the explanation lies in how people see the advice-giver, not in what kind of decision it is.',
    ],
  },
];
// ---- sample
const sampleRows = full.sample.variables.flatMap((v) =>
  v.rows.map((r) => ({ label: `${v.variable}: ${r.group}`, n: r.n, pct: `${r.pct.toFixed(1)}%` })),
);
const missingNote = full.sample.variables.filter((v) => v.missing).map((v) => `${v.variable.toLowerCase()} (${v.missing})`).join(', ');

// ---- need for quantitative reasoning
const descCols = [
  { key: 'label', label: 'Decision' },
  { key: 'n', label: 'n', num: true, hint: 'People with an answer' },
  { key: 'mean', label: 'Mean', num: true },
  { key: 'sd', label: 'SD', num: true, hint: 'Standard deviation' },
  { key: 'median', label: 'Median', num: true },
  { key: 'min', label: 'Min', num: true },
  { key: 'max', label: 'Max', num: true },
  { key: 'skew', label: 'Skew', num: true },
  { key: 'kurtosis', label: 'Kurtosis', num: true, hint: 'Excess kurtosis; 0 is a normal curve' },
  { key: 'se', label: 'SE', num: true, hint: 'Standard error of the mean' },
];
const descRow = (r: any, label = r.label) => ({
  label, n: r.n, mean: f2(r.mean), sd: f2(r.sd), median: f2(r.median), min: f2(r.min), max: f2(r.max),
  skew: minus(f2(r.skew)), kurtosis: minus(f2(r.kurtosis)), se: f2(r.se),
});
const decisionRows = [...full.decisionDescriptives].sort((a, b) => b.mean - a.mean).map((r) => descRow(r));
const compositeRows = full.compositeDescriptives.map((r) => descRow(r, `${r.label} (${r.items} decisions)`));
const relRows = full.reliability.map((r) => ({ label: r.label, k: r.items.length, alpha: noZero(r.alpha.toFixed(2)), rbar: noZero(r.meanR.toFixed(2)) }));

const byMean = (a: any, b: any) => b.mean - a.mean;
const kindOf = () => 'plain' as const;
const decisionCloud = [...pts.decisions].sort(byMean).map((r) => ({ ...r, kind: kindOf() }));
const comp = Object.fromEntries(pts.composites.map((r: any) => [r.id, r]));
const domainCloud = pts.domainOrder.map((k: string) => comp[k]).sort(byMean).map((r: any) => ({ ...r, kind: kindOf() }));
const stageCloud = pts.stageOrder.map((k: string) => comp[k]).sort(byMean).map((r: any) => ({ ...r, kind: kindOf() }));

// ---- trust: doctor vs AI
const cell = (m: number, lo: number, hi: number, n: number) => ({ mean: m, lo, hi, n });
// Intervals for each recommender's own mean: mean plus or minus 1.96 standard errors.
const seInterval = (d: any) => {
  const h = 1.96 * d.se;
  return cell(d.mean, d.mean - h, d.mean + h, d.n);
};
const trustDots: any[] = [];
for (const t of full.trustDescriptives) {
  trustDots.push({ head: t.label });
  trustDots.push({ label: 'Doctor', kind: 'human', cells: [seInterval(t.doctor)] });
  trustDots.push({ label: 'AI', kind: 'ai', cells: [seInterval(t.ai)] });
}
const gapDots = full.tests.map((t) => ({
  label: t.label, kind: 'plain', cells: [cell(t.diff, t.lo, t.hi, t.n), cell(t.d, t.dLo, t.dHi, t.n)],
}));

const testCols = [
  { key: 'text', label: 'Comparison', wrap: true, minw: '12rem' },
  { key: 'means', label: 'Doctor, AI: mean (SD)', num: true, wrap: true, minw: '9.5rem' },
  { key: 'diff', label: 'Difference [95% CI]', num: true },
  { key: 't', label: 't (df)', num: true },
  { key: 'p', label: 'p', num: true },
  { key: 'd', label: 'd [95% CI]', num: true, hint: 'Cohen’s d for paired data: the mean difference over the SD of the differences' },
  { key: 'dir', label: 'Doctor higher / same / lower', num: true, hint: 'How many people trusted the doctor more, the same, or less than the AI' },
];
const testRow = (t: any) => ({
  text: t.label,
  means: `${f2(t.meanA)} (${f2(t.sdA)}), ${f2(t.meanB)} (${f2(t.sdB)})`,
  diff: minus(`${f2(t.diff)} [${f2(t.lo)}, ${f2(t.hi)}]`),
  t: minus(`${f2(t.t)} (${t.df})`),
  p: pv(t.p),
  d: minus(`${f2(t.d)} [${f2(t.dLo)}, ${f2(t.dHi)}]`),
  dir: `${t.higher} / ${t.same} / ${t.lower}`,
});
const decisionTestRows = full.tests.map(testRow);
const compTestRows = [full.overallTest, ...full.compositeTests].map(testRow);
const qualityRows = full.qualityTests.map((t) => testRow({ ...t, label: `${t.label} (${t.scale})` }));

// person-level split: how many people sit where
const ov = full.overallTest;

// ---- clouds
const trustCloud = pts.trustOverall;
const qualityClouds = pts.qualityClouds.map((q: any) => ({
  ...q,
  grid: Array.from({ length: 51 }, (_, i) => (i * q.top) / 50),
}));

// ---- H2 / gap by need
const gn = full.gapByNeed;

// ---- H3 correlations
const corrRows = full.correlationsByTarget.flatMap((c: any) =>
  c.vars.flatMap((a: string, i: number) =>
    c.vars.slice(i + 1).map((b: string, j: number) => ({
      who: c.who, pair: `${a} and ${b}`, r: r3(c.r[i][i + 1 + j]), p: pv(c.p[i][i + 1 + j]), n: c.n[i][i + 1 + j],
    })),
  ),
);
const wb = full.withinBetween;
const wbRows: any[] = [];
for (let i = 0; i < wb.vars.length; i++)
  for (let j = i + 1; j < wb.vars.length; j++)
    wbRows.push({
      pair: `${wb.vars[i]} and ${wb.vars[j]}`,
      between: `${r3(wb.between[i][j])} (${pv(wb.pBetween[i][j])})`,
      within: `${r3(wb.within[i][j])} (${pv(wb.pWithin[i][j])})`,
    });

// ---- mixed models
const models = full.mixedModels;
const termName: Record<string, string> = {
  Intercept: 'Intercept', IsDoc: 'Doctor (versus AI)', Int_Quant: 'Quantitative reasoning the decision needs',
  'IsDoc:Int_Quant': 'Doctor × need for quantitative reasoning', Intuition: 'Intuition', Quant: 'Quantitative reasoning',
  Warmth: 'Warmth', Competence: 'Competence', Mind: 'Mind perception', AgeGroup: 'Age group (1 to 4)', IsMale: 'Man (versus woman)',
  'AgeGroup:IsDoc': 'Age group × doctor', 'Intuition:Int_Quant': 'Intuition × need', 'Quant:Int_Quant': 'Quantitative reasoning × need',
};
const modelCols = [
  { key: 'term', label: 'Predictor', wrap: true, minw: '14rem' },
  { key: 'b', label: 'b [95% CI]', num: true },
  { key: 'beta', label: 'Standardized β', num: true, hint: 'b times the SD of the predictor over the SD of trust. Not given for interactions.' },
  { key: 'z', label: 'z', num: true },
  { key: 'p', label: 'p', num: true },
  { key: 'vif', label: 'VIF', num: true, hint: 'Variance inflation factor. Values above 5 mean the predictor overlaps heavily with others; doctor and its interaction overlap by construction.' },
];
const modelRows = (m: any) =>
  m.terms.map((t: any) => ({
    term: termName[t.term] ?? t.term,
    b: minus(`${f3(t.b)} [${f3(t.lo)}, ${f3(t.hi)}]`),
    beta: t.beta == null ? '' : minus(f2(t.beta)),
    z: minus(f2(t.z)),
    p: pv(t.p),
    vif: t.vif == null ? '' : f2(t.vif),
  }));
function f3(n: number) { return n.toFixed(3); }
const modelFit = (m: any) =>
  `${m.n.toLocaleString('en-US')} ratings from ${m.people} people. Person variance ${f2(m.varPerson)}${m.varSlope != null ? `, slope variance ${m.varSlope}` : ''}, residual ${f2(m.varResidual)}. Share of variance between people (ICC) ${noZero(f2(m.icc))}. R² ${noZero(f2(m.r2m))} from the predictors alone, ${noZero(f2(m.r2c))} with the person effects.${m.aic != null ? ` AIC ${m.aic}.` : ''}`;

// ---- mediation
const med = full.mediation;
const medRows = med.flatMap((m: any) =>
  m.mediators.map((r: any) => ({
    model: m.label, mediator: r.name, a: minus(f2(r.a)), b: minus(f2(r.b)),
    ind: minus(`${f2(r.indirect)} [${f2(r.lo)}, ${f2(r.hi)}]`), z: minus(f2(r.z)), p: pv(r.p),
  })),
);

// ---- who differs
const gapItems: any[] = [];
for (const s of full.subgroups) {
  gapItems.push({ head: s.variable });
  for (const g of s.groups) gapItems.push({ label: g.label, sub: `n = ${g.n}`, kind: 'plain', cells: g.cells });
}
const subTestRows = full.subgroups.map((s: any) => ({
  label: s.variable,
  groups: s.groups.map((g: any) => g.label).join('; '),
  ...Object.fromEntries(
    ['trust', 'qr', 'int'].map((k, i) => {
      const t = s.tests[i];
      return [k, t ? `${t.stat === 'F' ? `F(${t.df[0]}, ${t.df[1]})` : `t(${t.df})`} = ${minus(f2(t.value))}, p ${pv(t.p).replace(/^</, '<').replace(/^(\d|\.)/, '= $1')}` : ''];
    }),
  ),
}));
const ageModel = models[6];
const ageInt = ageModel.terms.find((t: any) => t.term === 'AgeGroup:IsDoc');

const toc = [
  ['sample', 'Who took part'],
  ['decisions', 'Twelve medical decisions'],
  ['trust', 'Doctor versus AI'],
  ['views', 'How the doctor and the AI were seen'],
  ['need', 'Does the gap depend on the decision?'],
  ['qualities', 'What goes with trust'],
  ['mediation', 'What explains the gap'],
  ['who', 'Does the gap differ between people?'],
  ['implications', 'What this means'],
  ['dig-deeper', 'Dig deeper'],
  ['files', 'Files and methods'],
];

const bayesRows = bayes.rows
  .filter((r) => r.study === 'Study 2')
  .map((r) => ({ ...r, text: r.id === 'H2-interaction' ? 'H2: Does the gap depend on the need for quantitative reasoning?' : r.id === 'H5-warmth' ? 'H5: Does warmth explain the gap? (indirect effect)' : r.text }));
const bf = (id: string) => bayes.rows.find((r) => r.id === id)!;
const fmtBF = (b: number) => (b >= 100 ? b.toFixed(0) : b >= 10 ? b.toFixed(0) : b.toFixed(1));
const figureMap2 = [
  { diss: 'Table 4', what: 'The twelve medical decisions and how they were grouped', here: 'Tables 2 and 3', href: '#table-decisions' },
  { diss: 'Figure 9', what: 'Quantitative reasoning needed, decision by decision', here: 'Figure 1', href: '#fig-decisions' },
  { diss: 'Figure 10', what: 'Trust in the doctor and the AI, decision by decision', here: 'Figures 5 and 6', href: '#fig-trust-dots', note: 'Figure 4 shows each person' },
  { diss: 'Table 5 and Hypothesis 1', what: 'Paired t tests of trust, decision by decision', here: 'Table 5', href: '#table-tests', note: 'The dissertation text and its Table 5 differ slightly in a few means; this page reports the data' },
  { diss: 'Tables 6 and 7', what: 'The same test for the stage and domain composites', here: 'Table 6', href: '#table-comp-tests' },
  { diss: 'Table 8 and Hypothesis 2', what: 'Mixed model with the doctor-by-need interaction', here: 'Table 8, Figure 11', href: '#table-h2', note: 'Full model, with warmth and competence, is in the mixed models below' },
  { diss: 'Tables 9 and 10', what: 'Correlations among quantitative reasoning, intuition, warmth, competence, for each recommender', here: 'Table 9', href: '#table-corr' },
  { diss: 'Tables 11 and 12', what: 'Within-person and between-person correlations', here: 'Table 10', href: '#table-wb' },
  { diss: 'Figure 11', what: 'Mediation through warmth and competence', here: 'Figure 12', href: '#fig-med-0' },
  { diss: 'Figure 12 and Additional Mediation Models', what: 'Mediation through intuition and quantitative reasoning', here: 'Figure 13 and Table 15', href: '#fig-med-1' },
];
---

<Base
  title="Trust in medical AI: Study 2 in full"
  description="Every table and figure from the Study 2 analysis of my dissertation, rebuilt from the public data with hover details."
>
  <div class="wrap">
    <header class="page-head">
      <p class="back small"><a href={href('/projects/trust-in-medical-ai/')}>Trust in medical AI</a></p>
      <h1>Study 2 in full</h1>
      <p class="lede">
        {full.sample.n} adults said how much they would trust a doctor, and how much they would trust a medical AI, to make each of
        twelve medical decisions, and then rated both on quantitative reasoning, intuition, warmth, competence and several
        mind-perception items. This page rebuilds the tables and figures of that analysis from the released data. Hover over any mark for the details.
      </p>
    </header>

    <ChapterIntro current="2" />

    <section class="section" id="main-findings" aria-labelledby="mf-title">
      <h2 id="mf-title">Main findings</h2>
      <MainFindings findings={findings} />
    </section>

    <div class="deep">
      <h2 id="deep-dive">Deep dive: every table and figure</h2>
      <p>
        The rest of this page rebuilds each analysis from the public data. Hover over any mark for the details, and open the guide below if a term is unfamiliar.
      </p>
      <Glossary />
    </div>

    <nav class="toc" aria-label="On this page">
      <ul>
        {toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
      </ul>
    </nav>

    <div class="prose">
      <p class="how small muted">
        How to read this page. Differences are always <em>doctor minus AI</em>, so a positive number means more trust in, or a higher rating of, the doctor.
        Ratings are shown on the scales people saw: 0 to 10, except competence and warmth (0 to 4). The public file groups age into four bands, so the
        models that used age in years use the band number (1 = 18 to 44, 4 = 70 and over) and the age results differ a little from the dissertation; the
        “Does the gap differ between people?” section shows both.
      </p>
    </div>

    <!-- ============================ sample ============================ -->
    <section class="section" id="sample" aria-labelledby="sample-title">
      <h2 id="sample-title">Who took part</h2>
      <p class="intro">
        {full.sample.n} adults, recruited through CloudResearch's Prime Panels, finished the study. Each answered the same questions about a doctor and
        about an AI, so every comparison below is within a person.
      </p>
      <StatTable
        id="table-sample"
        title="Table 1. The people in the released file"
        columns={[{ key: 'label', label: 'Group' }, { key: 'n', label: 'People', num: true }, { key: 'pct', label: 'Share', num: true }]}
        rows={sampleRows}
        note={`Shares are of all ${full.sample.n} people. Left blank in the file: ${missingNote}. Race is shown as White or another or multiple because no other group reached 30 people. Age is in bands; exact age is not released.`}
      />
    </section>

    <!-- ============================ decisions ============================ -->
    <section class="section" id="decisions" aria-labelledby="decisions-title">
      <h2 id="decisions-title">Twelve medical decisions</h2>
      <p class="intro">
        The twelve decisions cross four kinds of health problem (bodily injury, mental health, acute sickness, chronic sickness) with three stages of care
        (preventing, diagnosing and prescribing). For each, people slid from 0 (needs only intuition) to 100 (needs only quantitative reasoning).
      </p>
      <StatTable
        id="table-decisions"
        title="Table 2. Quantitative reasoning needed, by decision (0 to 100)"
        columns={descCols}
        rows={decisionRows}
        note="Sorted from most to least quantitative reasoning needed. Skew and kurtosis are the estimates psych::describe reports."
      />
      <h3 class="fig-title" id="fig-decisions">Figure 1. Every decision, every person</h3>
      <Raincloud rows={decisionCloud} grid={pts.densityGrid100} domain={[0, 100]} tickStep={20}
        xLabel="Needs intuition (0) versus needs quantitative reasoning (100)" ariaLabel="Distribution of ratings for each of twelve medical decisions, ordered by average" />

      <StatTable
        id="table-composites"
        title="Table 3. The decision groups (0 to 100)"
        columns={descCols.map((c) => (c.key === 'label' ? { ...c, label: 'Group' } : c))}
        rows={compositeRows}
        note="Each group is the average of its decisions. A person missing any decision in a group is missing for that group. Physical health is every decision except the mental health ones."
      />
      <h3 class="fig-title" id="fig-domain">Figure 2. By kind of health problem</h3>
      <Raincloud rows={domainCloud} grid={pts.densityGrid100} domain={[0, 100]} tickStep={20}
        xLabel="Intuition (0) versus quantitative reasoning (100)" ariaLabel="Distribution of ratings by kind of health problem" />
      <h3 class="fig-title" id="fig-stage">Figure 3. By stage of care</h3>
      <Raincloud rows={stageCloud} grid={pts.densityGrid100} domain={[0, 100]} tickStep={20}
        xLabel="Intuition (0) versus quantitative reasoning (100)" ariaLabel="Distribution of ratings by stage of care" />

      <StatTable
        id="table-reliability"
        title="Table 4. Do the decisions in each group hang together?"
        columns={[
          { key: 'label', label: 'Group' }, { key: 'k', label: 'Decisions', num: true },
          { key: 'alpha', label: 'Alpha', num: true, hint: 'Cronbach’s alpha: 0 to 1, higher means people answered the decisions alike' },
          { key: 'rbar', label: 'Mean inter-item r', num: true },
        ]}
        rows={relRows}
      />
    </section>

    <!-- ============================ trust ============================ -->
    <section class="section" id="trust" aria-labelledby="trust-title">
      <h2 id="trust-title">Doctor versus AI</h2>
      <p class="intro">
        On average people would trust a doctor about {f1(ov.diff)} points more than an AI on the 0 to 10 scale (d = {f2(ov.d)}).
        {ov.higher} of {ov.n} people trusted the doctor more across the twelve decisions, {ov.same} trusted both the same, and {ov.lower} trusted the AI more.
        The preregistered tests (H1) ask this for each decision.
      </p>
      <h3 class="fig-title" id="fig-trust-overall">Figure 4. Each person's average trust, doctor and AI</h3>
      <Raincloud rows={trustCloud} grid={pts.densityGrid10} domain={[0, 10]} tickStep={1} xJitter={0.1}
        xLabel="Average trust over twelve decisions (0 to 10)" ariaLabel="Distribution of each person's average trust in a doctor and in an AI" />

      <StatTable id="table-tests" title="Table 5. Trust in a doctor versus an AI, by decision (0 to 10)" columns={testCols} rows={decisionTestRows}
        note="Paired t tests, two-sided. The 95% interval for d inverts the noncentral t distribution. The gap is large for every decision and smallest for the three preventative ones." />
      <h3 class="fig-title" id="fig-trust-dots">Figure 5. Trust in a doctor and in an AI, decision by decision</h3>
      <DotPanels
        items={trustDots}
        panels={[{ title: 'Trust', domain: [0, 10], tickStep: 1, axisLabel: 'Average trust (0 to 10)' }]}
        ariaLabel="Average trust in a doctor and in an AI for each of twelve decisions, with 95% intervals"
        tableLabel="Decision"
        valueLabel="Average"
      />
      <h3 class="fig-title" id="fig-gap-dots">Figure 6. The gap and its size, decision by decision</h3>
      <DotPanels
        items={gapDots}
        panels={[
          { title: 'Trust gap (doctor − AI)', domain: [0, 6], tickStep: 1, zero: true, axisLabel: 'Points of trust (0 to 10)' },
          { title: 'Effect size (d)', domain: [0, 2], tickStep: 0.5, zero: true, axisLabel: 'Cohen’s d' },
        ]}
        ariaLabel="The doctor-minus-AI trust gap and its effect size for each of twelve decisions, with 95% intervals"
        tableLabel="Decision"
        valueLabel="Value"
      />
      <StatTable id="table-comp-tests" title="Table 6. The same test for the decision groups" columns={testCols.map((c) => (c.key === 'text' ? { ...c, label: 'Group' } : c))} rows={compTestRows}
        note="Trust is the average of the decisions in the group." />
    </section>

    <!-- ============================ views ============================ -->
    <section class="section" id="views" aria-labelledby="views-title">
      <h2 id="views-title">How the doctor and the AI were seen</h2>
      <p class="intro">
        People also rated the doctor and the AI on eleven qualities. The doctor was rated higher on every one. The gaps are largest for warmth,
        understanding feelings, competence and intuition, and smallest for transparency, anticipating needs and quantitative reasoning.
      </p>
      <StatTable id="table-qualities" title="Table 7. The doctor and the AI on each quality" columns={testCols.map((c) => (c.key === 'text' ? { ...c, label: 'Quality (scale)' } : c))} rows={qualityRows}
        note="Competence and warmth are on a 0 to 4 scale, the rest on 0 to 10, so differences are not comparable across scales; effect sizes (d) are. The seven mind-perception items are the last seven rows." />
      {qualityClouds.map((q: any, i: number) => (
        <div class="cloud">
          <h3 class="fig-title mini" id={`fig-quality-${q.key}`}>Figure {7 + i}. {q.label}</h3>
          <Raincloud rows={q.rows} grid={q.grid} domain={[0, q.top]} tickStep={q.top === 4 ? 1 : 1} xJitter={0.15}
            xLabel={`${q.label}, rating (0 to ${q.top})`} ariaLabel={`${q.label}: each person's rating of the doctor and of the AI`} />
        </div>
      ))}
    </section>

    <!-- ============================ need ============================ -->
    <section class="section" id="need" aria-labelledby="need-title">
      <h2 id="need-title">Does the gap depend on the decision?</h2>
      <p class="intro">
        The second preregistered hypothesis (H2) asked whether the doctor's edge changes with how much quantitative reasoning a decision needs. On its own,
        that need shifts the gap a little: for every extra 10 points the doctor's edge shrinks by {f2(Math.abs(models[1].terms[3].b) * 10)} points (Table 8).
        The dissertation tests H2 with intuition, quantitative reasoning, warmth, competence, age and gender in the model, and there the interaction disappears
        (b = {f3(models[2].terms.find((t) => t.term === 'IsDoc:Int_Quant').b)}, p = {noZero(f2(models[2].terms.find((t) => t.term === 'IsDoc:Int_Quant').p))}; Table 11). I read that as no evidence that the need for quantitative reasoning moderates the gap.
        Comparing the twelve decisions with each other (Figure 11) shows a different pattern, because the three preventative decisions are rated as needing less
        quantitative reasoning and also show the smallest gaps; that comparison is descriptive and does not test H2.</p>
      <StatTable id="table-h2" title="Table 8. Trust predicted from doctor versus AI, and from how much quantitative reasoning the decision needs" columns={modelCols} rows={modelRows(models[1])} note={`${models[1].label}. ${modelFit(models[1])} ${full.mixedNote}`} />
      <h3 class="fig-title" id="fig-gap-need">Figure 11. The gap and the need for quantitative reasoning, by decision</h3>
      <GapScatter
        points={gn.points} slope={gn.slope} intercept={gn.intercept} r={gn.r}
        xDomain={[50, 70]} yDomain={[2, 5.5]}
        xTitle="Average quantitative reasoning the decision needs (0 to 100)" yTitle="Doctor minus AI trust"
        ariaLabel="For each of twelve decisions, the quantitative reasoning it needs against the doctor-minus-AI trust gap"
      />
    </section>

    <!-- ============================ qualities ============================ -->
    <section class="section" id="qualities" aria-labelledby="qualities-title">
      <h2 id="qualities-title">What goes with trust</h2>
      <p class="intro">
        The third hypothesis (H3) asked whether trust follows how people see the recommender. Quantitative reasoning, intuition, competence and warmth are
        all positively correlated for the doctor and for the AI. Because every person rated both, I also separate the part of each correlation that
        comes from who the person is (between people) from the part that comes from whether the recommender is the doctor or the AI (within people).
      </p>
      <StatTable id="table-corr" title="Table 9. Correlations among the four qualities, for the doctor and for the AI" columns={[
        { key: 'who', label: 'Recommender' }, { key: 'pair', label: 'Pair', wrap: true, minw: '16rem' }, { key: 'r', label: 'r', num: true }, { key: 'p', label: 'p', num: true }, { key: 'n', label: 'n', num: true },
      ]} rows={corrRows} note="Pearson correlations among the people who answered both items." />
      <StatTable id="table-wb" title="Table 10. Between-person and within-person correlations" columns={[
        { key: 'pair', label: 'Pair', wrap: true, minw: '16rem' },
        { key: 'between', label: 'Between people, r (p)', num: true, hint: 'Do people who rate the doctor and AI high on one thing rate them high on the other, on average?' },
        { key: 'within', label: 'Within people, r (p)', num: true, hint: 'For one person, is the target rated higher on one quality also rated higher on the other?' },
      ]} rows={wbRows} note={full.withinBetweenNote} />
      <p class="small muted note">
        Reliability of the mind-perception items: {full.mindReliability.map((m) => `${m.label}, alpha ${noZero(m.alpha.toFixed(2))}`).join('; ')}.
      </p>

      <h3 class="fig-title" id="models">Mixed models of trust</h3>
      <p class="intro">
        These add the qualities to the model above. Every version keeps the doctor-versus-AI gap large, and competence and quantitative reasoning carry the most weight.
        Adding the qualities cuts the unexplained gap in trust by more than half, from {f2(models[0].terms[1].b)} to {f2(models[2].terms[1].b)} points.
      </p>
      {models.slice(2, 6).map((m: any, i: number) => (
        <StatTable id={`table-model-${i + 9}`} title={`Table ${11 + i}. ${m.label}`} columns={modelCols} rows={modelRows(m)} note={`${modelFit(m)}`} />
      ))}
      <p class="small muted note">{full.mixedNote}</p>
    </section>

    <!-- ============================ mediation ============================ -->
    <section class="section" id="mediation" aria-labelledby="mediation-title">
      <h2 id="mediation-title">What explains the gap?</h2>
      <p class="intro">
        If people trust doctors more because they see them as warmer, more competent, more intuitive or better at quantitative reasoning, then those
        ratings should carry part of the gap (H4). Taken together, competence carries a clear share (warmth's interval includes zero once competence is in the model), and so do intuition and quantitative reasoning.
      </p>
      <StatTable id="table-mediation" title="Table 15. Indirect effects of doctor versus AI on trust, through each quality" columns={[
        { key: 'model', label: 'Model', wrap: true, minw: '12rem' }, { key: 'mediator', label: 'Through' },
        { key: 'a', label: 'a', num: true, hint: 'Effect of doctor (versus AI) on the quality' },
        { key: 'b', label: 'b', num: true, hint: 'Effect of the quality on trust, holding doctor versus AI fixed' },
        { key: 'ind', label: 'a × b [95% CI]', num: true }, { key: 'z', label: 'z', num: true }, { key: 'p', label: 'p', num: true },
      ]} rows={medRows} note={full.mediationNote} />
      {med.slice(0, 2).map((m: any, i: number) => (
        <>
          <h3 class="fig-title" id={`fig-med-${i}`}>Figure {12 + i}. {m.label}</h3>
          <MediationDiagram title={m.label} mediators={m.mediators} direct={m.direct} total={m.total} />
        </>
      ))}
    </section>

    <!-- ============================ who ============================ -->
    <section class="section" id="who" aria-labelledby="who-title">
      <h2 id="who-title">Does the gap differ between people?</h2>
      <p class="intro">
        The gap is large in every group, and the intervals overlap throughout. Nothing here is a finding on its own, but I report it so readers can see how
        steady the result is.
      </p>
      <h3 class="fig-title" id="fig-who">Figure 14. The doctor-minus-AI gap, by group of people</h3>
      <DotPanels
        items={gapItems}
        panels={[
          { title: 'Trust', domain: [0, 7], tickStep: 1, zero: true, axisLabel: 'Doctor minus AI (0 to 10)' },
          { title: 'Quantitative reasoning', domain: [-1, 6], tickStep: 1, zero: true, axisLabel: 'Doctor minus AI (0 to 10)' },
          { title: 'Intuition', domain: [0, 7], tickStep: 1, zero: true, axisLabel: 'Doctor minus AI (0 to 10)' },
        ]}
        ariaLabel="The doctor-minus-AI gap in trust, quantitative reasoning and intuition for each group of people"
        tableLabel="Group"
        valueLabel="Average gap"
      />
      <StatTable id="table-who" title="Table 16. Does the gap differ between groups?" columns={[
        { key: 'label', label: 'Compared by' }, { key: 'groups', label: 'Groups', wrap: true, minw: '12rem' },
        { key: 'trust', label: 'Trust', num: true, wrap: true, minw: '12rem' },
        { key: 'qr', label: 'Quantitative reasoning', num: true, wrap: true, minw: '12rem' },
        { key: 'int', label: 'Intuition', num: true, wrap: true, minw: '12rem' },
      ]} rows={subTestRows} note={full.subgroupNote} />
      <div class="prose">
        <h3>Age: two versions</h3>
        <p>
          The one result that moves with age is in the last model (Table 17): the doctor's edge grows with age band (b = {f3(ageInt.b)} per band, p {pv(ageInt.p)}).
          The dissertation's Table 8 used age in years. Rerunning that model privately with exact age gives the same main results as here (doctor 1.683, intuition .140,
          quantitative reasoning .272, warmth .134, competence .578, age .002, man .037), so the age bands lose nothing important. Exact age stays out of the public file
          because with a sample this size, an exact age together with gender and education could point to one person.
        </p>
      </div>
      <StatTable id="table-age" title="Table 17. Age band by doctor interaction" columns={modelCols} rows={modelRows(ageModel)} note={modelFit(ageModel)} />
    </section>

    <!-- ============================ implications ============================ -->
    <section class="section" id="implications" aria-labelledby="implications-title">
      <h2 id="implications-title">What this means</h2>
      <div class="prose">
        <p>
          <strong>The gap is robust.</strong> People trusted a doctor more than an AI on every one of the twelve decisions, in every kind of health problem and
          at every stage of care, and the result survives correction for twelve tests. It is large (d from {f2(Math.min(...full.tests.map((t) => t.d)))} to {f2(Math.max(...full.tests.map((t) => t.d)))}),
          and smallest for the preventative decisions, such as recommending stretching or vitamins. Together with Study 1, this is a double replication, which is why
          the later studies could take the gap as given and try to change it. It does not mean people give an AI no trust: the average for the AI was about 4 on the 0 to 10 scale, not zero. They give it a more skeptical reading than they give a doctor.
        </p>
        <p>
          <strong>What a decision needs does not explain the gap.</strong> The gap varied from decision to decision, but not in step with how much quantitative
          reasoning people said the decision needed. So whatever makes some decisions feel better suited to an AI, it is something other than the
          quantitative-versus-intuition trade-off I measured. That measure is a single slider that treats the two as opposites, and a future version should rate
          them separately.
        </p>
        <p>
          <strong>How people see the recommender explains part of it.</strong> Doctors were rated higher than the AI on quantitative reasoning, intuition, warmth,
          competence and every mind-perception item. Quantitative reasoning and intuition each carried a significant share of the gap, even together, whereas
          warmth did not once competence was in the model. Neither explains the whole gap: about half of it remained after the mediators were
          included ({f2(med[1].direct)} of {f2(med[1].total)} points). Still, it gives a framework for how people judge a recommender, and so for predicting and perhaps
          shifting their trust. If an AI is to earn more trust, it will do so by being seen as capable of both kinds of reasoning, not by changing what it recommends.
        </p>
        <p>
          <strong>Cautions.</strong> The qualities people rated are strongly correlated, so some of what looks like separate mechanisms may be a general
          positive impression of the recommender; each still carries a unique share in the model, which argues against that being the whole story. The decisions
          were abstract, so people supplied their own picture of the situation. The sample is 106 online-panel adults with an older average age (63 in the dissertation), and
          the results are about stated trust, not behavior. Chapters 3 and 4 take up the first and last of these.
        </p>
      </div>
    </section>

    <!-- ============================ dig deeper ============================ -->
    <section class="section" id="dig-deeper" aria-labelledby="dig-title">
      <div class="deep">
        <h2 id="dig-title">Dig deeper</h2>
        <p>Two more things for readers who want them: where each figure and table of the dissertation sits on this page, and a Bayesian check on every comparison that found no difference.</p>
      </div>
      <h3 class="fig-title">Where each dissertation figure and table lives</h3>
      <FigureMap rows={figureMap2} />

      <h3 class="fig-title" id="bayes">When the test found no difference</h3>
      <BayesGuide />
      <BayesPlot rows={bayesRows} />
      <div class="prose">
        <p>
          <strong>The gap does not depend on how much quantitative reasoning a decision needs.</strong> The doctor-by-need interaction (hypothesis 2) was not significant. The Bayes factor for no
          moderation is {fmtBF(bf('H2-interaction').bf01)}, strong evidence that the doctor-minus-AI gap is the same whether a decision leans on numbers or on judgment.
          The dissertation reached the same conclusion from the p value, and this makes it firmer.
        </p>
        <p>
          <strong>The gap is the same size across kinds of health problem.</strong> Physical against mental health, and bodily injury, acute sickness and chronic sickness against each other,
          all give Bayes factors for no difference between {fmtBF(Math.min(...['gap-Physical health-Mental health','gap-Bodily injury-Acute sickness','gap-Bodily injury-Chronic sickness','gap-Acute sickness-Chronic sickness'].map((i) => bf(i).bf01)))} and {fmtBF(Math.max(...['gap-Physical health-Mental health','gap-Bodily injury-Acute sickness','gap-Bodily injury-Chronic sickness','gap-Acute sickness-Chronic sickness'].map((i) => bf(i).bf01)))}, moderate evidence.
          Stage of care is different: the gap for preventative decisions is clearly smaller than for diagnostic or prescriptive ones, with Bayes factors above 1,000,000. Diagnostic and prescriptive gaps match (BF01 = {fmtBF(bf('gap-Diagnostic-Prescriptive').bf01)}).
        </p>
        <p>
          <strong>Gender made no difference to trust; age is unclear.</strong> The Bayes factor for no gender difference is {fmtBF(bf('gender').bf01)}, strong. Age by itself is moderate ({fmtBF(bf('age').bf01)}),
          but whether the gap grows with age is inconclusive ({fmtBF(bf('age-by-doctor').bf10)} for a difference, despite p = .013), so I would not lean on that finding.
        </p>
        <p>
          <strong>Warmth did not explain the gap, but the evidence is moderate.</strong> The warmth pathway was not significant in the model that also included competence. The Bayes factor for no
          indirect effect is {fmtBF(bf('H5-warmth').bf01)}. This one assumes the indirect effect is roughly bell-shaped, which indirect effects often are not, so treat it as a guide.
        </p>
      </div>
    </section>

    <!-- ============================ files ============================ -->
    <section class="section" id="files" aria-labelledby="files-title">
      <h2 id="files-title">Files and methods</h2>
      <div class="prose">
        <ul class="filelist">
          <li><a href={href('/data/study2-ratings.csv')}>study2-ratings.csv</a>, the de-identified ratings</li>
          <li><a href={href('/data/study2-codebook.csv')}>study2-codebook.csv</a>, what every column means</li>
          <li><a href={href('/code/study2-analysis.R')}>study2-analysis.R</a>, the main tests in R, from the public file</li>
          <li><a href={href('/code/study2-original-analysis.Rmd')}>study2-original-analysis.Rmd</a>, my original notebook, run on the raw export</li>
          <li><a href={href('/docs/study2-preregistration.pdf')}>Preregistration (PDF)</a>, written before data collection</li>
          <li><a href={`${repo}/blob/main/analysis/study2-full-results.py`}>study2-full-results.py</a>, the code behind every table and figure on this page</li>
          <li><a href={`${repo}/blob/main/analysis/study2-deidentify.py`}>study2-deidentify.py</a>, how the raw export became the public file</li>
        </ul>
        <p>
          Everything above was computed in Python from the released file. Where the notebook used an R package or Mplus I used the closest equivalent: descriptives and
          reliability follow psych, the mixed models follow lme4 with a random intercept and a random slope for the decision's need for quantitative reasoning, and
          the mediation models are within-person regressions with a bootstrap over people. The main results match the dissertation: for example the doctor
          effect of 1.68 and the weights on intuition (.14), quantitative reasoning (.27), warmth (.14) and competence (.58).
        </p>
        <p>
          Four differences are worth knowing. People's ratings here are on the scales they saw, whereas the notebook kept some of the survey's stored codes, so
          means and intercepts differ while differences, slopes and correlations match. Composites are missing when any item is missing. Age is in bands. And the
          mediation tests are close to, not identical to, the Mplus output. I have not run the R code on the released file to compare line by line.
        </p>
        <p class="small muted">
          The data, codebook and preregistration are shared under <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>; the code under the MIT license. Please do not use the file to try to identify anyone.
          Please cite the dissertation: Leitao, M. R. (2024). <em>Artificial Intelligence, Humanization, and Health Beliefs</em>. Georgetown University.
        </p>
      </div>
    </section>
  </div>
</Base>

