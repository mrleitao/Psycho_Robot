          ]}
          rows={subTestRows}
          note="t tests for two groups and one-way F tests for more. Exploratory, and not adjusted for running 18 tests, so treat a single small p as a lead, not a finding. The groups overlap (for example, older people and people with less AI experience), so this does not say which characteristic matters."
        />
      </section>

      <section class="section" id="hva-model" aria-labelledby="hva-model-title">
        <h2 id="hva-model-title">What goes with trust, for humans and for AI</h2>
        <p class="intro">
          For humans, perceived quantitative reasoning is the stronger partner of trust. For AI, it is perceived intuition. Letting the
          two slopes differ by recommender type improves the model (Table 13 in “All of Study 1”: χ² = {f2(full.modelComparisons[1].chi2)},
          p {pv(full.modelComparisons[1].p)}).
        </p>
        <StatTable
          id="table-hva-coef"
          title="Table 20. Trust predicted from the other two ratings, humans and AI"
          columns={[
            { key: 'label', label: 'Predictor' },
            { key: 'hum', label: 'Humans, b [95% CI]', num: true },
            { key: 'ai', label: 'AI, b [95% CI]', num: true },
          ]}
          rows={coefRows}
          note="Mixed models with a random intercept for each person, fitted separately to the human and AI recommenders (the doctor using AI counts as AI, as in the notebook). b is the change in trust for one more point on the predictor, holding the other predictor fixed."
        />
        <h3 class="fig-title" id="fig-hva-slopes">Figure 14. Predicted trust, humans and AI</h3>
        <SlopesPlot lines={slopes} />
        <p class="small muted note">{full.slopes.note}</p>
      </section>
    </div>
  </div>
</Base>

<script>
  // Two tabs. Both panels are in the page, so without scripting everything is simply shown.
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
  const panels = new Map(tabs.map((t) => [t.dataset.tab as string, document.getElementById(`panel-${t.dataset.tab}`) as HTMLElement]));
  function select(name: string, focus = false) {
    tabs.forEach((t) => {
      const on = t.dataset.tab === name;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      if (on && focus) t.focus();
    });
    panels.forEach((p, k) => (p.hidden = k !== name));
  }
  function fromHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    if (id === 'humans-vs-ai') return select('ai');
    const el = document.getElementById(id);
    const name = el?.closest('[role="tabpanel"]')?.id.replace('panel-', '');
    if (name) {
      select(name);
      el?.scrollIntoView();
    }
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => {
      select(t.dataset.tab as string);
      history.replaceState(null, '', t.dataset.tab === 'ai' ? '#humans-vs-ai' : location.pathname + location.search);
    });
    t.addEventListener('keydown', (e) => {
      const j = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : e.key === 'Home' ? 0 : e.key === 'End' ? tabs.length - 1 : -1;
      if (j < 0) return;
      e.preventDefault();
      select(tabs[(j + tabs.length) % tabs.length].dataset.tab as string, true);
    });
  });
  addEventListener('hashchange', fromHash);
  select('full');
  fromHash();
</script>

