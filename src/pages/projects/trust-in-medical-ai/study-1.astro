        <StatTable
          id="table-hva-who"
          title="Table 19. Does the gap differ between groups?"
          columns={[
            { key: 'label', label: 'Compared by' },
            { key: 'groups', label: 'Groups', wrap: true, minw: '12rem' },
            { key: 'trust', label: 'Trust', num: true, wrap: true, minw: '8.5rem' },
            { key: 'qr', label: 'Quantitative reasoning', num: true, wrap: true, minw: '8.5rem' },
