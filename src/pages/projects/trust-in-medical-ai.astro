---
import Base from '../../layouts/Base.astro';
import ForestPlot from '../../components/ForestPlot.astro';
import EffectDots from '../../components/EffectDots.astro';
import RankDots from '../../components/RankDots.astro';
import OutcomePairs from '../../components/OutcomePairs.astro';
import Study1Live from '../../components/Study1Live.astro';
import PowerCurve from '../../components/PowerCurve.astro';
import MainFindings from '../../components/MainFindings.astro';
import Glossary from '../../components/Glossary.astro';
import s2 from '../../data/trust-in-medical-ai/study2-full.json';
import ChapterIntro from '../../components/ChapterIntro.astro';
import Placeholder from '../../components/Placeholder.astro';
import BayesPlot from '../../components/BayesPlot.astro';
import { times } from '../../utils/bayes';
import BayesGuide from '../../components/BayesGuide.astro';
import FigureMap from '../../components/FigureMap.astro';
import bayes from '../../data/trust-in-medical-ai/bayes.json';
import data from '../../data/trust-in-medical-ai/trust-by-domain.json';
import effects from '../../data/trust-in-medical-ai/effects-by-study.json';
import ranked from '../../data/trust-in-medical-ai/trust-by-recommender.json';
import study1 from '../../data/trust-in-medical-ai/study1-tests.json';
import outcomes from '../../data/trust-in-medical-ai/study1-outcomes.json';
import meta from '../../data/trust-in-medical-ai/meta.json';
import { href } from '../../utils/url';
const o = outcomes.outcomes;
const stretch = s2.tests.find((t) => t.id === 'prevent_injury_stretching')!;
const strep = s2.tests.find((t) => t.id === 'diagnose_strep_throat')!;
const findings = [
  {
    head: 'People trust a doctor more than an AI, for every kind of decision',
    body: [
      `In Study 2, ${s2.sample.n} adults said how much they would trust a doctor, and how much they would trust a medical AI, for twelve decisions, from diagnosing strep throat to prescribing insulin. Of the ${s2.overallTest.n} people who answered every question, ${s2.overallTest.higher} trusted the doctor more. Only ${s2.overallTest.lower} trusted the AI more.`,
      `Take strep throat. People rated their trust in a doctor at ${strep.meanA.toFixed(1)} out of 10 and in an AI at ${strep.meanB.toFixed(1)}. Even for something as everyday as advice to stretch, the doctor won, ${stretch.meanA.toFixed(1)} to ${stretch.meanB.toFixed(1)}.`,
    ],
    visual: { type: 'people', total: s2.overallTest.n, count: s2.overallTest.higher, label: 'trusted the doctor more than the AI', caption: 'Each dot is one person in Study 2. Blue dots trusted the doctor more.' },
  },
  {
    head: 'Doctors win, but the AI is not a zero',
    body: [
      `The AI still earned a middling amount of trust, about ${s2.overallTest.meanB.toFixed(0)} out of 10 across the twelve decisions, against about ${s2.overallTest.meanA.toFixed(0)} for the doctor.`,
      'So the question is how much, not whether. People weigh an AI\'s advice with more skepticism than a doctor\'s, even when the advice is the same.',
    ],
    visual: { type: 'pairs', aName: 'Doctor', bName: 'AI', rows: [{ label: 'Average trust, twelve decisions (0 to 10)', a: s2.overallTest.meanA, b: s2.overallTest.meanB, max: 10 }], caption: 'Study 2, 106 adults.' },
  },
  {
    head: 'People see a doctor as better at both kinds of thinking',
    body: [
      'Good doctors combine numbers with judgment. They read the lab result, and they also sense when something does not add up. In Study 1, 188 adults rated doctors higher than an AI on both.',
      'People who rated a recommender higher on either skill also trusted it more. In Study 2, these ratings explained about half of the doctor\'s edge. The other half is still unexplained.',
    ],
    visual: { type: 'pairs', aName: 'Doctor', bName: 'AI', rows: [
      { label: 'Can use quantitative reasoning', a: o[1].doctor.mean, b: o[1].ai.mean, max: 10 },
      { label: 'Can use intuition', a: o[2].doctor.mean, b: o[2].ai.mean, max: 10 },
    ], caption: 'Study 1, ratings from 0 to 10.' },
  },
  {
    head: 'Making an AI seem more human narrowed the gap, but only when people could compare',
    body: [
      'I gave the same health advice to everyone. In one version it came from a doctor named Jordan. In another it came from an AI called JO76N. In a third it came from an AI also named Jordan, who spoke like a person.',
      'People who saw only one version did not trust the humanlike AI more. People who saw all three did, and it closed most of the distance to the doctor. Being able to compare changed how the AI was judged.',
    ],
    visual: { type: 'pairs', aName: 'Seen alone (Study 3)', bName: 'Seen side by side (Study 5)', rows: [{ label: 'How much more people trusted the humanlike AI than the standard AI', a: 0.07, b: 0.46, max: 1 }], caption: 'Effect size (d): 0 is no difference, 0.5 is a medium one. Studies 3 to 5 included about 1,800 people.' },
  },
  {
    head: 'Trust did not change what people did',
    body: [
      'In the last study, 560 people were recruited for 15 days of sleep logging, and 455 completed it. A doctor or an AI told them to sleep 7.5 to 9 hours and to spend less time on their phone in bed.',
      'I found no difference in how closely people followed the advice, whoever gave it. Saying you trust a doctor more does not mean you act on the doctor\'s advice more. Still, the advice was low stakes, so this may not hold when the cost of acting is higher.',
    ],
    visual: { type: 'stat', value: 'No gap', label: 'in following the advice from a doctor or an AI', caption: 'Study 6, 15 days.' },
  },
];

const bayesRows = bayes.rows.filter((r) => ['Study 3', 'Study 4', 'Study 5', 'Study 6'].includes(r.study)).map((r) => ({ ...r, group: `${r.study}: ${r.group}` }));
const bf = (id: string) => bayes.rows.find((r) => r.id === id)!;
const wait = 'Waiting on the data';
const figureMap36 = [
  { diss: 'Figures 13, 14, 17, 22, 28, 29', what: 'Vignette images, conceptual models and the sleep infographic', here: 'In the dissertation and on OSF', note: 'Materials, not data; not redrawn here' },
  { diss: 'Figures 15 and 16', what: 'Study 3: mean trust and belief by recommender, with 95% intervals', here: wait, note: 'The effect sizes are in the chart further up' },
  { diss: 'Figures 18 to 21', what: 'Study 4: trust and belief, between people and side by side', here: wait },
  { diss: 'Figures 23 and 24', what: 'Study 5: trust and belief by recommender, with and without a voice', here: wait },
  { diss: 'Figures 25 to 27', what: 'Study 5: mediation through mind perception', here: wait, note: 'Estimates are in the dissertation text' },
  { diss: 'Figures 30 to 33', what: 'Study 6: adherence to the sleep and phone-in-bed advice across days, and mediation', here: wait },
  { diss: 'Tables 14 to 19', what: 'Studies 3 and 4: regression and mixed-model tables', here: wait },
  { diss: 'Tables 20 to 24', what: 'Studies 5 and 6: ANOVA, mixed-model and adherence tables', here: wait },
  { diss: 'All t tests in the text', what: 'Planned and follow-up comparisons in Studies 3 to 6', here: 'Bayes factors below', href: '#bayes-36', note: 'Computed from the reported t, d and degrees of freedom' },
];
---

<Base
  title="Trust in medical AI"
  description="Six preregistered studies on why people trust a doctor's advice more than an AI's, from my Georgetown dissertation."
>
  <div class="wrap">
    <header class="page-head">
      <p class="back small"><a href={href('/projects/')}>All projects</a></p>
      <h1>Trust in medical AI</h1>
      <p class="lede">
        My dissertation at Georgetown University, completed in 2024. Six preregistered studies, with more than 3,000
        participants recruited, on why people trust a doctor's advice more than an AI's.
      </p>
    </header>

    <section class="section" id="main-findings" aria-labelledby="mf-title">
      <h2 id="mf-title">Main findings</h2>
      <p class="lead2">
        I wear a ring that tracks my sleep and tells me how to improve it. Most days I ignore it. When a doctor at urgent care tells me the same thing,
        I listen. I wanted to know why, and whether it can change. So I ran six experiments with more than 3,000 people. Here is what they showed.
      </p>
      <MainFindings findings={findings} />
      <p class="lead2 closing">
        <strong>What this means.</strong> The gap in trust is large and steady, and it tracks how capable people think the advice-giver is. A small nudge can
        move it: describing an AI in humanlike terms was enough. That cuts both ways. It can help a good AI get a fair hearing, and it can make a weak one look
        better than it is. And because trust did not change behavior in my one test, I would measure what people do, not only what they say.
      </p>
    </section>

    <div class="deep">
      <h2 id="deep-dive">Deep dive: the evidence, study by study</h2>
      <p>
        Everything below shows the data behind these findings. Each chart has hover details, and the full analyses are on separate pages for
        <a href={href('/projects/trust-in-medical-ai/study-1/')}>Study 1</a> and <a href={href('/projects/trust-in-medical-ai/study-2/')}>Study 2</a>.
      </p>
      <Glossary />
    </div>

    <div class="prose">
      <section class="section">
        <h2>The question</h2>
        <p>
          Medical AI has shown diagnostic and prescriptive ability that rivals doctors. Yet when a doctor and an AI give
          people the same recommendation, people trust the doctor more. I wanted to know what drives that gap, and
          whether it can be closed.
        </p>
      </section>
    </div>

    <section class="section chart" aria-labelledby="gap-title">
      <h2 id="gap-title">The gap holds across medical domains</h2>
      <p class="sub">
        Study 2 asked 106 adults how much they trusted a doctor and an AI making the same medical judgment. Hover over
        a row or tab to it for the exact statistics.
      </p>
      <ForestPlot
        rows={data.rows}
        xMin={-1}
        xMax={5}
        xLabel="Doctor minus AI, in trust rating points"
        leftLabel="AI trusted more"
        rightLabel="Doctor trusted more"
      />
      <p class="small muted source">
        Source: {meta.source} Study 2, Table 7.
        <a href={meta.publicLinks.study2Preregistration}>Preregistration</a> and
        <a href={meta.publicLinks.study2DataAndAnalysis}>data and analysis</a> are on OSF.
      </p>
    </section>

    <section class="section chart" aria-labelledby="rank-title">
      <h2 id="rank-title">Who people trust, from doctors down to chatbots</h2>
      <p class="sub">
        In Study 1, {ranked.rows[0].n} people rated how much they would trust each of eleven recommenders for medical decisions.
        Doctors and nurses sit at the top. Every AI sits below the human experts, near the level people gave a layperson. A doctor
        who uses AI lands in between.
      </p>
      <RankDots rows={ranked.rows} scale={ranked.scale} xLabel="Trust, from 0 (not at all) to 10 (completely)" />
      <p class="small muted source">Source: {ranked.source} Hover over a row or tab to it for the details.</p>
    </section>

    <section class="section chart" aria-labelledby="human-title">
      <h2 id="human-title">Making the AI humanlike helped only when people compared</h2>
      <p class="sub">
        I described one AI in a more humanlike way, with a name and human verbs (plus a voice from Study 4 on), and gave the same advice in
        every condition. Each row is a study. When each person saw one recommender, the humanlike AI did not gain
        significantly. When the same people judged all three side by side, it did.
      </p>
      <EffectDots rows={effects.rows} xMax={1} xLabel="Cohen's d versus the standard AI" />
      <p class="small muted source">
        Source: {effects.source} Hover over a row or tab to it for the test statistics.
      </p>
    </section>

    <div class="prose">
      <section class="section">
        <h2>How I measured it</h2>
        <p>
          I collected trust ratings and a behavioral measure called weight on advice, which records how far people move
          their own judgment toward a recommendation. Every study was preregistered.
        </p>
      </section>

      <section class="section">
        <h2>What this means for product teams</h2>
        <p>
          If a health AI is trusted less than a clinician, the gap persisted across every medical domain I tested, so
          adjusting the content alone may not close it. Test how people perceive the decision-maker, and measure what
          they do, not only what they say they trust.
        </p>
      </section>
    </div>

    <section class="section chart" aria-labelledby="pairs-title">
      <h2 id="pairs-title">Doctors beat AI on trust, intuition and quantitative reasoning</h2>
      <p class="sub">
        Study 1 asked {outcomes.outcomes[0].n} people to rate a doctor and an AI on three things: how much they trust each to make
        health recommendations, and how capable each is of using quantitative reasoning and of using intuition. The doctor
        came out ahead on all three. The largest gap is trust (d = {outcomes.outcomes[0].d.toFixed(2)}).
      </p>
      <OutcomePairs outcomes={outcomes.outcomes} scale={outcomes.scale} xLabel="Rating, from 0 to 10" />
      <p class="small muted source">
        Source: {outcomes.source} The statistics match the dissertation (Hypotheses 6 and 7 and the exploratory test).
        Hover over a row or tab to it for the details.
      </p>
    </section>

    <ChapterIntro />

    <section class="section chart" id="study1-data" aria-labelledby="data-title">
      <h2 id="data-title">Filter the data and rerun the results</h2>
      <p class="sub">
        The cleaned Study 1 data and the analysis code are public, as part of my commitment to open science. Choose who to
        include and the chart and tests below update on the spot, using the same tests as the paper. With no filters, the
        table reproduces the dissertation. Nothing here identifies a participant: I removed IP addresses, locations,
        timestamps and IDs, left out sensitive demographics, grouped the rest into broad categories, and shuffled the
        participant numbers.
      </p>
      <Study1Live rec={ranked.rows} />
      <p class="small muted source">
        Paired t tests on the released data. Decision items are on a 0 to 100 scale, recommender ratings on 0 to 10. The
        paper's hypothesis numbers are used; the exploratory test (E) was not preregistered. How the file was cleaned is in
        <a href="https://github.com/mrleitao/Psycho_Robot#study-1-data-release">the project README</a>. The data, code,
        <a href={href('/docs/study1-preregistration.pdf')}>preregistration</a> and
        <a href={href('/code/study1-original-analysis.Rmd')}>original analysis notebook</a> are all linked from
        <a href={href('/projects/trust-in-medical-ai/study-1/#files')}>the full Study 1 page</a>.
      </p>
    </section>

    <section class="section chart" aria-labelledby="full-title">
      <h2 id="full-title">Every table and figure from Study 1</h2>
      <p class="sub">
        Descriptives, reliability, factor analysis, all eight tests, the eleven-recommender maps and the mixed models,
        rebuilt from the public data. Each figure has hover details and a table view.
      </p>
      <p><a class="go" href={href('/projects/trust-in-medical-ai/study-1/')}>Open Study 1</a> · <a href={href('/projects/trust-in-medical-ai/study-1/full/')}>every table and figure</a> · <a href={href('/projects/trust-in-medical-ai/study-1/humans-vs-ai/')}>humans versus AI</a> · <a href={href('/projects/trust-in-medical-ai/study-1/dig-deeper/')}>dig deeper</a></p>
    </section>

    <section class="section chart" id="study2-data" aria-labelledby="full2-title">
      <h2 id="full2-title">Every table and figure from Study 2</h2>
      <p class="sub">
        Study 2's 106 people rated trust in a doctor and in an AI for twelve decisions, and the two on warmth, competence, intuition and
        quantitative reasoning. The page rebuilds the tests, the mixed models and the mediation analysis from the public file, with hover details and
        table views. The de-identified data, codebook, R script, original notebook and
        <a href={href('/docs/study2-preregistration.pdf')}>preregistration</a> are linked from
        <a href={href('/projects/trust-in-medical-ai/study-2/#files')}>the Study 2 page</a>; the study is also on OSF
        (<a href={meta.publicLinks.study2Preregistration}>preregistration</a>, <a href={meta.publicLinks.study2DataAndAnalysis}>data and analysis</a>).
      </p>
      <p><a class="go" href={href('/projects/trust-in-medical-ai/study-2/')}>Open Study 2</a> · <a href={href('/projects/trust-in-medical-ai/study-2/full/')}>every table and figure</a> · <a href={href('/projects/trust-in-medical-ai/study-2/dig-deeper/')}>dig deeper</a></p>
    </section>

    <section class="section chart wide" id="dig-deeper" aria-labelledby="dig-title">
      <div class="deep inner">
        <h2 id="dig-title">Dig deeper: Studies 3 to 6</h2>
        <p>
          Studies 1 and 2 have their own pages, built from the released data. Studies 3 to 6 do not have raw data here yet, so this section does what the numbers in the
          dissertation allow: it lists where each figure will go, and it runs Bayes factors on every comparison the dissertation reports.
        </p>
      </div>
      <h3 class="fig-title">Where each dissertation figure and table stands</h3>
      <FigureMap rows={figureMap36} />

      <h3 class="fig-title" id="bayes-36">When the test found no difference</h3>
      <BayesGuide />
      <BayesPlot rows={bayesRows} />
      <div class="prose">
        <p>
          <strong>Humanizing the AI, seen alone, did not help.</strong> In Study 3 the data are {times(bf('S3-trust-hum-std').bf01)} under no difference between the humanlike and the standard AI for trust
          and {times(bf('S3-belief-hum-std').bf01)} for belief, moderate evidence. Study 4 adds a voice and the picture softens to {Math.round(bf('S4-trust-hum-std').bf01*10)/10} and {Math.round(bf('S4-belief-hum-std').bf01*10)/10} times,
          which leans toward no effect without settling it.
        </p>
        <p>
          <strong>The two voice effects are suggestive, not firm.</strong> In Study 5 a voice raised trust in the humanlike AI (p = .017) and lowered it for the standard AI (p = .036), but the data are only
          {times(bf('S5-hum-voice').bf10)} under a difference for the first, and about equally likely either way for the second. That is close to a coin flip. A doctor's recommendation was not
          changed by a voice (the data are {times(bf('S5-doc-voice').bf01)} under no change), and voice overall made no difference ({times(bf('S5-voice-main').bf01)} under none).
        </p>
        <p>
          <strong>The humanlike AI and the doctor are hard to separate between people, and not side by side.</strong> Seen alone (Studies 3 and 4), the evidence about humanlike AI versus doctor is
          anecdotal either way. Seen side by side in Study 5, people rated the humanlike AI above the doctor, and the data are {times(bf('S5-hum-doc').bf10)} under a difference, strong evidence.
        </p>
        <p>
          <strong>The recommender did not change what people did.</strong> In Study 6 the change in sleep and in phone use after the advice was the same for the AI and the doctor. The data are {times(bf('S6-sleep-int').bf01)} under no difference for sleep
          and {times(bf('S6-dib-int').bf01)} for phone use in bed, moderate evidence. This is a stronger statement than the dissertation could make from the p values alone.
          The mediation results ({times(bf('S6-sleep-med').bf01)} and {times(bf('S6-dib-med').bf01)}, under no indirect effect) come from a bell-shaped approximation for indirect effects, so treat them as a guide.
        </p>
        <p class="small muted">
          Bayes factors in this section come from the reported statistics, not from the raw data. For two-group tests, the effective sample size is recovered as (t / d)², and coefficients use the estimate and
          the width of the reported interval. The dissertation prints some values with rounding, so the Bayes factors are accurate to roughly the first digit.
        </p>
      </div>
    </section>

    <section class="section chart" id="power" aria-labelledby="power-title">
      <h2 id="power-title">How many people does a finding need?</h2>
      <p class="sub">
        Power is the chance a study detects a real effect of a given size. Slide the effect size or pick one of the
        Study 1 results to see how many people it takes, and how well Study 1's 188 people could
        detect it. This is the same reason the filters above stop at 10 people: small groups can only detect large
        differences, so a real but modest difference often looks like nothing.
      </p>
      <PowerCurve
        presets={study1.tests.filter((t) => t.d > 0).map((t) => ({ id: t.id, label: t.id, d: t.d }))}
        studyN={188}
      />
      <p class="small muted source">
        Power for a two-sided paired t test, the test used for every comparison in Study 1, computed in your browser
        from the noncentral t distribution and checked against scipy. This is a sensitivity view: it shows what size of
        effect the study could detect, not how likely the results already seen were. The H labels use the dissertation's
        numbering.
      </p>
    </section>

    <section class="section slots" aria-labelledby="more-title">
      <h2 id="more-title">More charts for this page</h2>
      <div class="slot-grid">
        <Placeholder
          title="Condition means for Studies 3 to 5"
          provide={[
            'Mean trust and 95% confidence interval for each condition in each study, if you want means instead of effect sizes',
            'The figure from the dissertation, if you want the chart to match it',
          ]}
        />
        <Placeholder
          title="Adherence over 15 days in Study 6"
          provide={[
            'Daily adherence by condition, as a summary table or a de-identified file',
            'Confirmation that the consent form allows public release',
          ]}
        />
      </div>
    </section>
  </div>
</Base>

<style>
  .back {
    margin-bottom: 1rem;
  }

  .chart {
    max-width: 680px;
  }
  .chart.wide { max-width: 860px; }
  .deep.inner { margin-top: 0; }
  .fig-title { margin-top: 2.5rem; font-size: 1.15rem; }

  .sub {
    color: var(--muted);
    font-size: 1rem;
    margin: 0.75rem 0 1.75rem;
  }

  .source {
    margin-top: 1.25rem;
  }

  .go {
    font-family: var(--display);
    font-weight: 600;
  }

  .findings {
    margin: 1rem 0 0;
    padding-left: 1.2rem;
  }

  .findings li {
    margin-bottom: 0.9rem;
  }

  .slot-grid {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  @media (min-width: 760px) {
    .slot-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .lead2 { max-width: 62ch; font-size: 1.1rem; }
  .closing { margin-top: 2rem; }
  .deep { margin-top: 4rem; padding-top: 2rem; border-top: 5px solid; border-image: var(--five) 1; }
  .deep h2 { margin-bottom: 0.5rem; }
  .deep p { max-width: 62ch; color: var(--muted); }
</style>
