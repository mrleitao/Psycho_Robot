---
import Base from '../layouts/Base.astro';
import { href } from '../utils/url';
---

<Base title="Contact" description="How to reach Matthew Leitao about behavioral science, decision science and human-AI research roles.">
  <div class="wrap">
    <header class="page-head">
      <h1>Contact</h1>
      <p class="lede">
        I'm looking for roles in behavioral science, decision science, human-AI interaction research and research
        program management.
      </p>
    </header>

    <section class="section ways">
      <dl>
        <div>
          <dt>Email</dt>
          <dd><a href="mailto:mrleitao@me.com">mrleitao@me.com</a></dd>
        </div>
        <div>
          <dt>LinkedIn</dt>
          <dd><a href="https://www.linkedin.com/in/mrleitao/">linkedin.com/in/mrleitao</a></dd>
        </div>
        <div>
          <dt>Code</dt>
          <dd><a href="https://github.com/mrleitao">github.com/mrleitao</a></dd>
        </div>
        <div>
          <dt>CV</dt>
          <dd><a href={href('/cv/')}>Read the short version</a></dd>
        </div>
      </dl>
    </section>
  </div>
</Base>

<style>
  .ways dl {
    margin: 0;
    display: grid;
    gap: 1.25rem;
  }

  dt {
    font-family: var(--display);
    color: var(--muted);
    font-size: 0.95rem;
  }

  dd {
    margin: 0.1rem 0 0;
    font-size: 1.35rem;
  }
</style>
