---
import Base from '../layouts/Base.astro';
import DeskMessagesBand from '../components/DeskMessagesBand.astro';
import { href } from '../utils/url';
---

<Base title="Contact" description="How to reach Matthew Leitao about behavioral science, decision science and human-AI research roles.">
  <section class="ct-hero">
    <DeskMessagesBand />
    <div class="wrap">
      <header class="page-head">
        <div class="head-copy">
          <h1>Contact</h1>
          <p class="lede">
            I'm looking for roles in behavioral science, decision science, human-AI interaction research and research
            program management.
          </p>
        </div>
      </header>
    </div>
  </section>
  <div class="wrap">

    <section class="section ways">
      <dl>
        <div>
          <dt>Email</dt>
          <dd><a href="mailto:mrleitao@me.com">mrleitao@me.com</a></dd>
        </div>
        <div>
          <dt>LinkedIn</dt>
          <dd><a href="https://www.linkedin.com/in/mrleitao/">linkedin.com/in/mrleitao</a></dd>
        </div>
        <div>
          <dt>Code</dt>
          <dd><a href="https://github.com/mrleitao">github.com/mrleitao</a></dd>
        </div>
        <div>
          <dt>CV/Resume</dt>
          <dd><a href={href('/cv/')}>Read the CV/Resume</a></dd>
        </div>
      </dl>
    </section>
  </div>
</Base>

<style>
  .ct-hero { position: relative; isolation: isolate; overflow: hidden; min-height: clamp(400px, 38vw, 440px); padding-bottom: 64px; }
  .ways { margin-top: 24px; }
  .head-copy { position: relative; isolation: isolate; max-width: 34rem; }
  .head-copy::before { content: ''; position: absolute; inset: -40px -40px; z-index: -1; background: radial-gradient(ellipse at center, var(--paper) 40%, transparent 74%); opacity: 0.9; pointer-events: none; }
  @media (max-width: 700px) { .ct-hero { min-height: 0; padding-bottom: 510px; } }
  .ways dl {
    margin: 0;
    display: grid;
    gap: 1.25rem;
  }

  dt {
    font-family: var(--display);
    color: var(--muted);
    font-size: 0.95rem;
  }

  dd {
    margin: 0.1rem 0 0;
    font-size: 1.35rem;
  }
</style>
