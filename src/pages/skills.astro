---
import Base from '../layouts/Base.astro';
import EvidenceMatrix from '../components/EvidenceMatrix.astro';
import Analyses from '../components/Analyses.astro';
import skills from '../data/skills.json';
import fields from '../data/fields.json';
---

<Base
  title="Skills"
  description="Technical and working-style skills, each with the evidence behind it and a plain label: have, or developing."
>
  <div class="wrap">
    <header class="page-head">
      <h1>Skills, with the evidence</h1>
      <p class="lede">
        Each skill is something I have or something I am still developing, with the evidence beside it. Hover over or tap a skill name to see what else it is called and what it covers.
      </p>
    </header>

    <div class="body">
      <EvidenceMatrix skills={skills} fields={fields}>
        <Analyses />
      </EvidenceMatrix>
    </div>
  </div>
</Base>

<style>
  .body {
    margin-top: clamp(32px, 5vw, 56px);
  }
</style>
