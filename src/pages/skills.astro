---
import Base from '../layouts/Base.astro';
import EvidenceMatrix from '../components/EvidenceMatrix.astro';
import skills from '../data/skills.json';
---

<Base
  title="Skills"
  description="My research, data, teaching and leadership skills, each with the evidence behind it and a plain label: have, or developing."
>
  <div class="wrap">
    <header class="page-head">
      <h1>Skills, with the evidence</h1>
      <p class="lede">
        Each skill is something I have or something I am still developing, with the evidence beside it. Hover over a skill name to see the words employers use for the same work.
      </p>
    </header>

    <div class="body">
      <EvidenceMatrix skills={skills} />
    </div>
  </div>
</Base>

<style>
  .body {
    margin-top: clamp(32px, 5vw, 56px);
  }
</style>
