---
import { execSync } from 'node:child_process';
import Base from '../layouts/Base.astro';
import { href } from '../utils/url';
import cv from '../data/cv/cv.json';
import pubs from '../data/cv/publications.json';
import resume from '../data/cv/resume.json';

// "Updated" comes from the last commit that touched the CV data, so it moves on its own.
// If git history is not available at build time, fall back to the date written in cv.json.
let updated = cv.updated;
try {
  const out = execSync('git log -1 --format=%cs -- src/data/cv', { encoding: 'utf8' }).trim();
  if (out) updated = out;
} catch {
  /* keep the date in cv.json */
}
const fmtDate = (iso: string) =>
  new Date(iso + 'T12:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const byId = Object.fromEntries(cv.sections.map((s) => [s.id, s]));
const pubCount = pubs.groups.reduce((n, g) => n + g.items.length, 0);

// Page order. Publications are their own block because they come from publications.json.
const order = [
  'positions',
  'education',
  'publications',
  'grants',
  'honors',
  'research-experience',
  'professional-experience',
  'teaching',
  'mentorship',
  'invited',
  'talks',
  'posters',
  'intramural',
  'skills',
  'workshops-attended',
  'workshops-led',
  'service',
  'memberships',
];

const sections = order.map((id) =>
  id === 'publications'
    ? { id, title: 'Publications', kind: 'publications', count: pubCount }
    : { ...byId[id], count: (byId[id].items ?? byId[id].groups ?? []).length }
);
---

<Base title="CV/Resume" description="Matthew Leitao's CV and resume: positions, education, publications, teaching, presentations and skills, kept up to date.">
  <div class="wrap">
    <header class="page-head">
      <h1>CV/Resume</h1>
      <p class="offer">Data-driven decisions, backed by a thorough understanding of behavior.</p>
      <p class="lede">
        The short version first, then the full academic record. It is kept up to date, and each new paper, talk or role
        shows here as soon as I add it.
      </p>
      <p class="meta small muted">
        Updated {fmtDate(updated)}.
        <a class="print" href={href('/Matthew_Leitao_Resume.pdf')}>Download resume (PDF)</a>
        <a class="print" href={href('/Matthew_Leitao_CV.pdf')}>Download full CV (PDF)</a>
      </p>
    </header>

    <div class="layout">
      <nav class="index" aria-label="CV/Resume sections">
        <ul>
          <li><a href="#resume">Resume</a></li>
          <li><a href="#cv-full">Full CV</a></li>
          {sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
          <li><a href="#changes">Recent changes</a></li>
        </ul>
      </nav>

      <div class="body">
        <section id="resume" class="block" aria-labelledby="resume-h">
          <h2 id="resume-h">Resume</h2>
          <p class="summary">{resume.summary}</p>
          <ol class="rows timeline">
            {
              resume.experience.map((x) => (
                <li>
                  <p class="when">{x.when}</p>
                  <div>
                    <h3>{x.role}</h3>
                    <p class="org">{x.org}</p>
                    <ul class="lines">
                      {x.bullets.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                  </div>
                </li>
              ))
            }
          </ol>
          <p class="small muted note">
            This is the same text as the resume PDF. The full CV below adds every paper, talk, poster, workshop and service role.
          </p>
        </section>

        <h2 id="cv-full" class="part">Full CV</h2>

        {
          sections.map((s) => (
            <section id={s.id} class="block" aria-labelledby={`${s.id}-h`}>
              <h2 id={`${s.id}-h`}>{s.title}</h2>
              {s.note && <p class="small muted note">{s.note}</p>}

              {s.kind === 'publications' && (
                <div class="pubs">
                  {pubs.groups.map((g) => (
                    <div class="pub-group">
                      <h3>{g.heading}</h3>
                      <ul class="rows">
                        {g.items.map((item) => (
                          <li>
                            <p class="cite" set:html={item.html} />
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              )}

              {s.kind === 'entries' && (
                <details class="fold" open={!s.collapsed}>
                  <summary>{s.count} entries</summary>
                  <ul class="rows entries">
                    {s.items.map((e) => (
                      <li>
                        <p class="when">{e.when}</p>
                        <div>
                          <p class="entry-title">{e.title}</p>
                          {e.org && <p class="org">{e.org}</p>}
                          {e.lines && (
                            <ul class="lines">
                              {e.lines.map((l) => (
                                <li>{l}</li>
                              ))}
                            </ul>
                          )}
                        </div>
                      </li>
                    ))}
                  </ul>
                </details>
              )}

              {s.kind === 'html' && (
                <details class="fold" open={!s.collapsed}>
                  <summary>{s.count} entries</summary>
                  <ul class="rows">
                    {s.items.map((item) => (
                      <li>
                        <p class="cite" set:html={item.html} />
                      </li>
                    ))}
                  </ul>
                </details>
              )}

              {s.kind === 'groups' && (
                <details class="fold" open={!s.collapsed}>
                  <summary>{s.count} groups</summary>
                  <div class="groups">
                    {s.groups.map((g) => (
                      <div class="group">
                        <h3>{g.heading}</h3>
                        {g.text && <p>{g.text}</p>}
                        {g.items && (
                          <ul class="rows entries">
                            {g.items.map((i) => (
                              <li>
                                <p class="when">{i.when}</p>
                                <p class="entry-title">{i.text}</p>
                              </li>
                            ))}
                          </ul>
                        )}
                      </div>
                    ))}
                  </div>
                </details>
              )}
            </section>
          ))
        }

        <section id="changes" class="block" aria-labelledby="changes-h">
          <h2 id="changes-h">Recent changes</h2>
          <ul class="changes">
            {
              cv.changes.map((c) => (
                <li>
                  <span class="when">{fmtDate(c.date)}</span>
                  <span>{c.text}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="block" id="downloads">
          <h2>Download</h2>
          <p>
            <a href={href('/Matthew_Leitao_Resume.pdf')}>Resume (2 pages, PDF)</a> for roles outside academia, and
            <a href={href('/Matthew_Leitao_CV.pdf')}>full CV (PDF)</a> with every paper, talk and poster. Both are current as of {fmtDate(updated)}.
          </p>
        </section>
      </div>
    </div>
  </div>
</Base>

<script>
  
  // Open every folded list before printing so the printout is the whole CV.
  const folds = () => document.querySelectorAll<HTMLDetailsElement>('details.fold');
  let wasClosed: HTMLDetailsElement[] = [];
  window.addEventListener('beforeprint', () => {
    wasClosed = [...folds()].filter((d) => !d.open);
    wasClosed.forEach((d) => (d.open = true));
  });
  window.addEventListener('afterprint', () => {
    wasClosed.forEach((d) => (d.open = false));
    wasClosed = [];
  });

  // Mark the section being read in the index.
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('.index a').forEach((a) => links.set(a.hash.slice(1), a));
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            links.forEach((a) => a.removeAttribute('aria-current'));
            links.get(e.target.id)?.setAttribute('aria-current', 'true');
          }
        });
      },
      { rootMargin: '-15% 0px -75% 0px' }
    );
    document.querySelectorAll('.block[id]').forEach((el) => io.observe(el));
  }
</script>

<style>
  .offer {
    margin: 0.6rem 0 0;
    max-width: 34rem;
    font-family: var(--display);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink);
  }

  .summary {
    max-width: 62ch;
    margin: 0 0 1.5rem;
  }

  .part {
    margin: 3rem 0 0;
    padding-top: 1rem;
    border-top: 3px solid var(--coral);
    font-size: 1.6rem;
  }

  .meta {
    margin-top: 0.75rem;
  }

  .print {
    margin-left: 0.75rem;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--doctor);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .layout {
    display: grid;
    gap: 2rem;
    margin-top: clamp(24px, 4vw, 40px);
  }

  @media (min-width: 960px) {
    .layout {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: 3.5rem;
    }
  }

  /* On a phone the index is just a wrapped line of links; on a wide screen it stays in view. */
  .index ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    font-family: var(--display);
    font-size: 0.95rem;
  }

  @media (min-width: 960px) {
    .index {
      position: sticky;
      top: 1.5rem;
      align-self: start;
      max-height: calc(100vh - 3rem);
      overflow: auto;
    }

    .index ul {
      display: grid;
      gap: 0.3rem;
      font-size: 0.92rem;
    }
  }

  .index a {
    color: var(--muted);
    text-decoration: none;
  }

  .index a:hover,
  .index a[aria-current='true'] {
    color: var(--ink);
  }

  .index a[aria-current='true'] {
    text-decoration: underline;
    text-decoration-color: var(--doctor);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .body {
    max-width: 760px;
  }

  .block {
    scroll-margin-top: 1.5rem;
    margin-bottom: clamp(40px, 6vw, 64px);
  }

  .block > h2 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .note {
    margin: 0 0 0.5rem;
  }

  .timeline {
    list-style: none;
  }

  .timeline > li,
  .entries > li {
    display: grid;
    gap: 0.2rem 2rem;
  }

  @media (min-width: 640px) {
    .timeline > li {
      grid-template-columns: 8.5rem minmax(0, 1fr);
    }

    .entries > li {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }

  .when {
    margin: 0;
    font-family: var(--display);
    font-weight: 500;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    font-size: 0.95rem;
  }

  .timeline h3 {
    font-size: 1.2rem;
  }

  .org {
    margin: 0.15rem 0 0.35rem;
    font-family: var(--display);
    color: var(--muted);
    font-size: 0.95rem;
  }

  .timeline p:last-child {
    margin: 0;
  }

  .entry-title {
    margin: 0;
    font-family: var(--display);
    font-weight: 600;
  }

  .lines {
    margin: 0.35rem 0 0;
    padding-left: 1.1rem;
    font-size: 0.98rem;
  }

  .lines li {
    margin-bottom: 0.2rem;
  }

  .cite {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
    padding-left: 1.5rem;
    text-indent: -1.5rem;
  }

  .pub-group {
    margin-top: 1.5rem;
  }

  .pub-group h3 {
    font-size: 1.05rem;
    margin-bottom: 0.15rem;
  }

  .fold > summary {
    cursor: pointer;
    color: var(--muted);
    font-family: var(--display);
    font-size: 0.92rem;
    margin-bottom: 0.25rem;
  }

  .fold[open] > summary {
    display: none;
  }

  .fold:not([open]) > summary::after {
    content: ' (select to show)';
  }

  .groups {
    display: grid;
    gap: 1rem;
  }

  .group h3 {
    font-size: 1rem;
    margin: 0 0 0.15rem;
  }

  .group p {
    margin: 0;
    font-size: 1rem;
  }

  .changes {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .changes li {
    display: grid;
    gap: 0.1rem 1.5rem;
    font-size: 0.98rem;
  }

  @media (min-width: 640px) {
    .changes li {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }

  @media print {
    .index,
    .print,
    .changes,
    #changes {
      display: none !important;
    }

    .layout {
      display: block;
    }

    .fold > summary {
      display: none !important;
    }
  }
</style>
