---
import Base from '../layouts/Base.astro';
import pubs from '../data/cv/publications.json';
import { href } from '../utils/url';

// Papers live in src/data/cv/publications.json, shared with the CV page.
const groups = pubs.groups.filter((g) => !g.cvOnly);
---

<Base
  title="Research"
  description="Ten papers published, accepted or under review on trust in AI, smartphones, wellbeing and clinical research, with my role on each."
>
  <div class="wrap">
    <header class="page-head">
      <h1>Research</h1>
      <p class="lede">
        Ten papers: seven published, one accepted and two under review. I have also given more than 25 conference
        presentations and chaired the 2024 SPSP session on aversion to and appreciation of AI.
      </p>
    </header>

    {
      groups.map((g) => (
        <section class="section group">
          <h2>{g.heading}</h2>
          <ul class="rows">
            {g.items.map((item) => (
              <li>
                <p class="cite" set:html={item.html} />
                <p class="role small muted">
                  {item.role}
                  {item.page && <> · <a href={href(item.page)}>Results and figures</a></>}
                </p>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section class="section group">
      <h2>Master’s thesis</h2>
      <ul class="rows">
        <li>
          <p class="cite">
            <strong>Leitao, M. R.</strong> (2019). <em>All hail our robot overlords: Obedience to digital authority</em>. Master’s thesis,
            California State University, Northridge.
          </p>
          <p class="role small muted">Sole author · <a href={href('/research/obedience-to-computers/')}>Results and figures</a></p>
        </li>
      </ul>
    </section>
  </div>
</Base>

<style>
  .group {
    margin-top: clamp(40px, 6vw, 72px);
    max-width: 780px;
  }

  .group h2 {
    margin-bottom: 0.75rem;
  }

  .cite {
    margin: 0 0 0.3rem;
    font-size: 1.02rem;
    line-height: 1.55;
    padding-left: 1.5rem;
    text-indent: -1.5rem;
  }

  .role {
    margin: 0;
    font-family: var(--display);
  }
</style>
