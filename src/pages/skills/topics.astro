---
import Base from '../../layouts/Base.astro';
import SkillsHero from '../../components/SkillsHero.astro';
import SkillsNav from '../../components/SkillsNav.astro';
import Topics from '../../components/Topics.astro';
---

<Base title="Topics" description="Topics where I have expertise and topics where I have knowledge.">
  <SkillsHero title="Topics" lede="The subjects I can speak to, from topics I have published and taught to topics I studied in depth." />
  <div class="wrap">
    <SkillsNav current="topics" />
    <div class="body">
      <Topics />
    </div>
  </div>
</Base>

<style>
  .body { margin-top: clamp(24px, 4vw, 40px); }
</style>
