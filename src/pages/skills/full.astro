---
import Base from '../../layouts/Base.astro';
import SkillsNav from '../../components/SkillsNav.astro';
import EvidenceMatrix from '../../components/EvidenceMatrix.astro';
import skills from '../../data/skills.json';
import fields from '../../data/fields.json';
import evidence from '../../data/evidence.json';
---

<Base title="Skills in full" description="Every skill with its level, proof, and evidence, filterable by type, field, area, and year.">
  <div class="wrap">
    <header class="page-head">
      <h1>Every skill and its evidence</h1>
      <p class="lede">Filter by level, type, field, area, or year. Each entry says what I did and where it shows up in my record.</p>
    </header>
    <SkillsNav current="full" />
    <div class="body">
      <EvidenceMatrix skills={skills} fields={fields} evidence={evidence} part="full" />
    </div>
  </div>
</Base>

<style>
  .body { margin-top: clamp(24px, 4vw, 40px); }
</style>
