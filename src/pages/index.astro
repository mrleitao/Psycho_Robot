---
import Base from '../layouts/Base.astro';
import ForestPlot from '../components/ForestPlot.astro';
import data from '../data/trust-in-medical-ai/trust-by-domain.json';
import s1 from '../data/trust-in-medical-ai/study1-points.json';
import { cards } from '../data/research_cards';
import { href } from '../utils/url';

// Hero strip: each dot is one of the 188 adults in Study 1, rating trust from 0 to 10.
const pick = (id: string) => s1.trust.find((t) => t.id === id)!;
const rows = [pick('doctor'), pick('ai_chatbot')].map((t) => ({
  label: t.label === 'Doctor' ? 'A doctor' : 'An AI chatbot',
  mean: t.mean,
  dots: (t.values as (number | null)[])
    .map((v, i) => (v === null || v === undefined ? null : { x: v, y: ((i * 37) % 100) * 0.01, i }))
    .filter((d): d is { x: number; y: number; i: number } => d !== null),
}));

const stats = [
  { n: '13+', l: 'years in behavioral science' },
  { n: '10', l: 'papers published, accepted, or under review' },
  { n: '1,778', l: 'people in my largest pooled analysis' },
  { n: '188', l: 'adults rated trust in the dissertation’s first study' },
];

const flagship = [
  ...cards.filter((c) => ['/projects/trust-in-medical-ai/', '/research/phones-social-connection/', '/research/risk-creep/'].includes(c.slug)),
  { slug: '/projects/phone-sleep/', title: 'Does screen time in bed change how people sleep?', stat: '91', statLabel: 'college students followed for seven days', status: 'Project', role: '', tone: 'sand' as const },
];
const toneVar: Record<string, string> = { coral: 'var(--coral)', peach: 'var(--peach)', sand: 'var(--sand)', mist: 'var(--steel)', deep: 'var(--deep)' };

const asks = [
  { q: 'What do you do?', a: 'Design experiments, model messy human data, lead research teams, and build with AI.' },
  { q: 'Show me.', a: 'Four flagship projects, each with its own numbers and figures you can check.' },
  { q: 'How do you work?', a: 'Register the question, show every data point, report what the data support, nulls included.' },
  { q: 'How do I reach you?', a: 'Write to me. I answer.' },
];
---

<Base description="Matthew Leitao is a behavioral scientist who runs experiments on how people decide whether to trust AI. Real data, with every figure shown.">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="kicker">Matthew Leitao, behavioral scientist</p>
        <h1>I design experiments and turn messy human data into answers.</h1>
        <p class="lede">
          I am a behavioral scientist with a PhD from Georgetown and 13+ years of research. I recently finished a postdoc
          at the National Institutes of Health. I study how people decide whether to trust AI, and I report what the
          data support, including the null results.
        </p>
        <p class="cta">
          <a class="btn primary" href={href('/skills/')}>See my skills</a>
          <a class="btn" href={href('/projects/')}>See my work</a>
          <a class="btn" href={href('/contact/')}>Get in touch</a>
        </p>
      </div>
      <figure class="strip" id="strip" aria-label="Trust ratings from 188 adults: a doctor was trusted more than an AI chatbot">
        <figcaption class="s-title">Would you trust them with your health?</figcaption>
        {rows.map((r, ri) => (
          <div class={`s-row r${ri}`}>
            <div class="s-label">{r.label}</div>
            <div class="s-track" aria-hidden="true">
              {r.dots.map((d) => (
                <span class="d" style={`--x:${d.x * 10};--y:${(d.y * 100).toFixed(0)};--i:${d.i}`}></span>
              ))}
              <span class="mean" style={`--x:${r.mean * 10}`}><b>{r.mean.toFixed(1)}</b></span>
            </div>
          </div>
        ))}
        <div class="s-axis"><span>0 no trust</span><span>10 complete trust</span></div>
        <p class="s-note">From my dissertation: each dot is one adult in Study 1, and the line marks the average.</p>
      </figure>
    </div>
  </section>

  <div class="wrap">
    <ul class="stats" aria-label="At a glance">
      {stats.map((x) => <li><strong>{x.n}</strong><span>{x.l}</span></li>)}
    </ul>
  </div>

  <div class="wrap">
    <section class="section about" aria-labelledby="about-h">
      <h2 id="about-h">About me</h2>
      <div class="about-grid">
        <p>
          I have a PhD in psychology from Georgetown and a master's in public policy. I study how people trust,
          interpret, and make decisions with AI, especially in health. At the National Human Genome Research Institute,
          I studied how people read AI-generated health information, how uncertainty changes trust, and how virtual
          reality can fit into clinical research.
        </p>
        <p>
          I build the study, analyze the data in R, and explain the result in plain words. I have led teams of up to 15
          and managed six concurrent projects. Below is the work, and what I did on each piece.
        </p>
      </div>
    </section>
  </div>

  <section class="band flag" aria-labelledby="flag-h">
    <div class="wrap">
      <h2 id="flag-h">Four projects, and my part in each</h2>
      <p class="band-sub">Each opens to the full analysis, with the numbers behind every figure.</p>
      <ul class="flag-list">
        {flagship.map((c) => (
          <li style={`--c:${toneVar[c.tone]}`}>
            <a href={href(c.slug)}>
              <span class="big">{c.stat}</span>
              <span class="lab">{c.statLabel}</span>
              <strong class="t">{c.title}</strong>
              {c.role && <span class="role">My role: {c.role}</span>}
              <span class="meta">{c.status}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="next"><a href={href('/research/')}>All ten papers</a> · <a href={href('/projects/')}>All projects</a></p>
    </div>
  </section>

  <div class="wrap">
    <section class="section" aria-labelledby="do-title">
      <h2 id="do-title">What I do</h2>
      <ul class="cards">
        <li><span class="bar b1"></span><h3>Design experiments</h3><p>Randomized studies, registered in advance, from the first hypothesis through recruitment, analysis, and write-up.</p></li>
        <li><span class="bar b2"></span><h3>Model messy human data</h3><p>Multilevel, longitudinal, and causal models in R, applied to surveys, daily diaries, and clinical-trial data.</p></li>
        <li><span class="bar b3"></span><h3>Lead research teams</h3><p>I managed five research assistants across six or seven projects at Georgetown, and six projects at NIH.</p></li>
        <li><span class="bar b4"></span><h3>Build with AI</h3><p>I build research tools on LLM APIs, test AI output with blind ratings, and use AI to speed up analysis and code.</p></li>
      </ul>
      <p class="next"><a href={href('/skills/')}>See the work behind each skill</a></p>
    </section>
  </div>

  <section class="band gapband" aria-labelledby="gap-title">
    <div class="wrap">
      <h2 id="gap-title">The gap shows up in every kind of medical decision</h2>
      <p class="band-sub">
        In Study 2 of my dissertation, 106 adults rated how much they trusted a doctor and an AI making the same
        medical judgment. Each dot is the average difference, and the line is its 95% confidence interval. Hover over
        a row for the exact statistics.
      </p>
      <div class="gap-grid">
        <ForestPlot rows={data.rows} xMin={-1} xMax={5} xLabel="Doctor minus AI, in trust rating points" leftLabel="AI trusted more" rightLabel="Doctor trusted more" animate />
        <div>
          <p class="takeaway">
            The gap is large in all five domains, with effect sizes from d = 1.24 to 1.33. It barely moves with the type
            of decision, so the cause is more likely in how people see the decision-maker than in the medical content.
          </p>
          <p class="takeaway">
            Then I checked behavior. Trust did not change what people did: they followed advice from a doctor and an AI
            about equally.
          </p>
          <p class="small muted">
            Source: Leitao (2024), Georgetown University dissertation, Study 2, Table 7.
            <a href={href('/projects/trust-in-medical-ai/')}>Read the full case study</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap">
    <section class="section how" aria-labelledby="how-h">
      <h2 id="how-h">How I work</h2>
      <ol class="steps">
        <li><h3>Register the question</h3><p>I write the hypotheses and the analysis plan before I see the data.</p></li>
        <li><h3>Show every data point</h3><p>Charts show the people, not only the averages, with an interval on every estimate.</p></li>
        <li><h3>Report what the data support</h3><p>Nulls and limits go in the main text. If a result is exploratory, I say so.</p></li>
      </ol>
    </section>
  </div>

  <section class="band contact" aria-labelledby="c-h">
    <div class="wrap">
      <h2 id="c-h">Looking for someone who can show their work?</h2>
      <p class="band-sub">I am open to roles in behavioral science, research, and AI evaluation.</p>
      <p class="cta"><a class="btn primary" href={href('/contact/')}>Get in touch</a><a class="btn" href={href('/cv/')}>Read my CV</a></p>
    </div>
  </section>
</Base>

<script>
  const strip = document.getElementById('strip');
  if (strip && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    strip.classList.add('pre');
    requestAnimationFrame(() => requestAnimationFrame(() => strip.classList.add('go')));
  }
</script>

<style>
  .hero { padding: clamp(32px, 6vw, 72px) 0 clamp(8px, 2vw, 24px); }
  .hero-grid { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 960px) { .hero-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3rem; } }
  .kicker { font-family: var(--display); font-weight: 600; font-size: 1rem; color: var(--deep); margin: 0 0 1rem; }
  :global([data-theme='dark']) .kicker, .kicker { color: var(--muted); }
  .hero h1 { font-size: clamp(2.4rem, 5vw, 4rem); line-height: 1.04; letter-spacing: -0.03em; max-width: 18ch; }
  .hero .lede { margin-top: 1.4rem; max-width: 34rem; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1.8rem 0 0; }
  .btn { font-family: var(--display); font-weight: 600; font-size: 1rem; padding: 0.7rem 1.2rem; border-radius: 8px; border: 2px solid var(--ink); color: var(--ink); text-decoration: none; }
  .btn:hover { color: var(--ink); background: var(--wash); }
  .btn.primary { background: var(--ink); color: var(--paper); }
  .btn.primary:hover { background: var(--deep); border-color: var(--deep); color: #fff; }
  .strip { margin: 0; width: 100%; max-width: 40rem; justify-self: center; font-family: var(--display); }
  .s-title { font-weight: 700; font-size: 1.15rem; margin-bottom: 1rem; }
  .s-row { margin-bottom: 1.1rem; }
  .s-label { font-weight: 600; font-size: 1rem; margin-bottom: 0.3rem; }
  .s-track { position: relative; height: 6.5rem; margin-inline: 7px; border-bottom: 2px solid var(--rule); }
  .d { position: absolute; left: calc(var(--x) * 1%); top: calc(var(--y) * 0.88%); width: 11px; height: 11px; margin: 0 0 0 -5.5px; border-radius: 50%; opacity: 0.5; }
  .r0 .d { background: var(--doctor); } .r1 .d { background: var(--ai); }
  .mean { position: absolute; left: calc(var(--x) * 1%); top: -4px; bottom: -2px; width: 3px; margin-left: -1.5px; background: var(--ink); border-radius: 2px; }
  .mean b { position: absolute; top: -1.3rem; left: 50%; transform: translateX(-50%); font-size: 0.95rem; background: var(--paper); padding: 0 0.3rem; white-space: nowrap; }
  .s-axis { display: flex; justify-content: space-between; font-size: 0.85rem; color: var(--muted); margin: 0.2rem 7px 0; }
  .s-note { margin: 0.8rem 0 0; font-size: 0.9rem; color: var(--muted); }
  .strip.pre .d { left: 50%; opacity: 0; }
  .strip.pre.go .d { left: calc(var(--x) * 1%); opacity: 0.5; transition: left 0.9s cubic-bezier(.2,.7,.2,1), opacity 0.4s; transition-delay: calc(var(--i) * 4ms); }

  .stats { list-style: none; margin: clamp(28px, 5vw, 56px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 0.75rem; }
  .stats li { display: grid; gap: 0.2rem; padding: 1rem 1.1rem; background: var(--wash); border-radius: 10px; border-top: 5px solid var(--coral); font-family: var(--display); }
  .stats li:nth-child(2) { border-color: var(--peach); } .stats li:nth-child(3) { border-color: var(--steel); } .stats li:nth-child(4) { border-color: var(--deep); }
  .stats strong { font-size: clamp(2rem, 4vw, 2.8rem); line-height: 1; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .stats span { font-size: 0.95rem; color: var(--muted); line-height: 1.3; }

  .band { --bg: var(--wash); background: var(--bg); box-shadow: 0 0 0 100vmax var(--bg); clip-path: inset(0 -100vmax); padding: clamp(32px, 5vw, 56px) 0; margin-top: clamp(32px, 5vw, 56px); }
  .band.gapband { --bg: var(--sand-wash, var(--wash)); margin-top: 0; }
  .band.contact { margin-bottom: 0; }
  .band-sub { color: var(--muted); max-width: 60ch; margin: 0.6rem 0 1.4rem; }

  .flag-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1rem; }
  .flag-list a { display: grid; gap: 0.3rem; align-content: start; height: 100%; padding: 1.1rem 1.2rem 1.2rem; border-radius: 10px; background: var(--paper); border-top: 6px solid var(--c); color: var(--ink); text-decoration: none; font-family: var(--display); transition: transform 0.15s; }
  .flag-list a:hover { transform: translateY(-3px); color: var(--ink); }
  .big { font-size: clamp(1.7rem, 3vw, 2.3rem); font-weight: 700; line-height: 1.05; letter-spacing: -0.02em; }
  .lab { font-size: 0.9rem; color: var(--muted); line-height: 1.3; margin-bottom: 0.6rem; }
  .t { font-size: 1.05rem; line-height: 1.3; }
  .role { font-size: 0.95rem; font-weight: 600; margin-top: 0.4rem; }
  .about h2 { max-width: 28ch; }
  .about-grid { display: grid; gap: 1rem 3rem; margin-top: 1rem; }
  .about-grid p { margin: 0; max-width: 60ch; }
  @media (min-width: 900px) { .about-grid { grid-template-columns: 1fr 1fr; } }
  .meta { font-size: 0.85rem; color: var(--muted); margin-top: 0.3rem; }

  .cards { list-style: none; margin: 1.2rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(12.5rem, 1fr)); gap: 1.25rem; }
  .cards li { padding: 0 0 0.3rem; }
  .cards .bar { display: block; height: 5px; width: 3rem; border-radius: 3px; margin-bottom: 0.9rem; }
  .b1 { background: var(--coral); } .b2 { background: var(--peach); } .b3 { background: var(--steel); } .b4 { background: var(--deep); }
  .cards h3 { margin-bottom: 0.4rem; }
  .cards p { margin: 0; font-size: 1rem; line-height: 1.55; color: var(--muted); }

  .gap-grid { display: grid; gap: 2rem 4rem; align-items: start; }
  @media (min-width: 1000px) { .gap-grid { grid-template-columns: minmax(0, 480px) minmax(0, 1fr); } }
  .takeaway { margin-top: 0; }

  .steps { list-style: none; counter-reset: s; margin: 1.2rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1.25rem; }
  .steps li { counter-increment: s; padding-left: 0; }
  .steps h3::before { content: counter(s); display: inline-grid; place-items: center; width: 1.7rem; height: 1.7rem; margin-right: 0.55rem; border-radius: 50%; background: var(--ink); color: var(--paper); font-size: 0.95rem; }
  .steps p { margin: 0.3rem 0 0; color: var(--muted); }

  .next { margin-top: 1.5rem; }
  @media (prefers-reduced-motion: reduce) { .flag-list a { transition: none; } .strip.pre.go .d { transition: none; } }
</style>
