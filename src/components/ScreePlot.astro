---
interface Props {
  eigenvalues: number[];
}
const { eigenvalues } = Astro.props;
const W = 560;
const H = 300;
const L = 52;
const R = 16;
const T = 14;
const B = 52;
const maxY = Math.ceil(Math.max(...eigenvalues));
const x = (i: number) => L + (i / (eigenvalues.length - 1)) * (W - L - R);
const y = (v: number) => T + (1 - v / maxY) * (H - T - B);
const path = eigenvalues.map((v, i) => `${i ? 'L' : 'M'} ${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join(' ');
const yt = Array.from({ length: maxY + 1 }, (_, i) => i);
---

<figure class="scree" data-fig>
  <svg viewBox={`0 0 ${W} ${H}`} role="group" aria-label="Scree plot: eigenvalue of each possible factor, from largest to smallest">
    <g class="grid">{yt.map((t) => <line x1={L} x2={W - R} y1={y(t)} y2={y(t)} />)}</g>
    <line class="kaiser" x1={L} x2={W - R} y1={y(1)} y2={y(1)} />
    <text class="kaiser-label" x={W - R} y={y(1) - 6} text-anchor="end">Eigenvalue of 1</text>
    <path class="line" d={path} />
    {
      eigenvalues.map((v, i) => (
        <g class="pt" data-tip tabindex="0" role="group" aria-label={`Factor ${i + 1}, eigenvalue ${v.toFixed(2)}`} data-label={`Factor ${i + 1}`} data-lines={`Eigenvalue ${v.toFixed(2)}`}>
          <circle class="hit" cx={x(i)} cy={y(v)} r="16" />
          <circle class="dot" cx={x(i)} cy={y(v)} r="5" />
        </g>
      ))
    }
    <g class="axis">
      <line x1={L} x2={W - R} y1={H - B} y2={H - B} />
      {eigenvalues.map((_, i) => <text x={x(i)} y={H - B + 20} text-anchor="middle">{i + 1}</text>)}
      {yt.map((t) => <text x={L - 10} y={y(t) + 5} text-anchor="end">{t}</text>)}
      <text class="axis-title" x={(L + W - R) / 2} y={H - 8} text-anchor="middle">Number of factors</text>
      <text class="axis-title" transform={`translate(14 ${(T + H - B) / 2}) rotate(-90)`} text-anchor="middle">Eigenvalue</text>
    </g>
  </svg>
  <div class="tip" hidden></div>
  <details class="table-view">
    <summary>View as a table</summary>
    <table>
      <thead><tr><th scope="col">Factor</th><th scope="col" class="num">Eigenvalue</th></tr></thead>
      <tbody>{eigenvalues.map((v, i) => <tr><th scope="row">{i + 1}</th><td class="num">{v.toFixed(2)}</td></tr>)}</tbody>
    </table>
  </details>
</figure>

<script>
  import { attachTips } from '../utils/figtip';
  document.querySelectorAll<HTMLElement>('[data-fig]').forEach(attachTips);
</script>

<style>
  .scree { margin: 1.25rem 0 0; position: relative; max-width: 560px; }
  svg { display: block; width: 100%; height: auto; overflow: visible; }
  .grid line { stroke: var(--rule); }
  .kaiser { stroke: var(--muted); stroke-dasharray: 5 5; }
  .kaiser-label { fill: var(--muted); font-family: var(--display); font-size: 13px; }
  .line { fill: none; stroke: var(--ink); stroke-width: 2; }
  .dot { fill: var(--ink); stroke: var(--paper); stroke-width: 2; }
  .hit { fill: transparent; }
  .pt:hover .dot, .pt:focus .dot { fill: var(--doctor); }
  .pt:focus { outline: none; }
  .pt:focus-visible .hit { stroke: var(--doctor); stroke-width: 2; }
  .axis line { stroke: var(--muted); }
  .axis text { fill: var(--muted); font-family: var(--display); font-size: 14px; }
  .tip { position: absolute; transform: translate(-50%, -100%); display: grid; gap: 0.1rem; padding: 0.55rem 0.8rem; background: var(--ink); color: var(--paper); border-radius: 6px; font-family: var(--display); font-size: 0.85rem; white-space: nowrap; pointer-events: none; z-index: 2; }
  .tip[hidden] { display: none; }
  .table-view { margin-top: 0.9rem; font-family: var(--display); font-size: 0.9rem; }
  .table-view summary { cursor: pointer; color: var(--muted); }
  .table-view table { width: 100%; margin-top: 0.75rem; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .table-view th, .table-view td { padding: 0.4rem 0.5rem; text-align: left; border-bottom: 1px solid var(--rule); }
  .table-view .num { text-align: right; }
</style>
