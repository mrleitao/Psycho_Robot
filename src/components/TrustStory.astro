  .sl label { font-weight: 650; display: flex; align-items: center; gap: 0.5rem; }
  .sl output { font: 750 1.15rem var(--display); font-variant-numeric: tabular-nums; min-width: 1.6rem; text-align: right; }
  .sl input { grid-column: 1 / -1; }
  input[type=range] { -webkit-appearance: none; appearance: none; background: transparent; width: 100%; height: 2.2rem; }
  input[type=range]::-webkit-slider-runnable-track { height: 6px; border-radius: 3px; background: var(--line); }
  input[type=range]::-moz-range-track { height: 6px; border-radius: 3px; background: var(--line); }
  input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 24px; height: 24px; margin-top: -9px; border-radius: 50%; background: var(--hyb); border: 3px solid var(--bg); box-shadow: 0 0 0 1.5px var(--hyb); }
  input[type=range]::-moz-range-thumb { width: 18px; height: 18px; border-radius: 50%; background: var(--hyb); border: 3px solid var(--bg); box-shadow: 0 0 0 1.5px var(--hyb); }
  .go, .again { font-weight: 750; font-size: 1.05rem; padding: 0.75rem 1.4rem; border-radius: 999px; border: 0; background: var(--hyb); color: #102a35; cursor: pointer; }
  .again { background: transparent; color: var(--fg); border: 1.5px solid var(--dim); margin-top: 1rem; }
  .go:hover { background: #fff; }
  .key { margin: 1.1rem 0 0; font-size: 0.9rem; color: var(--dim); display: flex; flex-wrap: wrap; gap: 0.4rem 1.1rem; align-items: center; }
  .sw { display: inline-block; width: 0.8rem; height: 0.8rem; border-radius: 50%; margin-right: 0.3rem; vertical-align: -0.05rem; }
  .k-human { background: var(--human); } .k-ai { background: var(--aic); } .k-hybrid { background: var(--hyb); } .k-same { background: var(--same); }
  .you-line { font-weight: 600; font-size: 1.12rem; }
  .you-line:empty { display: none; }
  .fig { margin: 1.4rem 0 0; position: relative; }
  .cap { font-weight: 700; font-size: 1.05rem; margin: 0 0 0.3rem; }
  .look { margin: 0 0 1rem; font-size: 0.92rem; color: var(--dim); max-width: 40rem; }
  .axis { display: flex; justify-content: space-between; font-size: 0.85rem; color: var(--dim); margin: 0.4rem 0 0 var(--lab, 0); }
  .legend2 { margin: 0.8rem 0 0; font-size: 0.9rem; color: var(--dim); display: flex; flex-wrap: wrap; gap: 0.3rem 1.2rem; align-items: center; }
  .tip { position: absolute; z-index: 5; transform: translate(-50%, -100%); background: #fff; color: #102a35; padding: 0.45rem 0.7rem; border-radius: 10px; font: 500 0.85rem/1.35 var(--display); pointer-events: none; box-shadow: 0 6px 20px rgba(0,0,0,0.35); white-space: nowrap; }
  .tip :global(strong) { display: block; } .tip :global(span) { display: block; }
  .note { color: var(--dim); font-size: 0.9rem; }
  /* strip chart */
  :global(.story .srow) { display: grid; grid-template-columns: var(--lab) minmax(0, 1fr); align-items: center; gap: 0 0.8rem; min-height: 2.5rem; }
  .strip { --lab: 8.6rem; }
  .axis { --lab: 9.4rem; }
  @media (max-width: 560px) { .strip { --lab: 5.6rem; } .axis { --lab: 6.4rem; } }
  :global(.story .slab) { font: 600 0.88rem/1.15 var(--display); display: flex; align-items: center; gap: 0.35rem; }
  :global(.story .trk) { position: relative; margin-inline: 5px; height: 2.5rem; border-left: 1px solid var(--line); border-right: 1px solid var(--line); background: linear-gradient(var(--line), var(--line)) center / 100% 1px no-repeat; }
  :global(.story .d) { position: absolute; width: 5px; height: 5px; border-radius: 50%; opacity: 0.55; transform: translate(-50%, -50%); }
  :global(.story .d.human) { background: var(--human); } :global(.story .d.ai) { background: var(--aic); } :global(.story .d.hybrid) { background: var(--hyb); }
  :global(.story .mci) { position: absolute; top: 50%; height: 5px; margin-top: -2.5px; background: #fff; border-radius: 3px; }
  :global(.story .mm) { position: absolute; top: 50%; width: 14px; height: 14px; margin: -7px 0 0 -7px; background: #fff; border: 3px solid var(--bg); border-radius: 3px; transform: rotate(45deg); }
  :global(.story .yo) { position: absolute; top: 50%; width: 20px; height: 20px; margin: -10px 0 0 -10px; border-radius: 50%; border: 3px solid var(--hyb); background: transparent; box-shadow: 0 0 0 2px var(--bg); }
  :global(.story .yl) { position: absolute; top: -0.1rem; transform: translateX(-50%); font: 700 0.7rem var(--display); color: var(--hyb); }
  :global(.story .srow.in) { opacity: 0; }
  :global(.story .srow.in.on) { opacity: 1; transition: opacity 0.4s ease; transition-delay: calc(var(--i) * 70ms); }
  /* people grid */
  .people { display: flex; flex-wrap: wrap; gap: 5px; max-width: 34rem; }
  .p { width: 14px; height: 14px; border-radius: 50%; }
  .p.human { background: var(--human); } .p.same { background: var(--same); } .p.ai { background: var(--aic); }
  /* dumbbell and bands */
  .dumb { --lab: 11rem; } .bands { --lab: 13.5rem; }
  .drow { display: grid; grid-template-columns: var(--lab) minmax(0, 1fr) 10rem; align-items: center; gap: 0 0.8rem; min-height: 2.3rem; }
  .dlab { margin: 0; font-size: 0.9rem; line-height: 1.2; font-weight: 600; }
  .dnote { margin: 0; font-size: 0.82rem; color: var(--dim); }
  .dtrack { position: relative; height: 2.3rem; border-left: 1px solid var(--line); border-right: 1px solid var(--line); background: linear-gradient(var(--line), var(--line)) center / 100% 1px no-repeat; }
  .dot { position: absolute; top: 50%; width: 16px; height: 16px; margin: -8px 0 0 -8px; border-radius: 50%; border: 2px solid var(--bg); }
  .dot.h { background: var(--human); } .dot.a { background: var(--aic); } .dot.n { background: var(--hyb); }
  .ci { position: absolute; top: 50%; height: 4px; margin-top: -2px; border-radius: 2px; opacity: 0.45; }
  .ci.h { background: var(--human); } .ci.a { background: var(--aic); } .ci.n { background: var(--hyb); }
  .link { position: absolute; top: 50%; height: 2px; margin-top: -1px; background: var(--dim); opacity: 0.6; }
  .band { margin: 0 0 1rem; }
  .bname { margin: 0.8rem 0 0.2rem; font-weight: 750; color: var(--hyb); }
  .dumb ~ .axis { margin-left: calc(11rem + 0.8rem); margin-right: calc(10rem + 0.8rem); }
  .bands ~ .axis { margin-left: calc(13.5rem + 0.8rem); margin-right: calc(10rem + 0.8rem); }
  @media (max-width: 640px) {
    .dumb, .bands { --lab: 6.8rem; }
    .drow { grid-template-columns: var(--lab) 1fr; grid-template-rows: auto auto; }
    .dnote { grid-column: 2; margin-top: -0.2rem; }
    .dumb ~ .axis, .bands ~ .axis { margin-left: calc(6.8rem + 0.8rem); margin-right: 0; }
  }
  .links { padding-left: 1.2rem; line-height: 1.8; font-family: var(--display); }
  .links a, .story :global(a) { color: var(--hyb); }
  @media (prefers-reduced-motion: reduce) { :global(.story .srow.in.on) { transition: none; } }
</style>

<script>
  const data = JSON.parse(document.getElementById('trust-data')!.textContent!);
  type Rec = { id: string; label: string; kind: string; n: number; mean: number; lo: number; hi: number; values: (number | null)[] };
  const recs: Rec[] = data.recs;
  const byId = Object.fromEntries(recs.map((r) => [r.id, r]));
  const sliders = Array.from(document.querySelectorAll<HTMLInputElement>('.sl input'));
  sliders.forEach((s) => s.addEventListener('input', () => { (s.parentElement!.querySelector('output') as HTMLOutputElement).textContent = s.value; }));
  const strip = document.getElementById('strip')!;
  const youLine = document.getElementById('you-line')!;
  const go = document.getElementById('go')!;
  const again = document.getElementById('again')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const f1 = (v: number) => v.toFixed(1);

  const mean = (xs: number[]) => xs.reduce((a, b) => a + b, 0) / xs.length;
  const HUM = ['doctor', 'nurse', 'layperson'], AI = ['ai_diagnostic', 'ai_chatbot'];
  const gapFor = (get: (id: string) => number | null) => {
    const h = HUM.map(get).filter((v): v is number => v != null), a = AI.map(get).filter((v): v is number => v != null);
    return h.length && a.length ? mean(h) - mean(a) : null;
  };

  function render(mine: Record<string, number> | null) {
    strip.replaceChildren();
    recs.forEach((r, i) => {
      const row = document.createElement('div');
      row.className = 'srow' + (reduce ? '' : ' in');
      row.style.setProperty('--i', String(i));
      const lab = document.createElement('div'); lab.className = 'slab';
      lab.innerHTML = `<span class="sw k-${r.kind}"></span>${r.label}`;
      const trk = document.createElement('div'); trk.className = 'trk';
      r.values.forEach((v, k) => {
        if (v == null) return;
        const d = document.createElement('span'); d.className = `d ${r.kind}`;
        const jx = (((k * 37) % 100) / 100 - 0.5) * 0.5, jy = (((k * 61) % 100) / 100) * 36 + 2;
        d.style.left = `${((v + jx) / 10) * 100}%`; d.style.top = `${jy}px`;
        d.style.left = `${Math.min(100, Math.max(0, ((v + jx) / 10) * 100))}%`;
        trk.append(d);
      });
      const ci = document.createElement('span'); ci.className = 'mci';
      ci.style.left = `${(r.lo / 10) * 100}%`; ci.style.width = `${((r.hi - r.lo) / 10) * 100}%`; trk.append(ci);
      const mm = document.createElement('span'); mm.className = 'mm'; mm.style.left = `${(r.mean / 10) * 100}%`;
      mm.dataset.tip = ''; mm.dataset.label = r.label; mm.dataset.lines = `Average ${f1(r.mean)}|95% interval ${f1(r.lo)} to ${f1(r.hi)}|${r.n} people`; mm.tabIndex = 0;
      trk.append(mm);
      if (mine && mine[r.id] != null) {
        const yo = document.createElement('span'); yo.className = 'yo'; yo.style.left = `${(mine[r.id] / 10) * 100}%`;
        yo.dataset.tip = ''; yo.dataset.label = 'You'; yo.dataset.lines = `You rated ${r.label} ${mine[r.id]}|Average ${f1(r.mean)}`; yo.tabIndex = 0;
        const yl = document.createElement('span'); yl.className = 'yl'; yl.style.left = `${(mine[r.id] / 10) * 100}%`; yl.textContent = 'You';
        trk.append(yo, yl);
      }
      row.append(lab, trk); strip.append(row);
    });
    if (!reduce) requestAnimationFrame(() => requestAnimationFrame(() => strip.querySelectorAll('.srow').forEach((r) => r.classList.add('on'))));
  }

  function summary(mine: Record<string, number>) {
    const you = gapFor((id) => mine[id] ?? null);
    const n = data.recs[0].values.length;
    const gaps: number[] = [];
    for (let k = 0; k < n; k++) { const g = gapFor((id) => byId[id].values[k]); if (g != null) gaps.push(g); }
    const below = gaps.filter((g) => g < (you as number)).length + gaps.filter((g) => g === you).length / 2;
    const med = [...gaps].sort((a, b) => a - b)[Math.floor(gaps.length / 2)];
    const hum = mean(HUM.map((id) => mine[id])), ai = mean(AI.map((id) => mine[id]));
    const rel = (you as number) > 0 ? 'You trusted the humans more.' : (you as number) < 0 ? 'You trusted the AIs more.' : 'You rated humans and AIs the same.';
    youLine.textContent = `You rated the doctor, nurse and layperson ${f1(hum)} on average and the two AIs ${f1(ai)}. ${rel} Your gap of ${f1(you as number)} points is larger than ${Math.round((below / gaps.length) * 100)}% of the ${gaps.length} adults who rated the same five. I left out the doctor using AI, because it is both. The middle adult’s gap was ${f1(med)}.`;
  }

  go.addEventListener('click', () => {
    const mine: Record<string, number> = {};
    sliders.forEach((s) => { mine[s.dataset.id!] = Number(s.value); });
    render(mine); summary(mine); again.hidden = false;
    document.getElementById('results')!.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
  });
  again.addEventListener('click', () => {
    again.hidden = true; youLine.textContent = ''; render(null);
    document.getElementById('play')!.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
  });
  render(null);

  // Tooltips for every figure, by delegation so they survive re-rendering.
  document.querySelectorAll<HTMLElement>('figure[data-fig]').forEach((fig) => {
    const tip = fig.querySelector<HTMLElement>('.tip')!;
    const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c] as string));
    const show = (el: HTMLElement) => {
      const lines = (el.dataset.lines ?? '').split('|').filter(Boolean);
      tip.innerHTML = `<strong>${esc(el.dataset.label ?? '')}</strong>${lines.map((l) => `<span>${esc(l)}</span>`).join('')}`;
      tip.hidden = false;
      const fr = fig.getBoundingClientRect(), r = el.getBoundingClientRect(), half = tip.offsetWidth / 2;
      tip.style.left = `${Math.max(half, Math.min(fr.width - half, r.left - fr.left + r.width / 2))}px`;
      tip.style.top = `${Math.max(tip.offsetHeight + 4, r.top - fr.top - 4)}px`;
    };
    const target = (e: Event) => (e.target as HTMLElement).closest<HTMLElement>('[data-tip]');
    fig.addEventListener('pointerover', (e) => { const t = target(e); if (t) show(t); });
    fig.addEventListener('pointerout', (e) => { if (target(e)) tip.hidden = true; });
    fig.addEventListener('focusin', (e) => { const t = target(e); if (t) show(t); });
    fig.addEventListener('focusout', () => (tip.hidden = true));
  });
</script>
