---
// Study 1 as a short story: rate six advice-givers yourself, then see how 188 adults rated them.
// Every number comes from the released Study 1 data (participant IDs are shuffled and anonymous).
import pts from '../data/trust-in-medical-ai/study1-points.json';
import outcomes from '../data/trust-in-medical-ai/study1-outcomes.json';
import hva from '../data/trust-in-medical-ai/study1-human-vs-ai.json';
import { href } from '../utils/url';

const kindOf = (id: string, ai: number) => (id === 'doctor_using_ai' ? 'hybrid' : ai ? 'ai' : 'human');
const recs = [...pts.trust]
  .sort((a: any, b: any) => b.mean - a.mean)
  .map((r: any) => ({ id: r.id, label: r.label, kind: kindOf(r.id, r.ai), n: r.n, mean: r.mean, lo: r.lo, hi: r.hi, values: r.values }));
const play = [
  { id: 'doctor', label: 'Doctor' },
  { id: 'nurse', label: 'Nurse' },
  { id: 'layperson', label: 'Layperson' },
  { id: 'doctor_using_ai', label: 'Doctor using AI' },
  { id: 'ai_diagnostic', label: 'AI diagnostic tool' },
  { id: 'ai_chatbot', label: 'AI chatbot' },
].map((p) => ({ ...p, kind: recs.find((r) => r.id === p.id)!.kind }));
const t = hva.tests[0].human_vs_ai;
const total = t.n, higher = t.higher, same = t.same, lower = t.lower;
const out = outcomes.outcomes;
const decisions = pts.decisions.filter((d: any) => d.id !== 'medical_general');
const domainOf = (id: string) => (id.startsWith('diagnose') ? 'Diagnose' : id.startsWith('prescribe') ? 'Prescribe' : 'Prevent');
const bands = ['Diagnose', 'Prescribe', 'Prevent'].map((name) => ({
  name,
  rows: decisions.filter((d: any) => domainOf(d.id) === name).sort((a: any, b: any) => b.mean - a.mean),
}));
const pct = (v: number, max: number) => `${(v / max) * 100}%`;
const data = { recs: recs.map(({ id, label, kind, n, mean, lo, hi, values }) => ({ id, label, kind, n, mean, lo, hi, values })), play, total };
const fm = (n: number) => n.toFixed(1);
---
<div class="story">
  <section class="hero" aria-labelledby="h-title">
    <p class="kick">Study 1 of my dissertation on trust in medical AI</p>
    <h1 id="h-title">Would you trust an AI with your health?</h1>
    <p class="lede">I asked 188 adults how much they would trust eleven advice-givers on medical decisions, from a doctor to a chatbot. Before you see what they said, rate six of them yourself.</p>
  </section>

  <section class="play" id="play" aria-labelledby="play-title">
    <div class="head">
      <h2 id="play-title">Your turn</h2>
      <a class="skip" href="#results">Skip to the results</a>
    </div>
    <p class="how">For a medical decision, how much would you trust each one? 0 is not at all. 10 is completely.</p>
    <div class="sliders">
      {play.map((p) => (
        <div class="sl">
          <label for={`s-${p.id}`}><span class={`sw k-${p.kind}`} aria-hidden="true"></span>{p.label}</label>
          <input id={`s-${p.id}`} data-id={p.id} type="range" min="0" max="10" step="1" value="5" />
          <output for={`s-${p.id}`}>5</output>
        </div>
      ))}
    </div>
    <button type="button" class="go" id="go">Compare me with 188 adults</button>
    <p class="key" aria-label="Color key"><span class="sw k-human"></span>Human <span class="sw k-ai"></span>AI <span class="sw k-hybrid"></span>Doctor using AI</p>
  </section>

  <section class="res" id="results" aria-labelledby="res-title">
    <h2 id="res-title">Adults trusted a doctor far more than an AI, though about one in four trusted the AI more</h2>
    <p class="you-line" id="you-line" aria-live="polite"></p>
    <figure data-fig class="fig">
      <figcaption class="cap">How much each of 188 adults trusted each advice-giver</figcaption>
      <p class="look">What to look for. Each small dot is one person. Blue dots (humans) cluster to the right of coral dots (AI). The bar is the average with its 95% interval.</p>
      <div class="strip" id="strip" role="img" aria-label="Trust ratings from 0 to 10 for eleven advice-givers, one dot per person, with averages."></div>
      <div class="axis"><span>0 not at all</span><span>5</span><span>10 completely</span></div>
      <div class="tip" hidden></div>
    </figure>
    <button type="button" class="again" id="again" hidden>Rate them again</button>
  </section>

  <section class="gap" aria-labelledby="gap-title">
    <h2 id="gap-title">Most people trusted humans more, but not everyone</h2>
    <p>I averaged each person’s trust in six human advice-givers and in four AI ones. {higher} of {total} people trusted the humans more. {lower} trusted the AI more, and {same} rated the two the same.</p>
    <figure data-fig class="fig">
      <figcaption class="cap">{higher} of {total} trusted humans more than AI</figcaption>
      <p class="look">What to look for. Mostly blue, a clear block of coral, a few grey in between. Each dot is one person.</p>
      <div class="people" role="img" aria-label={`${higher} people trusted humans more, ${same} rated them the same, ${lower} trusted AI more`}>
        {Array.from({ length: higher }, (_, i) => <span class="p human" data-tip data-label="Trusted humans more" data-lines={`Person ${i + 1} of ${total}`}></span>)}
        {Array.from({ length: same }, (_, i) => <span class="p same" data-tip data-label="Rated them the same" data-lines={`Person ${higher + i + 1} of ${total}`}></span>)}
        {Array.from({ length: lower }, (_, i) => <span class="p ai" data-tip data-label="Trusted AI more" data-lines={`Person ${higher + same + i + 1} of ${total}`}></span>)}
      </div>
      <p class="legend2"><span class="sw k-human"></span>Humans more ({higher}) <span class="sw k-same"></span>The same ({same}) <span class="sw k-ai"></span>AI more ({lower})</p>
      <div class="tip" hidden></div>
    </figure>
  </section>

  <section class="why" aria-labelledby="why-title">
    <h2 id="why-title">The doctor also looked better at both kinds of thinking</h2>
    <p>Good doctors combine numbers with judgment. They read the lab result, and they also sense when something does not add up. People rated a doctor higher than an AI on both. The trust gap was the largest of the three.</p>
    <figure data-fig class="fig">
      <figcaption class="cap">Doctor against AI, average rating from 0 to 10</figcaption>
      <p class="look">What to look for. In every row the blue dot sits to the right of the coral dot. The line behind each dot is its 95% interval.</p>
      <div class="dumb">
        {out.map((o: any) => (
          <div class="drow">
            <p class="dlab">{o.label}</p>
            <div class="dtrack">
              <span class="ci h" style={`left:${pct(o.doctor.lo, 10)};width:calc(${pct(o.doctor.hi, 10)} - ${pct(o.doctor.lo, 10)})`}></span>
              <span class="ci a" style={`left:${pct(o.ai.lo, 10)};width:calc(${pct(o.ai.hi, 10)} - ${pct(o.ai.lo, 10)})`}></span>
              <span class="link" style={`left:${pct(Math.min(o.doctor.mean, o.ai.mean), 10)};width:calc(${pct(Math.abs(o.doctor.mean - o.ai.mean), 10)})`}></span>
              <span class="dot h" style={`left:${pct(o.doctor.mean, 10)}`} data-tip data-label={`Doctor: ${o.label}`} data-lines={`Average ${fm(o.doctor.mean)}|95% interval ${fm(o.doctor.lo)} to ${fm(o.doctor.hi)}`}></span>
              <span class="dot a" style={`left:${pct(o.ai.mean, 10)}`} data-tip data-label={`AI: ${o.label}`} data-lines={`Average ${fm(o.ai.mean)}|95% interval ${fm(o.ai.lo)} to ${fm(o.ai.hi)}`}></span>
            </div>
            <p class="dnote">{fm(o.diff)} points apart, d = {o.d.toFixed(2).replace('0.', '.')}</p>
          </div>
        ))}
      </div>
      <div class="axis"><span>0</span><span>5</span><span>10</span></div>
      <p class="legend2"><span class="sw k-human"></span>Doctor <span class="sw k-ai"></span>General medical AI</p>
      <div class="tip" hidden></div>
    </figure>
    <p class="small note">d is Cohen’s d for paired ratings: the average gap divided by how much the gaps varied. Around .5 is a medium difference and .8 is large.</p>
  </section>

  <section class="dec" aria-labelledby="dec-title">
    <h2 id="dec-title">Not every decision calls for the same kind of thinking</h2>
    <p>For each decision I asked how much a professional would need numbers and how much intuition. Zero means only intuition and 100 means only numbers. Diagnosing and prescribing sit highest, at about 58 to 65. Prevention sits lowest, at about 49 to 54. That raised a question for Study 2: would the kind of decision change how people judge an AI?</p>
    <figure data-fig class="fig">
      <figcaption class="cap">How much each decision needs numbers, 0 to 100</figcaption>
      <p class="look">What to look for. Prevention dots sit nearer the middle of the scale. Diagnosis and prescribing sit further right.</p>
      <div class="bands">
        {bands.map((b) => (
          <div class="band">
            <p class="bname">{b.name}</p>
            {b.rows.map((d: any) => (
              <div class="drow">
                <p class="dlab">{d.label}</p>
                <div class="dtrack">
                  <span class="ci n" style={`left:${pct(d.lo, 100)};width:calc(${pct(d.hi, 100)} - ${pct(d.lo, 100)})`}></span>
                  <span class="dot n" style={`left:${pct(d.mean, 100)}`} data-tip data-label={d.label} data-lines={`Average ${fm(d.mean)}|95% interval ${fm(d.lo)} to ${fm(d.hi)}|${d.n} people`}></span>
                </div>
                <p class="dnote">{fm(d.mean)}</p>
              </div>
            ))}
          </div>
        ))}
      </div>
      <div class="axis"><span>0 only intuition</span><span>50</span><span>100 only numbers</span></div>
      <div class="tip" hidden></div>
    </figure>
  </section>

  <section class="end" aria-labelledby="end-title">
    <h2 id="end-title">What this told me, and what comes next</h2>
    <p>People gave the doctor the most trust and the AI chatbot close to the least. A doctor using AI landed in the middle, which fits the idea that AI in a doctor’s hands is trusted more than AI alone.</p>
    <p>These are stated ratings from one sample of 188 adults at one point in time. They do not show what people do. In my last study, people followed a doctor’s advice and an AI’s advice about equally.</p>
    <ul class="links">
      <li><a href={href('/projects/trust-in-medical-ai/study-1/')}>Every table and figure for Study 1</a></li>
      <li><a href={href('/projects/trust-in-medical-ai/study-2/')}>Study 2: does the kind of decision matter?</a></li>
      <li><a href={href('/data/study1-ratings.csv')}>De-identified Study 1 data (CSV)</a> and <a href={href('/data/study1-codebook.csv')}>codebook</a></li>
      <li><a href="https://github.com/mrleitao/Psycho_Robot">Code on GitHub</a></li>
    </ul>
  </section>
  <script type="application/json" id="trust-data" set:html={JSON.stringify(data)} />
</div>

<style>
  .story {
    --bg: #0e2530; --fg: #eef2f0; --dim: #a7bcc5; --line: #28485a; --card: #153341;
    --human: #6bb6e0; --aic: #f4898c; --hyb: #f1d1b5; --same: #8aa0aa;
    background: var(--bg); color: var(--fg); box-shadow: 0 0 0 100vmax var(--bg); clip-path: inset(0 -100vmax);
    font-family: var(--text); padding-block: clamp(2.2rem, 6vw, 4.5rem) clamp(3rem, 8vw, 6rem); margin-top: -1px;
  }
  .story > section { max-width: 46rem; margin: 0 auto clamp(3rem, 7vw, 5rem); }
  .story > section.res, .story > section.gap, .story > section.why, .story > section.dec { max-width: 50rem; }
  h1, h2, .kick, .cap, .look, .axis, .legend2, .sl label, .go, .again, .skip, .key, .dlab, .dnote, .bname { font-family: var(--display); }
  .kick { margin: 0 0 1rem; color: var(--hyb); font-weight: 600; font-size: 1rem; }
  h1 { margin: 0; font-size: clamp(2.6rem, 9vw, 5.4rem); line-height: 0.98; letter-spacing: -0.03em; font-weight: 800; max-width: 12ch; }
  .lede { margin: 1.4rem 0 0; font-size: clamp(1.15rem, 2.6vw, 1.4rem); line-height: 1.5; max-width: 34rem; color: #d8e3e6; }
  h2 { margin: 0 0 0.8rem; font-size: clamp(1.5rem, 4.2vw, 2.1rem); line-height: 1.12; letter-spacing: -0.015em; font-weight: 750; max-width: 24ch; }
  .res h2 { max-width: 26ch; }
  p { line-height: 1.6; max-width: 40rem; font-size: 1.08rem; }
  .head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 1.5rem; }
  .skip { color: var(--hyb); font-size: 0.95rem; }
  .skip:focus-visible, .go:focus-visible, .again:focus-visible, input:focus-visible { outline: 3px solid var(--hyb); outline-offset: 3px; }
  .play { background: var(--card); border-radius: 22px; padding: clamp(1.2rem, 4vw, 2.2rem); }
  .how { margin-top: 0; }
  .sliders { display: grid; gap: 0.5rem 2rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); margin: 1.2rem 0; }
