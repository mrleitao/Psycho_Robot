---
// Bayes factors on a log scale, read as "how many times more likely".
// Right of the middle line the data are more likely if there is no difference; left, if there is a difference.
// Each row shows three markers: the Bayes factor when the alternative is a small, a medium or a large effect (Funder and Ozer, 2019).
import { times, timesShort } from '../utils/bayes';
interface Sens { scale: number; size: string; bf10: number; bf01: number }
interface Row { id: string; text: string; group: string; bf10: number; bf01: number; verdict: string; source: string; sensitivity: Sens[]; priorNote: string }
interface Props { rows: Row[]; showGroups?: boolean }
const { rows, showGroups = true } = Astro.props;

const W = 780, labelW = 330, padR = 24, rowH = 40, top = 48;
const plotW = W - labelW - padR;
const LIM = 2.2; // log10 units either side of the middle; 10^2.2 is about 160 times
const xOf = (l: number) => labelW + ((Math.max(-LIM, Math.min(LIM, l)) + LIM) / (2 * LIM)) * plotW;
const x0 = xOf(0);
const lg = (bf10: number) => -Math.log10(bf10); // log10 of the evidence for no difference

const items: any[] = [];
let y = top, lastGroup = '';
for (const r of rows) {
  if (showGroups && r.group !== lastGroup) { items.push({ head: r.group, y: y + 8 }); y += 26; lastGroup = r.group; }
  items.push({ r, y });
  y += rowH;
}
const H = y + 14;

const wrap = (s: string, n = 46) => {
  if (s.length <= n) return [s];
  const words = s.split(' '); let a = '', b = '';
  for (const w of words) { if ((a + ' ' + w).trim().length <= n && !b) a = (a + ' ' + w).trim(); else b = (b + ' ' + w).trim(); }
  return [a, b];
};
const ticks = [-2, -1.477, -1, -0.477, 0, 0.477, 1, 1.477, 2];
const tickLab = (t: number) => (t === 0 ? 'even' : `${Math.round(10 ** Math.abs(t))}×`);
const phrase = (bf10: number, size: string) =>
  bf10 >= 1 ? `If the effect is ${size}: the data are ${times(bf10)} under a difference` : `If the effect is ${size}: the data are ${times(1 / bf10)} under no difference`;
const sizeOf = (r: Row, name: string) => r.sensitivity.find((s) => s.size === name)!;
const rowsForTable = rows.map((r) => ({ r, s: sizeOf(r, 'small'), m: sizeOf(r, 'medium'), l: sizeOf(r, 'large') }));
const cell = (bf10: number) => (bf10 >= 1 ? `${times(bf10).replace(' more likely', '')} for a difference` : `${times(1 / bf10).replace(' more likely', '')} for no difference`);
---

<figure class="bayes" data-fig>
  <div class="scroll" tabindex="0" role="region" aria-label="Chart. Scrolls sideways on narrow screens.">
    <svg viewBox={`0 0 ${W} ${H}`} role="group" aria-label="For each test, how many times more likely the data are under a difference or under no difference">
      <rect class="side no" x={x0} y={top - 10} width={xOf(LIM) - x0} height={H - top - 4} />
      <rect class="side yes" x={xOf(-LIM)} y={top - 10} width={x0 - xOf(-LIM)} height={H - top - 4} />
      <text class="axlab" x={xOf(-LIM) + 4} y="16">← difference more likely</text>
      <text class="axlab" x={xOf(LIM) - 4} y="16" text-anchor="end">no difference more likely →</text>
      <text class="axlab sub" x={x0} y="31" text-anchor="middle">how many times more likely</text>
      {ticks.map((t) => (
        <g>
          <line class={t === 0 ? 'mid' : 'grid'} x1={xOf(t)} x2={xOf(t)} y1={top - 10} y2={H - 12} />
          <text class="tick" x={xOf(t)} y="43" text-anchor="middle">{tickLab(t)}</text>
        </g>
      ))}
      {
        items.map((it) => {
          if (it.head) return <text class="group" x="8" y={it.y + 10}>{it.head}</text>;
          const r: Row = it.r;
          const sm = sizeOf(r, 'small'), md = sizeOf(r, 'medium'), lgS = sizeOf(r, 'large');
          const xs = [sm, md, lgS].map((s) => xOf(lg(s.bf10)));
          const lo = Math.min(...xs), hi = Math.max(...xs);
          const nul = md.bf10 < 1;
          const bf = nul ? md.bf01 : md.bf10;
          const lines = wrap(r.text);
          const cy = it.y + rowH / 2 - 2;
          const xm = xOf(lg(md.bf10));
          const left = !nul && xm - labelW < 120;
          return (
            <g class="row" data-tip tabindex="0" role="group"
               aria-label={`${r.text}. ${phrase(md.bf10, 'medium')}.`}
               data-label={r.text}
               data-lines={[phrase(md.bf10, 'medium'), phrase(sm.bf10, 'small'), phrase(lgS.bf10, 'large'), r.source === 'raw data' ? 'From the released data' : 'From the statistics reported in the dissertation'].join('|')}>
              <rect class="hit" x="0" y={it.y} width={W} height={rowH} />
              {lines.map((ln, k) => <text class="name" x="8" y={cy + (lines.length === 1 ? 5 : k * 15 - 2)}>{ln}</text>)}
              <line class={`bar ${nul ? 'no' : 'yes'}`} x1={x0} x2={xm} y1={cy} y2={cy} />
              <line class="sens" x1={lo} x2={hi} y1={cy} y2={cy} />
              <circle class={`mk small ${nul ? 'no' : 'yes'}`} cx={xOf(lg(sm.bf10))} cy={cy} r="4.5" />
              <rect class={`mk large ${nul ? 'no' : 'yes'}`} x={xOf(lg(lgS.bf10)) - 4.5} y={cy - 4.5} width="9" height="9" transform={`rotate(45 ${xOf(lg(lgS.bf10))} ${cy})`} />
              <circle class={`dot ${nul ? 'no' : 'yes'}`} cx={xm} cy={cy} r="6.5" />
              <text class="val" x={nul || left ? Math.max(hi, xm) + 12 : Math.min(lo, xm) - 12} y={left ? cy - 11 : cy + 4.5} text-anchor={nul || left ? 'start' : 'end'}>{timesShort(bf)}</text>
            </g>
          );
        })
      }
    </svg>
  </div>
  <ul class="key">
    <li><svg width="44" height="14" aria-hidden="true"><circle class="mk small ink" cx="8" cy="7" r="4.5" /><circle class="dot ink" cx="22" cy="7" r="6.5" /><rect class="mk large ink" x="31.5" y="2.5" width="9" height="9" transform="rotate(45 36 7)" /></svg>Small, medium and large effect (the labelled dot is medium)</li>
    <li><span class="sw no"></span>Data favor no difference</li>
    <li><span class="sw yes"></span>Data favor a difference</li>
  </ul>
  <details class="asTable">
    <summary>View as a table</summary>
    <div class="tw" tabindex="0" role="region" aria-label="Table. Scrolls sideways on narrow screens.">
      <table>
        <thead><tr><th>Test</th><th>If the effect is small</th><th>If medium</th><th>If large</th></tr></thead>
        <tbody>
          {rowsForTable.map(({ r, s, m, l }) => (
            <tr><th scope="row">{r.text}</th><td>{cell(s.bf10)}</td><td>{cell(m.bf10)}</td><td>{cell(l.bf10)}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
  <div class="tip" hidden></div>
</figure>

<script>
  import { attachTips } from '../utils/figtip';
  document.querySelectorAll<HTMLElement>('[data-fig]').forEach(attachTips);
</script>

<style>
  .bayes { margin: 1.25rem 0 0; position: relative; max-width: 800px; }
  .scroll { overflow-x: auto; }
  svg { display: block; width: 100%; min-width: 700px; height: auto; overflow: visible; }
  .key svg { min-width: 0; width: 44px; display: inline-block; }
  .side.no { fill: var(--null); opacity: 0.1; } .side.yes { fill: var(--ai); opacity: 0.07; }
  .grid { stroke: var(--rule); stroke-width: 1; stroke-dasharray: 2 4; } .mid { stroke: var(--ink); stroke-width: 1.5; }
  .tick { font-family: var(--display); font-size: 11px; fill: var(--muted); }
  .axlab { font-family: var(--display); font-size: 12px; fill: var(--muted); } .axlab.sub { font-size: 11px; }
  .group { font-family: var(--display); font-size: 12.5px; font-weight: 700; fill: var(--ink); }
  .name { font-family: var(--display); font-size: 13px; fill: var(--ink); }
  .hit { fill: transparent; } .row:hover .hit, .row:focus .hit { fill: var(--wash); opacity: 0.9; }
  .row:focus { outline: none; } .row:focus-visible .hit { stroke: var(--doctor); stroke-width: 2; }
  .bar { stroke-width: 5; stroke-linecap: round; } .bar.no { stroke: var(--null); } .bar.yes { stroke: var(--ai); }
  .sens { stroke: var(--ink); stroke-width: 1; opacity: 0.5; }
  .mk { stroke-width: 2; } .mk.small { fill: var(--paper); } .mk.large { fill: var(--paper); }
  .mk.no { stroke: var(--null); } .mk.yes { stroke: var(--ai); } .mk.ink { stroke: var(--ink); }
  .dot { stroke: var(--paper); stroke-width: 2; } .dot.no { fill: var(--null); } .dot.yes { fill: var(--ai); } .dot.ink { fill: var(--ink); }
  .val { font-family: var(--display); font-size: 12px; font-weight: 700; fill: var(--ink); font-variant-numeric: tabular-nums; }
  .key { list-style: none; margin: 0.6rem 0 0.6rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; font-family: var(--display); font-size: 0.92rem; }
  .key li { display: inline-flex; align-items: center; gap: 0.5rem; }
  .sw { width: 1.4rem; height: 0.8rem; border-radius: 2px; flex: none; } .sw.no { background: var(--null); } .sw.yes { background: var(--ai); }
  .asTable { margin: 0 0 1.8rem; font-family: var(--display); }
  .asTable summary { cursor: pointer; color: var(--muted); font-size: 0.92rem; }
  .tw { overflow-x: auto; margin-top: 0.6rem; }
  .asTable table { border-collapse: collapse; font-size: 0.88rem; min-width: 640px; width: 100%; }
  .asTable th, .asTable td { text-align: left; padding: 0.35rem 0.8rem 0.35rem 0; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .asTable thead th { color: var(--muted); font-weight: 600; } .asTable tbody th { font-weight: 500; }
  .tip { position: absolute; transform: translate(-50%, -100%); display: grid; gap: 0.1rem; padding: 0.55rem 0.8rem; background: var(--ink); color: var(--paper); border-radius: 6px; font-family: var(--display); font-size: 0.85rem; line-height: 1.35; white-space: nowrap; pointer-events: none; z-index: 2; }
  .tip[hidden] { display: none; }
</style>
