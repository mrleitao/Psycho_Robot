---
export interface Row {
  domain: string;
  diff: number;
  lo: number;
  hi: number;
  t: number;
  df: number;
  d: number;
}

interface Props {
  rows: Row[];
  xMin?: number;
  xMax?: number;
  xLabel: string;
  leftLabel: string;
  rightLabel: string;
  animate?: boolean;
}

const { rows, xMin = -1, xMax = 5, xLabel, leftLabel, rightLabel, animate = false } = Astro.props;

const W = 440;
const padX = 16;
const rowH = 68;
const top = 8;
const axisY = top + rows.length * rowH + 6;
const H = axisY + 56;

const x = (v: number) => padX + ((v - xMin) / (xMax - xMin)) * (W - 2 * padX);
const ticks = Array.from({ length: xMax - xMin + 1 }, (_, i) => xMin + i);
const fmt = (n: number) => n.toFixed(2);
---

<figure class="forest" data-forest data-animate={animate ? '' : undefined}>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    role="group"
    aria-label="Forest plot of the Doctor minus AI trust difference with 95% confidence intervals, one row per medical domain"
  >
    <g class="grid">
      {ticks.map((t) => <line x1={x(t)} x2={x(t)} y1={top} y2={axisY} />)}
    </g>
    <line class="zero" x1={x(0)} x2={x(0)} y1={top} y2={axisY} />

    {
      rows.map((r, i) => {
        const y0 = top + i * rowH;
        const cy = y0 + 48;
        return (
          <g
            class="row"
            tabindex="0"
            role="group"
            style={`--i:${i}`}
            aria-label={`${r.domain}: difference ${fmt(r.diff)}, 95% confidence interval ${fmt(r.lo)} to ${fmt(r.hi)}`}
            data-domain={r.domain}
            data-diff={fmt(r.diff)}
            data-lo={fmt(r.lo)}
            data-hi={fmt(r.hi)}
            data-t={r.t}
            data-df={r.df}
            data-d={r.d}
          >
            <rect class="hit" x="0" y={y0} width={W} height={rowH} />
            <text class="name" x={padX} y={y0 + 22}>{r.domain}</text>
            <text class="stat" x={W - padX} y={y0 + 22} text-anchor="end">
              {fmt(r.diff)} [{fmt(r.lo)}, {fmt(r.hi)}]
            </text>
            <line class="ci" x1={x(r.lo)} x2={x(r.hi)} y1={cy} y2={cy} pathLength="1" />
            <line class="cap" x1={x(r.lo)} x2={x(r.lo)} y1={cy - 7} y2={cy + 7} />
            <line class="cap" x1={x(r.hi)} x2={x(r.hi)} y1={cy - 7} y2={cy + 7} />
            <circle class="dot" cx={x(r.diff)} cy={cy} r="7" />
          </g>
        );
      })
    }

    <g class="axis">
      <line x1={padX} x2={W - padX} y1={axisY} y2={axisY} />
      {ticks.map((t) => <text x={x(t)} y={axisY + 22} text-anchor="middle">{t}</text>)}
      <text class="axis-title" x={W / 2} y={axisY + 46} text-anchor="middle">{xLabel}</text>
    </g>
  </svg>

  <p class="ends">
    <span class="end ai">{leftLabel}</span>
    <span class="end doctor">{rightLabel}</span>
  </p>

  <div class="tip" hidden></div>

  <details class="table-view">
    <summary>View as a table</summary>
    <table>
      <thead>
        <tr>
          <th scope="col">Domain</th>
          <th scope="col">Difference</th>
          <th scope="col">95% CI</th>
          <th scope="col">t</th>
          <th scope="col">df</th>
          <th scope="col">Cohen's d</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr>
              <th scope="row">{r.domain}</th>
              <td>{fmt(r.diff)}</td>
              <td>
                {fmt(r.lo)} to {fmt(r.hi)}
              </td>
              <td>{r.t}</td>
              <td>{r.df}</td>
              <td>{r.d}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </details>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-forest]').forEach((fig) => {
    const tip = fig.querySelector<HTMLElement>('.tip');
    if (!tip) return;

    const show = (row: Element) => {
      const d = (row as SVGElement).dataset;
      tip.innerHTML =
        `<strong>${d.domain}</strong>` +
        `<span>Doctor minus AI: ${d.diff}</span>` +
        `<span>95% CI ${d.lo} to ${d.hi}</span>` +
        `<span>t(${d.df}) = ${d.t}, d = ${d.d}</span>`;
      tip.hidden = false;

      const f = fig.getBoundingClientRect();
      const dot = row.querySelector('.dot')!.getBoundingClientRect();
      const half = tip.offsetWidth / 2;
      const left = Math.max(half, Math.min(f.width - half, dot.left - f.left + dot.width / 2));
      tip.style.left = `${left}px`;
      tip.style.top = `${dot.top - f.top - 12}px`;
    };
    const hide = () => {
      tip.hidden = true;
    };

    fig.querySelectorAll('.row').forEach((row) => {
      row.addEventListener('pointerenter', () => show(row));
      row.addEventListener('pointerleave', hide);
      row.addEventListener('focus', () => show(row));
      row.addEventListener('blur', hide);
    });
  });
</script>

<style>
  .forest {
    margin: 0;
    max-width: 480px;
    position: relative;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .grid line {
    stroke: var(--rule);
    stroke-width: 1;
  }

  .zero {
    stroke: var(--muted);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
  }

  .axis line {
    stroke: var(--muted);
    stroke-width: 1;
  }

  .axis text {
    fill: var(--muted);
    font-family: var(--display);
    font-size: 14px;
  }

  .name {
    fill: var(--ink);
    font-family: var(--display);
    font-weight: 600;
    font-size: 17px;
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 6px;
    stroke-linejoin: round;
  }

  .stat {
    fill: var(--muted);
    font-family: var(--display);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 6px;
    stroke-linejoin: round;
  }

  .hit {
    fill: transparent;
  }

  .row:hover .hit,
  .row:focus .hit {
    fill: var(--wash);
  }

  .row:focus {
    outline: none;
  }

  .row:focus-visible .hit {
    stroke: var(--doctor);
    stroke-width: 2;
  }

  .ci {
    stroke: var(--doctor);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .cap {
    stroke: var(--doctor);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .dot {
    fill: var(--doctor);
    stroke: var(--paper);
    stroke-width: 2.5;
    transition: r 120ms ease-out;
  }

  .row:hover .dot,
  .row:focus .dot {
    r: 9;
  }

  /* Names which side means what. The swatches carry the color; the text stays ink. */
  .ends {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0.25rem 0 0;
    font-family: var(--display);
    font-size: 0.95rem;
  }

  .end {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .end::before {
    content: '';
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: currentColor;
    flex: none;
  }

  .end.ai::before {
    background: var(--ai);
  }

  .end.doctor::before {
    background: var(--doctor);
  }

  .tip {
    position: absolute;
    transform: translate(-50%, -100%);
    display: grid;
    gap: 0.1rem;
    padding: 0.55rem 0.8rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: 6px;
    font-family: var(--display);
    font-size: 0.85rem;
    line-height: 1.35;
    white-space: nowrap;
    pointer-events: none;
    z-index: 2;
  }

  .tip[hidden] {
    display: none;
  }

  .table-view {
    margin-top: 1.25rem;
    font-family: var(--display);
    font-size: 0.9rem;
  }

  .table-view summary {
    cursor: pointer;
    color: var(--muted);
  }

  .table-view table {
    width: 100%;
    margin-top: 0.75rem;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .table-view th,
  .table-view td {
    padding: 0.4rem 0.5rem;
    text-align: right;
    border-bottom: 1px solid var(--rule);
  }

  .table-view th:first-child,
  .table-view td:first-child {
    text-align: left;
  }

  /* The one orchestrated moment on the site: intervals draw in, then the dots land. */
  @media (prefers-reduced-motion: no-preference) {
    [data-animate] .ci {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: draw 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
      animation-delay: calc(var(--i) * 0.12s + 0.2s);
    }

    [data-animate] .cap,
    [data-animate] .dot {
      opacity: 0;
      animation: appear 0.3s ease-out forwards;
      animation-delay: calc(var(--i) * 0.12s + 0.9s);
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes appear {
    to {
      opacity: 1;
    }
  }
</style>
