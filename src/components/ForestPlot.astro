---
interface Row { domain: string; diff: number; lo: number; hi: number; t: number; df: number; d: number }
interface Props { rows: Row[]; xMin?: number; xMax?: number; xLabel: string }
const { rows, xMin = 0, xMax = 5, xLabel } = Astro.props;

const W = 640, rowH = 56, top = 16, left = 140, right = 24, bottom = 56;
const H = top + rows.length * rowH + bottom;
const plotW = W - left - right;
const x = (v: number) => left + ((v - xMin) / (xMax - xMin)) * plotW;
const ticks = Array.from({ length: xMax - xMin + 1 }, (_, i) => xMin + i);
---
<figure class="forest">
  <svg viewBox={`0 0 ${W} ${H}`} role="img"
       aria-label="Forest plot: Doctor minus AI trust difference with 95% confidence intervals, by medical domain">
    {ticks.map((t) => (
      <g>
        <line x1={x(t)} x2={x(t)} y1={top} y2={H - bottom} class="grid" />
        <text x={x(t)} y={H - bottom + 20} text-anchor="middle" class="tick">{t}</text>
      </g>
    ))}
    <line x1={x(0)} x2={x(0)} y1={top} y2={H - bottom} class="zero" />
    {rows.map((r, i) => {
      const cy = top + i * rowH + rowH / 2;
      return (
        <g class="row" tabindex="0">
          <title>{`${r.domain}: difference ${r.diff.toFixed(2)}, 95% CI [${r.lo.toFixed(2)}, ${r.hi.toFixed(2)}], t(${r.df}) = ${r.t}, d = ${r.d}`}</title>
          <text x={left - 14} y={cy + 5} text-anchor="end" class="label">{r.domain}</text>
          <line x1={x(r.lo)} x2={x(r.hi)} y1={cy} y2={cy} class="ci" />
          <line x1={x(r.lo)} x2={x(r.lo)} y1={cy - 7} y2={cy + 7} class="ci" />
          <line x1={x(r.hi)} x2={x(r.hi)} y1={cy - 7} y2={cy + 7} class="ci" />
          <circle cx={x(r.diff)} cy={cy} r="6.5" class="pt" />
          <text x={x(r.diff)} y={cy - 14} text-anchor="middle" class="val">{r.diff.toFixed(2)}</text>
        </g>
      );
    })}
    <text x={left + plotW / 2} y={H - 10} text-anchor="middle" class="axis">{xLabel}</text>
  </svg>
</figure>

<style>
  .forest { margin: 0; }
  svg { width: 100%; height: auto; display: block; }
  .grid { stroke: var(--grid); stroke-width: 1; }
  .zero { stroke: var(--muted); stroke-width: 1.5; stroke-dasharray: 4 4; }
  .tick, .axis { fill: var(--muted); font-size: 13px; }
  .label { fill: var(--ink); font-size: 15px; }
  .val { fill: var(--ink); font-size: 12.5px; font-weight: 600; }
  .ci { stroke: var(--accent); stroke-width: 2.5; stroke-linecap: round; }
  .pt { fill: var(--accent); stroke: var(--bg); stroke-width: 2; }
  .row:hover .pt, .row:focus .pt { r: 8.5; }
  .row:focus { outline: none; }
</style>
