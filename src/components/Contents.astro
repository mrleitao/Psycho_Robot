---
// A table of contents for the "in full" pages: each section with the tables and figures inside it.
interface Item { label: string; href: string; kind?: 'table' | 'figure' | 'page' }
interface Group { title: string; href: string; items: Item[] }
interface Props { groups: Group[] }
const { groups } = Astro.props;
---
<nav class="toc" aria-label="Contents of this page">
  <h3 class="toc-title">Contents</h3>
  <ol>
    {groups.map((g) => (
      <li>
        <a class="sec" href={g.href}>{g.title}</a>
        <ul>
          {g.items.map((i) => (
            <li><a href={i.href}>{i.kind !== 'page' && <span class={`tag ${i.kind ?? 'table'}`}>{i.kind === 'figure' ? 'Figure' : 'Table'}</span>}{i.label}</a></li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</nav>
<style>
  .toc { margin: 1.5rem 0 2rem; padding: 1.1rem 1.3rem; background: var(--wash); border-radius: 8px; font-family: var(--display); max-width: 820px; }
  .toc-title { margin: 0 0 0.6rem; font-size: 1.05rem; }
  ol { margin: 0; padding: 0; list-style: none; columns: 2 18rem; column-gap: 2rem; }
  ol > li { break-inside: avoid; margin: 0 0 0.9rem; }
  .sec { font-weight: 700; color: var(--ink); text-decoration: none; }
  .sec:hover { text-decoration: underline; }
  ul { margin: 0.25rem 0 0; padding: 0; list-style: none; }
  ul li { margin: 0.15rem 0; font-size: 0.9rem; line-height: 1.35; }
  ul a { color: var(--muted); text-decoration: none; display: inline-flex; gap: 0.5rem; }
  ul a:hover { color: var(--ink); text-decoration: underline; }
  .tag { flex: none; min-width: 3.6rem; font-size: 0.78rem; color: var(--deep); font-weight: 600; }
  .tag.figure { color: #b04f53; }
  :global([data-theme='dark']) .tag { color: var(--null); }
  :global([data-theme='dark']) .tag.figure { color: var(--ai); }
</style>
