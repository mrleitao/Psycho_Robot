---
// A correlation matrix as a shaded grid. Darker blue is a stronger positive correlation. Values are printed in the cells.
interface Props { vars: string[]; r: number[][]; title?: string; ariaLabel: string }
const { vars, r, title, ariaLabel } = Astro.props;
const n = vars.length, cell = 64, labelW = 150, top = title ? 56 : 40;
const W = labelW + n * cell + 10, H = top + n * cell + 6;
const shade = (v: number) => `color-mix(in srgb, var(--steel) ${Math.round(Math.max(0, Math.min(1, Math.abs(v))) * 100)}%, var(--paper))`;
const dark = (v: number) => Math.abs(v) > 0.85;
const f = (v: number) => v.toFixed(2).replace(/^(-?)0\./, '$1.').replace('-', '−');
---
<figure class="cg">
  <div class="scroll" tabindex="0" role="region" aria-label="Chart. Scrolls sideways on narrow screens.">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={ariaLabel}>
      {title && <text class="title" x={labelW} y="16">{title}</text>}
      {vars.map((v, j) => (<text class="col" x={labelW + j * cell + cell / 2} y={top - 8} text-anchor="middle">{v.length > 12 ? v.split(' ').map((w, k) => <tspan x={labelW + j * cell + cell / 2} dy={k === 0 ? -12 : 12}>{w}</tspan>) : v}</text>))}
      {vars.map((v, i) => (
        <g>
          <text class="row" x={labelW - 8} y={top + i * cell + cell / 2 + 4} text-anchor="end">{v}</text>
          {vars.map((_, j) => (
            <g><rect x={labelW + j * cell + 1} y={top + i * cell + 1} width={cell - 2} height={cell - 2} rx="3" fill={shade(r[i][j])} />
            <text class={`v ${dark(r[i][j]) ? 'on' : ''}`} x={labelW + j * cell + cell / 2} y={top + i * cell + cell / 2 + 4} text-anchor="middle">{i === j ? '' : f(r[i][j])}</text></g>
          ))}
        </g>
      ))}
    </svg>
  </div>
</figure>
<style>
  .cg { margin: 1rem 0 1.8rem; } .scroll { overflow-x: auto; }
  svg { display: block; width: 100%; max-width: 640px; min-width: 460px; height: auto; }
  .title { font-family: var(--display); font-size: 13px; font-weight: 700; fill: var(--ink); }
  .col, .row { font-family: var(--display); font-size: 11.5px; fill: var(--ink); }
  .v { font-family: var(--display); font-size: 12px; fill: var(--ink); font-variant-numeric: tabular-nums; } .v.on { fill: #fff; }
</style>
