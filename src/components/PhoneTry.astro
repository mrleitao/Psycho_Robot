---
// "Try it" for the phone mega-analysis: guess the gap, then see how sample size changes what you can tell.
// All numbers come from the printed paper. The interval is derived: SE = sqrt(4/N + d^2/(2N)).
interface Props { skipHref?: string }
const { skipHref = '#main-findings' } = Astro.props;
---
<section class="try" aria-labelledby="try-title" id="try-it">
  <div class="top">
    <h2 id="try-title">Try it: guess the gap</h2>
    <a class="skip" href={skipHref}>Skip to the results</a>
  </div>
  <p class="intro">Eight experiments put a phone in view during a short social moment. People then rated how connected they felt. Before you read on, guess how much a phone lowered connection for men and for women.</p>

  <div class="step" id="step1">
    <p class="q">Drag each slider to your guess. The scale is the drop in standard deviations. Zero is no drop.</p>
    <div class="sl">
      <label for="g-men">Men: <output id="o-men">0.30</output></label>
      <input id="g-men" type="range" min="0" max="0.8" step="0.01" value="0.30" />
    </div>
    <div class="sl">
      <label for="g-women">Women: <output id="o-women">0.30</output></label>
      <input id="g-women" type="range" min="0" max="0.8" step="0.01" value="0.30" />
    </div>
    <button type="button" id="reveal" class="btn">Reveal the result</button>
  </div>

  <div class="step" id="reveal-out" hidden>
    <p class="q" id="reveal-text" aria-live="polite"></p>
    <svg id="reveal-svg" viewBox="0 0 520 150" role="img" aria-label="Your guesses against the printed drop in connectedness for men and women"></svg>
    <p class="small muted">Filled dots are the values printed in the paper (Cohen’s d). Hollow dots are your guesses. The paper reports no interval for these two values, so none is drawn.</p>
  </div>

  <div class="step" id="step2" hidden>
    <h3>Why pool eight experiments?</h3>
    <p class="q">The overall drop across everyone was d = −.18, with a phone against without. Slide the number of people to see how sure a study of that size could be.</p>
    <div class="sl">
      <label for="n-sl">People in the study: <output id="n-out">130</output></label>
      <input id="n-sl" type="range" min="0" max="100" step="1" value="21" />
    </div>
    <p class="presets" role="group" aria-label="Jump to a study size">
      <button type="button" class="pre" data-n="130">130: the smallest situation</button>
      <button type="button" class="pre" data-n="408">408: the largest situation</button>
      <button type="button" class="pre" data-n="1778">1,778: all eight experiments</button>
    </p>
    <svg id="n-svg" viewBox="0 0 520 120" role="img" aria-label="Interval around the effect for the chosen number of people"></svg>
    <p id="n-text" class="verdict" aria-live="polite"></p>
    <p class="small muted">Interval: d ± 1.96 × √(4/N + d²/2N), assuming two equal groups. This is my derived approximation, not a printed value. The six situations we pooled had between 130 and 408 people each. Use the buttons to jump to them. All eight experiments together had 1,778.</p>
  </div>
</section>

<style>
  .try { margin: 1.8rem 0 2.4rem; padding: clamp(1.1rem, 3vw, 1.8rem); border-radius: 20px; background: var(--wash); border: 1.5px solid var(--rule); font-family: var(--display); }
  .top { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 1.5rem; }
  h2 { margin: 0; font-size: clamp(1.4rem, 3.5vw, 1.8rem); }
  h3 { margin: 0 0 0.4rem; font-size: 1.15rem; }
  .skip { font-size: 0.95rem; color: var(--deep); }
  .intro, .q { max-width: 62ch; line-height: 1.5; margin: 0.7rem 0; font-family: var(--text); }
  .step { margin-top: 1.2rem; padding-top: 1.1rem; border-top: 1px solid var(--rule); }
  .step[hidden] { display: none; }
  .sl { display: grid; gap: 0.3rem; margin: 0.8rem 0; max-width: 28rem; }
  label { font-weight: 600; }
  output { font-variant-numeric: tabular-nums; font-weight: 750; }
  input[type=range] { -webkit-appearance: none; appearance: none; background: transparent; width: 100%; height: 2rem; }
  input[type=range]::-webkit-slider-runnable-track { height: 6px; border-radius: 3px; background: var(--rule); }
  input[type=range]::-moz-range-track { height: 6px; border-radius: 3px; background: var(--rule); }
  input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 22px; height: 22px; margin-top: -8px; border-radius: 50%; background: var(--ai); border: 3px solid var(--paper); box-shadow: 0 0 0 1.5px var(--ai); }
  input[type=range]::-moz-range-thumb { width: 16px; height: 16px; border-radius: 50%; background: var(--ai); border: 3px solid var(--paper); box-shadow: 0 0 0 1.5px var(--ai); }
  .btn { margin-top: 0.4rem; font: 700 1rem var(--display); padding: 0.65rem 1.2rem; border-radius: 999px; border: 0; background: var(--deep); color: #fff; cursor: pointer; }
  .btn:hover { background: var(--ink); }
  .btn:focus-visible, input:focus-visible, .skip:focus-visible { outline: 3px solid var(--coral); outline-offset: 3px; }
  svg { width: 100%; max-width: 40rem; height: auto; display: block; }
  .presets { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.4rem 0 0.8rem; }
  .pre { font: 600 0.85rem var(--display); padding: 0.4rem 0.8rem; border-radius: 999px; border: 1.5px solid var(--deep); background: transparent; color: var(--ink); cursor: pointer; }
  .pre:hover { background: var(--paper); }
  .pre:focus-visible { outline: 3px solid var(--coral); outline-offset: 3px; }
  .verdict { font-weight: 650; margin: 0.5rem 0; }
  :global(.try .ax) { stroke: var(--muted); stroke-width: 1; }
  :global(.try .zero) { stroke: var(--ink); stroke-width: 1.5; }
  :global(.try text) { fill: var(--ink); font: 500 15px var(--display); }
  :global(.try .ci) { stroke: var(--deep); stroke-width: 4; stroke-linecap: round; }
  :global(.try .ci.cross) { stroke: var(--coral); }
  :global(.try .act) { fill: var(--deep); }
  :global(.try .guess) { fill: var(--paper); stroke: var(--ai); stroke-width: 2.5; }
</style>

<script>
  const $ = <T extends Element>(s: string) => document.querySelector<T>(s)!;
  const NS = 'http://www.w3.org/2000/svg';
  const mk = (n: string, a: Record<string, string | number>, t?: string) => { const e = document.createElementNS(NS, n); for (const k in a) e.setAttribute(k, String(a[k])); if (t) e.textContent = t; return e; };
  const men = $<HTMLInputElement>('#g-men'), women = $<HTMLInputElement>('#g-women');
  const sync = (i: HTMLInputElement, o: string) => { $<HTMLOutputElement>(o).textContent = Number(i.value).toFixed(2); };
  men.addEventListener('input', () => sync(men, '#o-men')); women.addEventListener('input', () => sync(women, '#o-women'));

  const ACT = { men: 0.473, women: 0.152 };
  $('#reveal').addEventListener('click', () => {
    const gm = Number(men.value), gw = Number(women.value);
    const svg = $<SVGSVGElement>('#reveal-svg'); svg.replaceChildren();
    const x = (v: number) => 90 + (v / 0.8) * 400;
    [0, 0.2, 0.4, 0.6, 0.8].forEach((t) => { svg.append(mk('line', { class: t === 0 ? 'zero' : 'ax', x1: x(t), x2: x(t), y1: 20, y2: 110 })); svg.append(mk('text', { x: x(t), y: 130, 'text-anchor': 'middle' }, t.toFixed(1))); });
    [['Men', 45, ACT.men, gm], ['Women', 85, ACT.women, gw]].forEach(([lab, y, a, g]) => {
      svg.append(mk('text', { x: 8, y: Number(y) + 4 }, String(lab)));
      svg.append(mk('circle', { class: 'guess', cx: x(Number(g)), cy: y, r: 8 }));
      svg.append(mk('circle', { class: 'act', cx: x(Number(a)), cy: y, r: 7 }));
    });
    const ratio = (ACT.men / ACT.women).toFixed(1);
    $('#reveal-text').textContent = `In the paper the drop was d = −${ACT.men.toFixed(3).slice(1)} for men and d = −${ACT.women.toFixed(3).slice(1)} for women, about ${ratio} times larger for men. You guessed ${gm.toFixed(2).slice(1)} and ${gw.toFixed(2).slice(1)}. Without phones, men and women felt equally connected.`;
    $('#reveal-out').hidden = false; $('#step2').hidden = false;
    $('#reveal-out').scrollIntoView({ block: 'nearest', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    draw();
  });

  const D = -0.181;
  const nOf = (s: number) => Math.round(Math.exp(Math.log(20) + (s / 100) * (Math.log(2000) - Math.log(20))));
  let forced: number | null = null;
  const draw = () => {
    const n = forced ?? nOf(Number($<HTMLInputElement>('#n-sl').value));
    $('#n-out').textContent = n.toLocaleString('en-US');
    const se = Math.sqrt(4 / n + (D * D) / (2 * n)), lo = D - 1.96 * se, hi = D + 1.96 * se;
    const svg = $<SVGSVGElement>('#n-svg'); svg.replaceChildren();
    const x = (v: number) => 260 + (v / 1.0) * 240;
    [-1, -0.5, 0, 0.5, 1].forEach((t) => { svg.append(mk('line', { class: t === 0 ? 'zero' : 'ax', x1: x(t), x2: x(t), y1: 15, y2: 70 })); svg.append(mk('text', { x: x(t), y: 90, 'text-anchor': 'middle' }, t === 0 ? '0' : t.toFixed(1).replace('-', '−'))); });
    const cross = hi >= 0;
    svg.append(mk('line', { class: cross ? 'ci cross' : 'ci', x1: x(Math.max(lo, -1)), x2: x(Math.min(hi, 1)), y1: 42, y2: 42 }));
    svg.append(mk('circle', { class: 'act', cx: x(D), cy: 42, r: 7 }));
    svg.append(mk('text', { x: 260, y: 112, 'text-anchor': 'middle' }, 'Effect of a phone (d). Negative means less connected.'));
    const need = Math.ceil(4.0164 / Math.pow(Math.abs(D) / 1.96, 2) / 10) * 10;
    const f = (v: number) => v.toFixed(2).replace('-', '−').replace('0.', '.');
    $('#n-text').textContent = cross
      ? `With ${n.toLocaleString('en-US')} people the interval runs from ${f(lo)} to ${f(hi)}. It includes zero, so this study could not tell the effect from no effect.`
      : `With ${n.toLocaleString('en-US')} people the interval runs from ${f(lo)} to ${f(hi)}. It stays below zero, so a study this size can detect the drop. The interval first clears zero at about ${need} people.`;
  };
  $('#n-sl').addEventListener('input', () => { forced = null; draw(); });
  document.querySelectorAll<HTMLButtonElement>('.pre').forEach((b) => b.addEventListener('click', () => {
    const n = Number(b.dataset.n);
    $<HTMLInputElement>('#n-sl').value = String(Math.round(((Math.log(n) - Math.log(20)) / (Math.log(2000) - Math.log(20))) * 100));
    forced = n;
    draw();
  }));
</script>
