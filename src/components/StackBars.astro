---
// Stacked columns: each column is a total split into named parts (for example, the share of explained variance
// that each character's identification accounts for). Hover a segment for its value.
interface Seg { name: string; v: number }
interface Col { label: string; segs: Seg[] }
interface Props { cols: Col[]; parts: string[]; max: number; tickStep: number; axisLabel: string; ariaLabel: string; pct?: boolean; digits?: number }
const { cols, parts, max, tickStep, axisLabel, ariaLabel, pct = true, digits = 1 } = Astro.props;
const W = 780, H = 330, padL = 54, padR = 12, top = 12, bottom = 56;
const ph = H - top - bottom, pw = W - padL - padR;
const bw = Math.min(70, (pw / cols.length) * 0.62);
const y = (v: number) => top + ph - (v / max) * ph;
const xc = (i: number) => padL + (pw / cols.length) * (i + 0.5);
const ticks: number[] = [];
for (let t = 0; t <= max + 1e-9; t += tickStep) ticks.push(Math.round(t * 1000) / 1000);
const f = (v: number) => (pct ? `${(v * 100).toFixed(digits)}%` : v.toFixed(digits + 1));
const stacks = cols.map((c, i) => {
  let acc = 0;
  return c.segs.map((s) => { const o = { ...s, y0: acc, i }; acc += s.v; return o; });
});
---
<figure class="sb" data-fig>
  <ul class="key">{parts.map((p, k) => <li><span class={`sw c${k}`}></span>{p}</li>)}</ul>
  <div class="scroll" tabindex="0" role="region" aria-label="Chart. Scrolls sideways on narrow screens.">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={ariaLabel}>
      <g class="grid">{ticks.map((t) => <line x1={padL} x2={W - padR} y1={y(t)} y2={y(t)} />)}</g>
      {ticks.map((t) => <text class="tick" x={padL - 8} y={y(t) + 4} text-anchor="end">{pct ? `${Math.round(t * 100)}%` : t}</text>)}
      {stacks.map((segs, i) => (
        <g>
          {segs.map((s) => {
            const k = parts.indexOf(s.name);
            return s.v > 0 ? (
              <rect class={`seg c${k}`} data-tip tabindex="0" role="img" aria-label={`${cols[i].label}, ${s.name}: ${f(s.v)}`} data-label={cols[i].label} data-lines={`${s.name}: ${f(s.v)}|Column total: ${f(segs.reduce((a, b) => a + b.v, 0))}`}
                x={xc(i) - bw / 2} y={y(s.y0 + s.v)} width={bw} height={Math.max(0.5, y(s.y0) - y(s.y0 + s.v) - 1)} />
            ) : null;
          })}
          <text class="col" x={xc(i)} y={H - bottom + 20} text-anchor="middle">{cols[i].label}</text>
        </g>
      ))}
      <text class="axlab" x={padL + pw / 2} y={H - 10} text-anchor="middle">{axisLabel}</text>
    </svg>
  </div>
  <div class="tip" hidden></div>
  <details class="table-view">
    <summary>View as a table</summary>
    <table>
      <thead><tr><th scope="col">Trait</th>{parts.map((p) => <th scope="col">{p}</th>)}</tr></thead>
      <tbody>
        {cols.map((c) => (
          <tr><th scope="row">{c.label}</th>{parts.map((p) => <td>{f(c.segs.find((s) => s.name === p)?.v ?? 0)}</td>)}</tr>
        ))}
      </tbody>
    </table>
  </details>
</figure>
<script>
  import { attachTips } from '../utils/figtip';
  document.querySelectorAll<HTMLElement>('[data-fig]').forEach(attachTips);
</script>
<style>
  .sb { margin: 1rem 0 1.8rem; position: relative; max-width: 800px; }
  .scroll { overflow-x: auto; }
  svg { display: block; width: 100%; min-width: 560px; height: auto; }
  .key { list-style: none; margin: 0 0 0.6rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.3rem 1.1rem; font-family: var(--display); font-size: 0.88rem; }
  .sw { display: inline-block; width: 0.8rem; height: 0.8rem; border-radius: 2px; margin-right: 0.4rem; vertical-align: -1px; }
  .c0 { fill: #e9a3c4; background: #e9a3c4; } .c1 { fill: #5b3f9e; background: #5b3f9e; } .c2 { fill: #9bd3ec; background: #9bd3ec; }
  .c3 { fill: #f0a73a; background: #f0a73a; } .c4 { fill: #f4e27c; background: #f4e27c; } .c5 { fill: #b9a3d6; background: #b9a3d6; }
  .grid { stroke: var(--rule); stroke-dasharray: 2 4; }
  .tick, .axlab, .col { font-family: var(--display); font-size: 12px; fill: var(--muted); }
  .col { fill: var(--ink); font-size: 12.5px; }
  .seg { stroke: var(--paper); stroke-width: 1; } .seg:hover, .seg:focus { stroke: var(--ink); stroke-width: 2; outline: none; }
  .tip { position: absolute; transform: translate(-50%, -100%); display: grid; gap: 0.1rem; padding: 0.55rem 0.8rem; background: var(--ink); color: var(--paper); border-radius: 6px; font-family: var(--display); font-size: 0.85rem; white-space: nowrap; pointer-events: none; z-index: 2; }
  .tip[hidden] { display: none; }
  .table-view { margin-top: 0.6rem; font-family: var(--display); font-size: 0.9rem; }
  .table-view summary { cursor: pointer; color: var(--muted); }
  .table-view table { margin-top: 0.5rem; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .table-view th, .table-view td { padding: 0.25rem 0.8rem 0.25rem 0; text-align: left; border-bottom: 1px solid var(--rule); }
</style>
