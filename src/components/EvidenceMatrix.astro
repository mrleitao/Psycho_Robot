---
interface Skill {
  group: string;
  name: string;
  level: 'have' | 'developing';
  proof: string;
}

interface Props {
  skills: Skill[];
}

const { skills } = Astro.props;

const levels = [
  { id: 'have', label: 'Have', note: 'I have done this work, on my own or as part of a published project.' },
  { id: 'developing', label: 'Developing', note: 'Real practice, and I am still building depth.' },
] as const;

const labelOf = Object.fromEntries(levels.map((l) => [l.id, l.label]));
const counts = Object.fromEntries(levels.map((l) => [l.id, skills.filter((s) => s.level === l.id).length]));

const groups: { name: string; items: Skill[] }[] = [];
for (const s of skills) {
  let g = groups.find((x) => x.name === s.group);
  if (!g) {
    g = { name: s.group, items: [] };
    groups.push(g);
  }
  g.items.push(s);
}
---

<div class="matrix" data-matrix data-total={skills.length}>
  <div class="filters" role="group" aria-label="Filter skills by evidence level">
    <button type="button" aria-pressed="true" data-filter="all">
      All <span class="n">{skills.length}</span>
    </button>
    {
      levels.map((l) => (
        <button type="button" aria-pressed="false" data-filter={l.id}>
          {l.label} <span class="n">{counts[l.id]}</span>
        </button>
      ))
    }
  </div>

  <dl class="legend">
    {
      levels.map((l) => (
        <div>
          <dt>
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
              {l.id === 'have' && <circle cx="8" cy="8" r="6" class="fill" />}
              {l.id === 'developing' && <circle cx="8" cy="8" r="6" class="line" />}
            </svg>
            {l.label}
          </dt>
          <dd>{l.note}</dd>
        </div>
      ))
    }
  </dl>

  <p class="count" aria-live="polite" data-count>Showing all {skills.length} skills.</p>

  {
    groups.map((g) => (
      <section class="group" data-group>
        <h2>{g.name}</h2>
        <ul class="rows">
          {g.items.map((s) => (
            <li class="skill" data-level={s.level}>
              <h3>{s.name}</h3>
              <p class="level">
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                  {s.level === 'have' && <circle cx="8" cy="8" r="6" class="fill" />}
                  {s.level === 'developing' && <circle cx="8" cy="8" r="6" class="line" />}
                </svg>
                {labelOf[s.level]}
              </p>
              <p class="proof">{s.proof}</p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-matrix]').forEach((root) => {
    const total = Number(root.dataset.total);
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const items = root.querySelectorAll<HTMLElement>('.skill');
    const groups = root.querySelectorAll<HTMLElement>('[data-group]');
    const count = root.querySelector<HTMLElement>('[data-count]')!;

    const apply = (filter: string) => {
      let shown = 0;
      items.forEach((li) => {
        const match = filter === 'all' || li.dataset.level === filter;
        li.hidden = !match;
        if (match) shown += 1;
      });
      groups.forEach((g) => {
        g.hidden = !g.querySelector('.skill:not([hidden])');
      });
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
      count.textContent = filter === 'all' ? `Showing all ${total} skills.` : `Showing ${shown} of ${total} skills.`;
    };

    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter ?? 'all')));
  });
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  button {
    font: inherit;
    font-family: var(--display);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink);
    background: transparent;
    border: 1.5px solid var(--rule);
    border-radius: 6px;
    padding: 0.4rem 0.8rem;
    cursor: pointer;
  }

  button:hover {
    border-color: var(--muted);
  }

  button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  .n {
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
    margin-left: 0.15rem;
  }

  .legend {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem 1.5rem;
    margin: 1.5rem 0 0;
    font-family: var(--display);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .legend dt {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
  }

  .legend dd {
    margin: 0.15rem 0 0;
    color: var(--muted);
  }

  .count {
    margin: 1.5rem 0 0;
    font-family: var(--display);
    font-size: 0.9rem;
    color: var(--muted);
  }

  .group {
    margin-top: 2.5rem;
  }

  .group[hidden] {
    display: none;
  }

  .group h2 {
    margin-bottom: 0.75rem;
  }

  .skill {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.2rem 2rem;
  }

  @media (min-width: 760px) {
    .skill {
      grid-template-columns: minmax(0, 0.9fr) 11.5rem minmax(0, 1.7fr);
      align-items: baseline;
    }
  }

  .skill h3 {
    font-size: 1.05rem;
  }

  .level {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    font-family: var(--display);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .proof {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
  }

  svg .fill {
    fill: var(--ink);
  }

  svg .line {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
  }
</style>
