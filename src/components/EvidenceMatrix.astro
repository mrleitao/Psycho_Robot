---
interface Skill {
  group: string;
  name: string;
  level: 'have' | 'developing';
  proof: string;
  also?: string[];
  includes?: string[];
  fields?: string[];
  type?: 'hard' | 'soft';
  icon?: string;
  evidence?: string[];
}

interface Ev {
  id: string;
  name: string;
  kind: string;
  from: number;
  to: number;
  href?: string;
}

interface Props {
  skills: Skill[];
  fields: { id: string; name: string }[];
  evidence: Ev[];
}

import SkillIcon from './SkillIcon.astro';
import { href } from '../utils/url';

const { skills, fields, evidence } = Astro.props;
const evOf = (id: string) => evidence.find((e) => e.id === id)!;
const yearsOf = (s: Skill) => {
  const set = new Set<number>();
  for (const id of s.evidence ?? []) {
    const e = evOf(id);
    for (let y = e.from; y <= e.to; y++) set.add(y);
  }
  return [...set].sort((a, b) => a - b);
};
const span = (e: Ev) => (e.from === e.to ? `${e.from}` : `${e.from} to ${e.to}`);
const kindLabel: Record<string, string> = { project: 'Project', role: 'Role', workshop: 'Workshop I taught', training: 'Training', teaching: 'Teaching', course: 'Course' };
const YEARS = Array.from({ length: 14 }, (_, i) => 2013 + i);

const levels = [
  { id: 'have', label: 'Have', note: 'I have done this work, on my own or as part of a published project.' },
  { id: 'developing', label: 'Developing', note: 'Real practice, and I am still building depth.' },
] as const;

const slug = (s: string) => s.toLowerCase().replace(/\W+/g, '-').replace(/^-|-$/g, '');
const labelOf = Object.fromEntries(levels.map((l) => [l.id, l.label]));
const counts = Object.fromEntries(levels.map((l) => [l.id, skills.filter((s) => s.level === l.id).length]));

const groups: { name: string; items: Skill[]; i: number }[] = [];
for (const s of skills) {
  let g = groups.find((x) => x.name === s.group);
  if (!g) {
    g = { name: s.group, items: [], i: groups.length };
    groups.push(g);
  }
  g.items.push(s);
}
const gi = (name: string) => groups.find((g) => g.name === name)!.i;
const timeline = groups.map((g) => ({
  ...g,
  cells: YEARS.map((y) => g.items.filter((s) => yearsOf(s).includes(y)).length),
}));
const maxCell = Math.max(...timeline.flatMap((t) => t.cells));
const fieldRows = fields
  .map((f) => ({
    ...f,
    have: skills.filter((s) => s.level === 'have' && s.fields?.includes(f.id)).length,
    dev: skills.filter((s) => s.level === 'developing' && s.fields?.includes(f.id)).length,
  }))
  .sort((a, b) => b.have + b.dev - (a.have + a.dev));
const maxField = Math.max(...fieldRows.map((f) => f.have + f.dev));
const nHard = skills.filter((s) => s.type !== 'soft').length;
const nSoft = skills.length - nHard;
---

<div class="matrix" data-matrix data-total={skills.length}>
  <section class="viz" aria-labelledby="map-h">
    <h2 id="map-h">Every skill, by area</h2>
    <p class="viz-lead">Each tile is one skill, colored by area. A solid tile is a skill I have. A dashed tile is one I am developing. Select a tile to jump to the evidence, or select an area to show only its skills.</p>
    <ul class="areas" aria-label="Areas">
      {groups.map((g) => (
        <li><button type="button" class={`area a${g.i}`} data-area={g.name} aria-pressed="false"><span class="sw" aria-hidden="true"></span>{g.name} <span class="n">{g.items.length}</span></button></li>
      ))}
    </ul>
    <ul class="grid" aria-label="All skills">
      {skills.map((s) => (
        <li class={`tile a${gi(s.group)} ${s.level}`} data-tile={`s-${slug(s.name)}`}>
          <a href={`#s-${slug(s.name)}`} aria-label={`${s.name}, ${s.group}, ${labelOf[s.level]}`}>
            <span class="chip"><SkillIcon name={s.icon ?? 'spark'} size={20} /></span>
            <span class="tname">{s.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="viz" aria-labelledby="time-h">
    <h2 id="time-h">When the evidence happened</h2>
    <p class="viz-lead">Darker cells mean more skills with documented work in that year. Select a cell to show those skills, or a year to show every area. A year counts when a project, role, course or workshop in my record documents the skill. Papers with no start date I have are placed at their publication year.</p>
    <div class="tl" role="group" aria-label="Skills by area and year">
      <div class="tl-head" aria-hidden="true">
        <span></span>
        {YEARS.map((y) => <span class="yr">{String(y).slice(2)}</span>)}
      </div>
      {timeline.map((t) => (
        <div class={`tl-row a${t.i}`}>
          <span class="tl-name">{t.name}</span>
          {t.cells.map((n, k) => (
            <button type="button" class="cell" data-cell-area={t.name} data-cell-year={YEARS[k]} disabled={n === 0} style={`--v:${n / maxCell}`} aria-label={`${t.name}, ${YEARS[k]}: ${n} skills`} title={`${t.name}, ${YEARS[k]}: ${n} skills`}>{n || ''}</button>
          ))}
        </div>
      ))}
      <div class="tl-head tl-foot">
        <span></span>
        {YEARS.map((y) => <button type="button" class="yr yr-pick" data-year-pick={y} aria-label={`Show skills from ${y}`}>{String(y).slice(2)}</button>)}
      </div>
    </div>
    <p class="tl-key">Years are 2013 to 2026, shown as two digits.</p>
  </section>

  <section class="viz" aria-labelledby="fields-h">
    <h2 id="fields-h">Where the skills apply</h2>
    <p class="viz-lead">How many of my skills each kind of work draws on. Select a row to filter the list.</p>
    <ul class="fbars">
      {fieldRows.map((f) => (
        <li>
          <button type="button" class="frow" data-field-pick={f.id}>
            <span class="fname">{f.name}</span>
            <span class="fbar" aria-hidden="true">
              <span class="have" style={`width:${(f.have / maxField) * 100}%`}></span><span class="dev" style={`width:${(f.dev / maxField) * 100}%`}></span>
            </span>
            <span class="fn">{f.have + f.dev}</span>
          </button>
        </li>
      ))}
    </ul>
  </section>

  <slot />

  <h2 class="list-h">The evidence, skill by skill</h2>
  <div class="controls">
    <div class="filters" role="group" aria-label="Filter skills by level">
      <button type="button" aria-pressed="true" data-filter="all">All <span class="n">{skills.length}</span></button>
      {levels.map((l) => (
        <button type="button" aria-pressed="false" data-filter={l.id}>{l.label} <span class="n">{counts[l.id]}</span></button>
      ))}
    </div>
    <div class="filters" role="group" aria-label="Filter skills by type">
      <button type="button" aria-pressed="true" data-type="all">Any type</button>
      <button type="button" aria-pressed="false" data-type="hard">Technical <span class="n">{nHard}</span></button>
      <button type="button" aria-pressed="false" data-type="soft">Working style <span class="n">{nSoft}</span></button>
    </div>
    <label class="fsel">Field
      <select data-field>
        <option value="all">All fields</option>
        {fields.map((f) => <option value={f.id}>{f.name}</option>)}
      </select>
    </label>
  </div>

  <dl class="legend">
    {
      levels.map((l) => (
        <div>
          <dt>
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
              {l.id === 'have' && <circle cx="8" cy="8" r="6" class="fill" />}
              {l.id === 'developing' && <circle cx="8" cy="8" r="6" class="line" />}
            </svg>
            {l.label}
          </dt>
          <dd>{l.note}</dd>
        </div>
      ))
    }
  </dl>

  <p class="hint">Hover over or tap a skill name to see what else it is called and what it covers.</p>

  <p class="count" aria-live="polite" data-count>Showing all {skills.length} skills.</p>
  <button type="button" class="reset" data-reset hidden>Show all skills</button>

  {
    groups.map((g) => (
      <section class="group" data-group>
        <h2>{g.name}</h2>
        <ul class="rows">
          {g.items.map((s) => (
            <li class={`skill a${g.i}`} id={`s-${slug(s.name)}`} data-level={s.level} data-type={s.type ?? "hard"} data-fields={(s.fields ?? []).join(" ")} data-area={s.group} data-years={yearsOf(s).join(" ")}>
              <h3>
                <span class="chip chip-s"><SkillIcon name={s.icon ?? 'spark'} size={18} /></span>
                {s.also?.length ? (
                  <span class="has-tip" tabindex="0" aria-describedby={`tip-${s.name.replace(/\W+/g, '-')}`}>
                    {s.name}
                    <span class="tip" role="tooltip" id={`tip-${s.name.replace(/\W+/g, '-')}`}>
                      <span class="tip-h">Also referred to as</span>
                      {s.also.join('; ')}
                      {s.includes?.length ? (
                        <>
                          <span class="tip-h tip-h2">Skill encompasses</span>
                          {s.includes.join('; ')}
                        </>
                      ) : null}
                    </span>
                  </span>
                ) : (
                  s.name
                )}
              </h3>
              <p class="level">
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                  {s.level === 'have' && <circle cx="8" cy="8" r="6" class="fill" />}
                  {s.level === 'developing' && <circle cx="8" cy="8" r="6" class="line" />}
                </svg>
                {labelOf[s.level]}
              </p>
              <p class="proof">{s.proof}</p>
              <p class="ev">
                <span class="ev-h">Where it shows up</span>
                {(s.evidence ?? []).length ? (
                  (s.evidence ?? []).map((id, k) => {
                    const e = evOf(id);
                    return (
                      <>
                        {k > 0 ? '; ' : ''}
                        {e.href ? <a href={href(e.href)}>{e.name}</a> : e.name} <span class="ev-m">({kindLabel[e.kind].toLowerCase()}, {span(e)})</span>
                      </>
                    );
                  })
                ) : (
                  <span class="ev-m">No project, role or course tied to it yet.</span>
                )}
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-matrix]').forEach((root) => {
    const total = Number(root.dataset.total);
    const items = root.querySelectorAll<HTMLElement>('.skill');
    const tiles = root.querySelectorAll<HTMLElement>('[data-tile]');
    const groups = root.querySelectorAll<HTMLElement>('[data-group]');
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const select = root.querySelector<HTMLSelectElement>('[data-field]')!;
    const reset = root.querySelector<HTMLButtonElement>('[data-reset]')!;
    const state = { level: 'all', type: 'all', field: 'all', area: 'all', year: 'all' };

    const matches = (li: HTMLElement) =>
      (state.level === 'all' || li.dataset.level === state.level) &&
      (state.type === 'all' || li.dataset.type === state.type) &&
      (state.field === 'all' || (li.dataset.fields ?? '').split(' ').includes(state.field)) &&
      (state.area === 'all' || li.dataset.area === state.area) &&
      (state.year === 'all' || (li.dataset.years ?? '').split(' ').includes(state.year));

    const apply = () => {
      let shown = 0;
      const ok = new Set<string>();
      items.forEach((li) => {
        const m = matches(li);
        li.hidden = !m;
        if (m) { shown += 1; ok.add(li.id); }
      });
      tiles.forEach((t) => t.classList.toggle('dim', !ok.has(t.dataset.tile ?? '')));
      groups.forEach((g) => {
        g.hidden = !g.querySelector('.skill:not([hidden])');
      });
      root.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === state.level)));
      root.querySelectorAll<HTMLButtonElement>('[data-type]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.type === state.type)));
      root.querySelectorAll<HTMLButtonElement>('button[data-area]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.area === state.area)));
      root.querySelectorAll<HTMLButtonElement>('[data-year-pick]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.yearPick === state.year)));
      root.querySelectorAll<HTMLButtonElement>('.cell').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cellArea === state.area && b.dataset.cellYear === state.year)));
      select.value = state.field;
      const filtered = Object.values(state).some((v) => v !== 'all');
      reset.hidden = !filtered;
      const bits = [] as string[];
      if (state.area !== 'all') bits.push(state.area);
      if (state.year !== 'all') bits.push(state.year);
      count.textContent = (shown === total ? `Showing all ${total} skills.` : `Showing ${shown} of ${total} skills`) + (bits.length && shown !== total ? ` (${bits.join(', ')}).` : shown !== total ? '.' : '');
    };
    const toList = () => root.querySelector('.list-h')?.scrollIntoView({ behavior: 'smooth', block: 'start' });

    root.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => b.addEventListener('click', () => { state.level = b.dataset.filter ?? 'all'; apply(); }));
    root.querySelectorAll<HTMLButtonElement>('[data-type]').forEach((b) => b.addEventListener('click', () => { state.type = b.dataset.type ?? 'all'; apply(); }));
    root.querySelectorAll<HTMLButtonElement>('button[data-area]').forEach((b) => b.addEventListener('click', () => { state.area = state.area === b.dataset.area ? 'all' : (b.dataset.area ?? 'all'); apply(); }));
    root.querySelectorAll<HTMLButtonElement>('[data-year-pick]').forEach((b) => b.addEventListener('click', () => { state.year = state.year === b.dataset.yearPick ? 'all' : (b.dataset.yearPick ?? 'all'); state.area = 'all'; apply(); toList(); }));
    root.querySelectorAll<HTMLButtonElement>('.cell').forEach((b) => b.addEventListener('click', () => { state.area = b.dataset.cellArea ?? 'all'; state.year = b.dataset.cellYear ?? 'all'; apply(); toList(); }));
    select.addEventListener('change', () => { state.field = select.value; apply(); });
    reset.addEventListener('click', () => { state.level = 'all'; state.type = 'all'; state.field = 'all'; state.area = 'all'; state.year = 'all'; apply(); });
    root.querySelectorAll<HTMLButtonElement>('[data-field-pick]').forEach((b) =>
      b.addEventListener('click', () => {
        state.field = b.dataset.fieldPick ?? 'all';
        apply();
        toList();
      })
    );
    root.querySelectorAll<HTMLAnchorElement>('.tile a').forEach((a) =>
      a.addEventListener('click', () => {
        state.level = 'all'; state.type = 'all'; state.field = 'all'; state.area = 'all'; state.year = 'all';
        apply();
      })
    );
  });
</script>

<style>
  .viz { margin-top: 2.5rem; }
  .viz-lead { margin: 0.3rem 0 1.1rem; color: var(--muted); max-width: 46rem; }
  .areas { list-style: none; margin: 0 0 1rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .area { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.86rem; padding: 0.3rem 0.65rem; }
  .area .sw { width: 0.8rem; height: 0.8rem; border-radius: 3px; background: var(--c); flex: none; }
  .area[aria-pressed='true'] .sw { box-shadow: 0 0 0 2px var(--paper); }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(10.2rem, 1fr)); gap: 0.5rem; }
  .tile a { display: flex; align-items: center; gap: 0.55rem; height: 100%; padding: 0.45rem 0.6rem 0.45rem 0.45rem; border-radius: 9px; border: 2px solid var(--c); background: color-mix(in srgb, var(--c) 14%, var(--paper)); color: var(--ink); text-decoration: none; font-family: var(--display); font-size: 0.84rem; line-height: 1.22; font-weight: 500; }
  .tile.developing a { border-style: dashed; background: transparent; }
  .tile a:hover, .tile a:focus-visible { outline: 3px solid var(--ink); outline-offset: 2px; }
  .tile.dim a { opacity: 0.25; }
  .chip { flex: none; display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 7px; background: var(--c); color: #fff; }
  .chip-s { display: inline-grid; width: 1.7rem; height: 1.7rem; margin-right: 0.45rem; vertical-align: -0.35em; }
  .tname { min-width: 0; overflow-wrap: anywhere; }
  .tl { display: grid; gap: 3px; max-width: 54rem; }
  .tl-head, .tl-row { display: grid; grid-template-columns: 8.5rem repeat(14, minmax(0, 1fr)); gap: 3px; align-items: center; }
  .yr { font-family: var(--display); font-size: 0.72rem; color: var(--muted); text-align: center; font-variant-numeric: tabular-nums; }
  .yr-pick { border: 0; padding: 0.2rem 0; border-radius: 4px; font-weight: 500; background: transparent; }
  .yr-pick[aria-pressed='true'] { background: var(--ink); color: var(--paper); }
  .tl-name { font-family: var(--display); font-size: 0.8rem; line-height: 1.15; padding-right: 0.3rem; }
  .cell { height: 1.7rem; padding: 0; border: 0; border-radius: 4px; font-size: 0.72rem; font-variant-numeric: tabular-nums; color: transparent; background: color-mix(in srgb, var(--c) calc(12% + var(--v) * 88%), var(--paper)); }
  .cell:disabled { background: var(--wash); cursor: default; }
  .cell:not(:disabled):hover, .cell[aria-pressed='true'] { color: #fff; outline: 2px solid var(--ink); outline-offset: 1px; background: var(--c); }
  .tl-key { margin: 0.6rem 0 0; font-family: var(--display); font-size: 0.82rem; color: var(--muted); }
  .a0 { --c: #3b6ea8; } .a1 { --c: #1f8582; } .a2 { --c: #6a4fa3; } .a3 { --c: #55606e; } .a4 { --c: #c4553a; } .a5 { --c: #a87912; } .a6 { --c: #3d8a4a; } .a7 { --c: #a8387a; } .a8 { --c: #8a5a2b; } .a9 { --c: #6f7f1f; } .a10 { --c: #2f3f7a; }
  .skill h3 .chip { color: #fff; }
  .ev { grid-column: 1 / -1; margin: 0.35rem 0 0; font-size: 0.92rem; line-height: 1.5; color: var(--muted); }
  .ev-h { font-family: var(--display); font-weight: 600; color: var(--ink); margin-right: 0.4rem; }
  .ev-m { white-space: nowrap; }
  .reset { margin-top: 0.7rem; }
  @media (max-width: 520px) { .tl-head, .tl-row { grid-template-columns: repeat(14, minmax(0, 1fr)); } .tl-head > span:first-child { display: none; } .tl-name { grid-column: 1 / -1; padding-top: 0.5rem; font-weight: 600; } .cell { height: 1.9rem; } .grid { grid-template-columns: repeat(auto-fill, minmax(9.2rem, 1fr)); } }
  .fbars { list-style: none; margin: 0; padding: 0; max-width: 46rem; }
  .frow { width: 100%; display: grid; grid-template-columns: minmax(8rem, 15rem) 1fr 2rem; gap: 0.7rem; align-items: center; text-align: left; border: 0; border-radius: 6px; padding: 0.3rem 0.4rem; font-size: 0.93rem; }
  .frow:hover { background: var(--wash); border: 0; }
  .fbar { display: flex; height: 0.8rem; }
  .fbar .have { background: var(--steel); border-radius: 4px 0 0 4px; }
  .fbar .dev { background: repeating-linear-gradient(45deg, var(--peach) 0 3px, transparent 3px 6px); border: 1.5px solid var(--peach); border-left: 0; }
  .fn { font-variant-numeric: tabular-nums; color: var(--muted); }
  .list-h { margin-top: 3.5rem; }
  .controls { display: grid; gap: 0.7rem; margin-top: 0.8rem; }
  .fsel { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; font-family: var(--display); font-size: 0.95rem; }
  select { font: inherit; font-family: var(--display); color: var(--ink); background: var(--paper); border: 1.5px solid var(--rule); border-radius: 6px; padding: 0.4rem 0.6rem; max-width: 100%; }
  .tip-h2 { margin-top: 0.5rem; }
  @media (max-width: 520px) { .frow { grid-template-columns: 1fr 2rem; } .frow .fbar { grid-column: 1 / -1; grid-row: 2; } .frow .fn { grid-row: 1; grid-column: 2; } }
  .hint { margin: 1.25rem 0 0; font-family: var(--display); font-size: 0.9rem; color: var(--muted); }
  .has-tip { position: relative; display: inline-block; cursor: help; text-decoration: underline dotted var(--muted); text-underline-offset: 0.25em; text-decoration-thickness: 1.5px; }
  .has-tip:focus-visible { outline: 3px solid var(--steel); outline-offset: 3px; border-radius: 2px; }
  .tip { position: absolute; left: 0; top: calc(100% + 0.5rem); z-index: 5; width: max-content; max-width: min(19rem, 80vw); padding: 0.6rem 0.8rem; background: var(--ink); color: var(--paper); border-radius: 6px; font-family: var(--display); font-weight: 400; font-size: 0.88rem; line-height: 1.4; text-decoration: none; display: none; pointer-events: none; }
  .tip-h { display: block; font-weight: 600; margin-bottom: 0.15rem; }
  .has-tip:hover .tip, .has-tip:focus .tip { display: block; }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  button {
    font: inherit;
    font-family: var(--display);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink);
    background: transparent;
    border: 1.5px solid var(--rule);
    border-radius: 6px;
    padding: 0.4rem 0.8rem;
    cursor: pointer;
  }

  button:hover {
    border-color: var(--muted);
  }

  button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  .n {
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
    margin-left: 0.15rem;
  }

  .legend {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem 1.5rem;
    margin: 1.5rem 0 0;
    font-family: var(--display);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .legend dt {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
  }

  .legend dd {
    margin: 0.15rem 0 0;
    color: var(--muted);
  }

  .count {
    margin: 1.5rem 0 0;
    font-family: var(--display);
    font-size: 0.9rem;
    color: var(--muted);
  }

  .group {
    margin-top: 2.5rem;
  }

  .group[hidden] {
    display: none;
  }

  .group h2 {
    margin-bottom: 0.75rem;
  }

  .skill {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.2rem 2rem;
  }

