---
import { href } from '../utils/url';
interface Props { theme?: 'auto' | 'light' | 'dark'; }
const { theme = 'auto' } = Astro.props;
const src = `${href('/graphics/connecting-dots.html')}?embed=1&theme=${theme}`;
---
<connecting-dots-band data-theme-mode={theme}>
  <iframe class="tower" src={src} title="Animated illustration of points connecting into an evolving network" aria-hidden="true" tabindex="-1" loading="lazy"></iframe>
  <div class="ui">
    <p class="cap">Ideas connect and spread. This is an illustration, not real network data.</p>
    <button class="pause" type="button" aria-pressed="false" disabled>Loading animation</button>
  </div>
</connecting-dots-band>
<script is:inline>
  if (!customElements.get('connecting-dots-band')) {
    customElements.define('connecting-dots-band', class extends HTMLElement {
      connectedCallback() {
        if (this.cleanup) return;
        const frame = this.querySelector('iframe');
        const button = this.querySelector('button');
        let userPaused = false;
        const api = () => { try { return frame.contentWindow && frame.contentWindow.ConnectingDots; } catch (_) { return null; } };
        const hostTheme = () => {
          const mode = this.dataset.themeMode;
          if (mode === 'light' || mode === 'dark') return mode;
          const root = document.documentElement;
          const attr = root.dataset.theme;
          if (attr === 'light' || attr === 'dark') return attr;
          return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        };
        const label = () => {
          const t = api();
          if (!t) { button.disabled = true; button.textContent = 'Animation unavailable'; return; }
          const paused = t.getState().paused;
          button.disabled = false;
          button.textContent = paused ? 'Play animation' : 'Pause animation';
          button.setAttribute('aria-pressed', String(paused));
        };
        const syncTheme = () => { const t = api(); if (t && t.setTheme) t.setTheme(hostTheme()); };
        const onLoad = () => { syncTheme(); userPaused = !!(api() && api().getState().paused); label(); };
        const onClick = () => {
          const t = api(); if (!t) return;
          if (t.getState().paused) { userPaused = false; t.resume(); } else { userPaused = true; t.pause(); }
          label();
        };
        frame.addEventListener('load', onLoad);
        button.addEventListener('click', onClick);
        const mo = new MutationObserver(syncTheme);
        mo.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
        const mq = matchMedia('(prefers-color-scheme: dark)');
        mq.addEventListener('change', syncTheme);
        // Stop drawing while the band is off screen, unless the visitor paused it themselves.
        const io = new IntersectionObserver((entries) => {
          const t = api(); if (!t || userPaused) return;
          if (entries[0].isIntersecting) t.resume(); else t.pause();
          label();
        });
        io.observe(this);
        if (api()) onLoad();
        this.cleanup = () => { frame.removeEventListener('load', onLoad); button.removeEventListener('click', onClick); mo.disconnect(); mq.removeEventListener('change', syncTheme); io.disconnect(); };
      }
      disconnectedCallback() { if (this.cleanup) this.cleanup(); this.cleanup = null; }
    });
  }
</script>
<style>
  connecting-dots-band { position: absolute; inset: 0; display: block; pointer-events: none; }
  .ui { pointer-events: auto; }
  .tower { position: absolute; z-index: -1; inset: 0; width: 100%; height: 100%; border: 0; background: transparent; pointer-events: none; }
  .ui { position: absolute; left: 0; right: 0; bottom: 14px; z-index: 1; max-width: 1040px; margin-inline: auto; padding-inline: clamp(16px, 4vw, 32px); display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1rem; }
  .cap { margin: 0; font: 500 0.85rem/1.4 var(--display); color: var(--muted); background: var(--paper); padding: 4px 10px; border-radius: 4px; }
  .pause { min-height: 44px; padding: 4px 14px; font: 500 0.85rem/1.4 var(--display); background: var(--paper); border: 1px solid var(--muted); border-radius: 4px; color: var(--ink); cursor: pointer; }
  .pause:hover:not(:disabled) { background: var(--wash); }
  .pause:focus-visible { outline: 3px solid var(--coral); outline-offset: 3px; }
  .pause:disabled { cursor: default; opacity: 0.8; }
  @media (max-width: 700px) { .tower { inset: auto 0 64px 0; height: 300px; } }
</style>
