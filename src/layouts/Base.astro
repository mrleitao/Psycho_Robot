---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/source-serif-4/index.css';
import '../styles/global.css';
import { href, basePath } from '../utils/url';

interface Props {
  title?: string;
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} | Matthew Leitao` : 'Matthew Leitao, behavioral scientist';
const path = Astro.url.pathname.replace(basePath, '') || '/';

const nav = [
  { label: 'Projects', path: '/projects/' },
  { label: 'Skills', path: '/skills/' },
  { label: 'Translation', path: '/translation/' },
  { label: 'Research', path: '/research/' },
  { label: 'CV', path: '/cv/' },
  { label: 'Contact', path: '/contact/' },
];
const isCurrent = (p: string) => path.startsWith(p);

// Two overlapping dots: the AI and doctor colors, with the gap between them.
const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='11' cy='16' r='8' fill='%23b86e00'/%3E%3Ccircle cx='21' cy='16' r='8' fill='%232b45d4'/%3E%3C/svg%3E";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href={favicon} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="stripe" aria-hidden="true"></div>
      <div class="wrap bar">
        <a class="mark" href={href('/')}>Matthew Leitao</a>
        <nav aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={href(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="small muted">
          Matthew Leitao. <a href="mailto:mrleitao@me.com">mrleitao@me.com</a>.
          <a href="https://www.linkedin.com/in/mrleitao/">LinkedIn</a>.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .stripe { height: 6px; background: var(--five); }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.1rem;
  }

  .mark {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .mark:hover {
    color: var(--ink);
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    font-family: var(--display);
    font-weight: 500;
    font-size: 1rem;
    text-decoration: none;
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
  }

  nav a:hover {
    border-bottom-color: var(--muted);
    color: var(--ink);
  }

  nav a[aria-current='page'] {
    border-bottom-color: var(--doctor);
  }

  @media print {
    .site-header,
    .site-footer,
    .skip {
      display: none !important;
    }
  }

  .site-footer {
    margin-top: clamp(72px, 10vw, 128px);
    padding-block: 2rem 3rem;
    border-top: 1px solid var(--rule);
  }

  .site-footer p {
    margin: 0;
  }
</style>
